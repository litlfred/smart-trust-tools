{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hand Over Credential Input",
  "type": "object",
  "required": [
    "issued",
    "medium"
  ],
  "properties": {
    "issued": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "member",
          "kind",
          "qr"
        ],
        "properties": {
          "member": {
            "type": "string",
            "description": "Who the credential is about, as the holder labels them."
          },
          "kind": {
            "enum": [
              "hcert",
              "vhl",
              "shl"
            ],
            "description": "An HCERT certificate; the HCERT carrying a Verifiable Health Link at key 5; or a SMART Health Link."
          },
          "qr": {
            "type": "string",
            "pattern": "^(HC1:|shlink:/)",
            "description": "The QR's text: HC1:… for an HCERT or a VHL (hcert-prefix-context), shlink:/… for a SMART Health Link (HL7 SMART Health Links specification)."
          }
        },
        "additionalProperties": false
      }
    },
    "medium": {
      "enum": [
        "paper",
        "wallet"
      ]
    }
  },
  "additionalProperties": false
}
