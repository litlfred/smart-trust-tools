      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Close the tracking issue"
        }
      ],
      "skos:definition": [
        {
          "@value": "Clean: close the open issue carrying the tracking label (the `label` input), if any, saying why the verdict is clean. Runs only on a clean verdict — on unknown the issue is left untouched and the job fails instead, because could-not-check is never rendered as clean."
        }
      ],
      "skos:notation": "GT_CloseTrackingIssue",
      "dcterms:source": "cat-harness/processes/global-tasks.bpmn#GT_CloseTrackingIssue",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/globaltask.gt_drain",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Drain: land, close or re-target the open PRs"
        }
      ],
      "skos:definition": [
        {
          "@value": "Work the PRs `seed:ready` named until the source settles: land or close the heavy movers and the next layer's PRs, bring the layer's open PRs to five or fewer, and finish any move in flight. Fix a red rehearsal or a discovery miss where it is. Nothing is seeded from here; it goes back to the gateway, which re-asks."
        }
      ],
      "skos:notation": "GT_Drain",
      "dcterms:source": "cat-harness/processes/global-tasks.bpmn#GT_Drain",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/globaltask.gt_ensuretrackinglabel",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Ensure the tracking label exists"
        }
      ],
      "skos:definition": [
        {
          "@value": "Create the tracking label (the `label` input) with --force so it exists before either issue path runs — the close path filters on it too, and on a repository that has never had a finding it would not exist yet. Skipped on an unknown verdict."
        }
      ],
      "skos:notation": "GT_EnsureTrackingLabel",
      "dcterms:source": "cat-harness/processes/global-tasks.bpmn#GT_EnsureTrackingLabel",
      "skos:note": "candidate"
    },
    {
