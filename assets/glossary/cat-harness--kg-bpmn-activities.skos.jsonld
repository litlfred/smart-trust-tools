        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Inject the PO into translated Markdown"
        }
      ],
      "skos:definition": [
        {
          "@value": "Read the .po file and the source .md, substitute msgstr for msgid, unshield the placeholders, and write the translated .md to translations/<locale>/. Check structure (paragraph count, heading levels) and completeness (no empty msgstr), and lint (doubled punctuation, orphaned placeholders). Tool: the translation_inject MCP tool."
        }
      ],
      "skos:notation": "GT_InjectPo",
      "dcterms:source": "cat-harness/processes/global-tasks.bpmn#GT_InjectPo",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/globaltask.gt_logretained",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Append `retained` with the reason"
        }
      ],
      "skos:definition": [
        {
          "@value": "Records that a removal was considered and refused, or that a preview still stands because a signal fired; without the entry that leaves no trace, and nobody can tell why a preview is still up. A reason is REQUIRED — the tool refuses without one."
        }
      ],
      "skos:notation": "GT_LogRetained",
      "dcterms:source": "cat-harness/processes/global-tasks.bpmn#GT_LogRetained",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/globaltask.gt_recordsignoff",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record the sign-off as a requirement-signoff attestation"
        }
      ],
      "skos:definition": [
        {
          "@value": "THE RECORD, and not relaxable, because a judgement nobody wrote down is indistinguishable from one never made (`adjudication`, A_RecordEntry). Append one `requirement-signoff` record to `test/attestations/requirement-signoff/<set slug>.attestations.json` — who (kind, id, actor), at, scope (the set or one member), the outcome from the requirement-set code list, the stage it moves the set to, the reason, and the permalink to the issue comment where it was decided — and set the set's `stage` to match. GW_SignoffRecorded after this reads the record back, so this step cannot be skipped by completing it: a sign-off that left no attestation loops here again."
        }
      ],
      "skos:notation": "GT_RecordSignoff",
      "dcterms:source": "cat-harness/processes/global-tasks.bpmn#GT_RecordSignoff",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/globaltask.gt_reportwhatmoves",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Report what would move — sizes, and what breaks"
        }
      ],
      "skos:definition": [
        {
          "@value": "The agent reports and waits: what would move, how large, what in the parent breaks, and the rollback. `deletion-requires-confirmation` is not a courtesy to waive: an agent never removes or relocates a durable artefact on its own initiative."
        }
      ],
      "skos:notation": "GT_ReportWhatMoves",
      "dcterms:source": "cat-harness/processes/global-tasks.bpmn#GT_ReportWhatMoves",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/globaltask.gt_roundtripqa",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Round-trip translation QA"
        }
      ],
      "skos:definition": [
        {
          "@value": "Back-translate the target-language .md into the source language and compare the meaning with the original. It catches semantic drift and terminology misses that a forward-only fluency check cannot see, and tells the two apart. Tool: the translation_validate MCP tool."
        }
      ],
      "skos:notation": "GT_RoundTripQa",
      "dcterms:source": "cat-harness/processes/global-tasks.bpmn#GT_RoundTripQa",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/globaltask.gt_trackissue",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Open or EDIT the one tracking issue"
        }
      ],
      "skos:definition": [
        {
          "@value": "Findings: EDIT the one open issue carrying the tracking label (the `label` input) if there is one, otherwise create it, with the report as the body. One issue edited in place, never a new issue or a comment per run, so the tracking issue never becomes a feed."
        }
      ],
      "skos:notation": "GT_TrackIssue",
      "dcterms:source": "cat-harness/processes/global-tasks.bpmn#GT_TrackIssue",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/globaltask.gt_writetranslationstatus",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Write status.json"
        }
      ],
      "skos:definition": [
        {
          "@value": "Record the translation's standing in translations/<locale>/status.json. The `official` input says which: `false` records it as unofficial ({ official: false, generatedBy, generatedAt }), usable but shown with a warning badge; `true` records the human sign-off with the SHA-256 of the source .md, so a later change to the source marks it stale."
        }
      ],
      "skos:notation": "GT_WriteTranslationStatus",
      "dcterms:source": "cat-harness/processes/global-tasks.bpmn#GT_WriteTranslationStatus",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_actorroleadministration.callactivity_codechangereview",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Branch, gates, PR and review"
        }
      ],
      "skos:definition": [
        {
          "@value": "Called rather than restated. The mechanics of getting an edit reviewed and merged are not specific to the role graph, and a second description of them is a second thing free to disagree with the first. Where `cat-harness.sdlc` is switched on, this step is the opt-in process `code-change-review` (`Process_CodeChangeReview`, sdlc/processes/code-change-review.bpmn); it is not called from here, because a layer without that sub-graph does not have it (owner card Q-OPTIN-CALLS A, 2026-11-12)."
        }
      ],
      "skos:notation": "CallActivity_CodeChangeReview",
      "dcterms:source": "cat-harness/processes/process/actor-role-administration.bpmn#CallActivity_CodeChangeReview",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_actorroleadministration.task_addactor",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Add an actor, and declare its kind"
        }
      ],
      "skos:definition": [
        {
          "@value": "Human, agentic or mechanical. A userTask because the agentic/mechanical line is JUDGEMENT — role-model.md says so — and reading it wrong disqualifies the actor from every judgement task it exists to perform, silently."
        }
      ],
      "skos:notation": "Task_AddActor",
      "dcterms:source": "cat-harness/processes/process/actor-role-administration.bpmn#Task_AddActor",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_actorroleadministration.task_assignroles",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Open or close a role to an actor"
        }
      ],
      "skos:definition": [
        {
          "@value": "The join every other diagram depends on. An empty `roles` is a DETERMINED empty — it says the actor takes on none — and is not the same as an absent one, which asserts nothing."
        }
      ],
      "skos:notation": "Task_AssignRoles",
      "dcterms:source": "cat-harness/processes/process/actor-role-administration.bpmn#Task_AssignRoles",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_actorroleadministration.task_grantorrevoke",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Grant or revoke a permission"
        }
      ],
      "skos:definition": [
        {
          "@value": "A permission travels with the PARTICIPANT and cross-cuts every lane, so unlike a role it cannot be scoped by the diagram it is used in. Granting one is a standing decision, which is why this lane is person-only and why the log capture on this process is on."
        }
      ],
      "skos:notation": "Task_GrantOrRevoke",
      "dcterms:source": "cat-harness/processes/process/actor-role-administration.bpmn#Task_GrantOrRevoke",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_actorroleadministration.task_retireactor",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Retire an actor — never delete one"
        }
      ],
      "skos:definition": [
        {
          "@value": "An actor id is referenced from roles, diagrams, beans and commits, so removing the file leaves every one of those unable to tell retirement from accident. Same rule, and the same reason, as a scrapped bean."
        }
      ],
      "skos:notation": "Task_RetireActor",
      "dcterms:source": "cat-harness/processes/process/actor-role-administration.bpmn#Task_RetireActor",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_actorroleadministration.task_runkgaudit",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Audit the graph"
        }
      ],
      "skos:definition": [
        {
          "@value": "AFTER the change, not before. Every criterion here is a join — role to lane, actor to role, activity to skill — so what an administrative edit breaks is not in the file it edited. The sidecars under `test/results/kg-qa/` are committed for the reason a printed verdict is not: without them, \"unbound since it was drawn\" and \"broken by this change\" are indistinguishable. Runs `kg:audit`."
        }
      ],
      "skos:notation": "Task_RunKgAudit",
      "dcterms:source": "cat-harness/processes/process/actor-role-administration.bpmn#Task_RunKgAudit",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_adjudication.a_adjudicate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Adjudicate the disagreement"
        }
      ],
      "skos:definition": [
        {
          "@value": "The judgement itself, and the one step nothing here can check: if a mechanism could decide it, the process would not have been entered. It declares NO `cat-harness.processes:adjudication codes` on purpose, and that absence is the whole of bean `bvuk`. This step used to name three — stands, scope, dispensation — and six diagrams called it: `review-narrative` and `voice-review`, whose question those three answer, and four whose question they do not. `refresh-materialized` asks which side wins a local-vs-remote conflict; there is no criterion to scope there and no dispensation to grant, yet the outcome half ran regardless. Since the caller's question decides the permitted answers, the caller declares them: `cat-harness.processes:adjudication codes` on its OWN call activity, with its own gateway acting on them. `criterion-adjudication.bpmn` is that for the QA-criterion question. What could NOT be fixed by passing the codes as data, which was this bean's first recommendation: the three branches ran three different TASKS, so a caller handed `local-wins` would have had it pointing at `A_ScopeCriterion`. The branches had to move, not the enum."
        }
      ],
      "skos:notation": "A_Adjudicate",
      "dcterms:source": "cat-harness/processes/process/adjudication.bpmn#A_Adjudicate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_adjudication.a_dispatch",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Dispatch with adjudicator_sees — never the artefact"
        }
      ],
      "skos:definition": [
        {
          "@value": "`UntaintedDispatch` on the criterion declares what each party is given; the caller names a subject and a criterion and does not hand-assemble a brief, because the party composing a brief by hand is the producer. `untaintedPartitionDefects` reports `overlap` when the checker and the adjudicator can read the same file — one of them is then grading its own input, and the verdict measures nothing while raising no error."
        }
      ],
      "skos:notation": "A_Dispatch",
      "dcterms:source": "cat-harness/processes/process/adjudication.bpmn#A_Dispatch",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_adjudication.a_statefinding",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "State the finding and what it read"
        }
      ],
      "skos:definition": [
        {
          "@value": "Each provider says what it found and on what evidence. A finding that does not show what it read is an opinion, and an adjudicator cannot tell it from a finding about some other version of the block."
        }
      ],
      "skos:notation": "A_StateFinding",
      "dcterms:source": "cat-harness/processes/process/adjudication.bpmn#A_StateFinding",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_archimatepublish.a_check",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Check the model parses and resolves"
        }
      ],
      "skos:definition": [
        {
          "@value": "Tool `archimate-check` (`archimate:validate`, on the layer root): every model the config names is held and parses, every box in every view draws an element the model holds, every relationship's ends are in the model."
        }
      ],
      "skos:notation": "A_Check",
      "dcterms:source": "cat-harness/processes/ui/archimate-publish.bpmn#A_Check",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_archimatepublish.a_fixmodel",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Fix the relationship in Archi"
        }
      ],
      "skos:definition": [
        {
          "@value": "The author changes the relationship's type or ends in Archi and commits the model again. The pipeline never rewrites a model."
        }
      ],
      "skos:notation": "A_FixModel",
      "dcterms:source": "cat-harness/processes/ui/archimate-publish.bpmn#A_FixModel",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_archimatepublish.a_metamodel",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Derive the metamodel in use"
        }
      ],
      "skos:definition": [
        {
          "@value": "Tool `archimate-metamodel` (`archimate:metamodel --check`, on the layer root): the element types the model uses and every (source type, relationship, target type) pattern, each checked against ArchiMate's relationship table. Placeholder elements named after their own type are reported, never fatal: removing them is the author's call."
        }
      ],
      "skos:notation": "A_Metamodel",
      "dcterms:source": "cat-harness/processes/ui/archimate-publish.bpmn#A_Metamodel",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_archimatepublish.a_pages",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Write pages, drawings and the metamodel page"
        }
      ],
      "skos:definition": [
        {
          "@value": "Tool `archimate-pages` (`archimate:pages --out`, into the site being built): a JSON-LD node and a thin page for every view, element and relationship, every view drawn as SVG, and each model's \"Metamodel in use\" page with its diagram laid out from DOT by Graphviz in WebAssembly, plus the same diagram as DOT, Mermaid and JSON."
        }
      ],
      "skos:notation": "A_Pages",
      "dcterms:source": "cat-harness/processes/ui/archimate-publish.bpmn#A_Pages",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_asktheperson.a_compose",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Compose the full question"
        }
      ],
      "skos:definition": [
        {
          "@value": "What is being decided, stated as what will differ; every id, path and coined name glossed; every option with its letter, a one-line explanation and its trade-off; the recommendation, first and marked; what will happen if no answer comes. Can the reader answer without opening anything? If not, it is not ready. More than one decision open: ask the next one in full and give a count for the rest."
        }
      ],
      "skos:notation": "A_Compose",
      "dcterms:source": "cat-harness/processes/process/ask-the-person.bpmn#A_Compose",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_asktheperson.a_handback",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Hand back to the discussion"
        }
      ],
      "skos:definition": [
        {
          "@value": "The composed question goes, unchanged, to the discussion agent, which asks it through this same process on its `yes` branch and routes the answer back: the sibling's half of `Process_HandBackToDiscussion` (a task here, not a call, because that process calls this one). The sibling also shows it in its own thread, never only there."
        }
      ],
      "skos:notation": "A_HandBack",
      "dcterms:source": "cat-harness/processes/process/ask-the-person.bpmn#A_HandBack",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_asktheperson.call_discuss",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Discuss it with the person"
        }
      ],
      "skos:definition": [
        {
          "@value": "Bootstrap's human-agent discussion, given the composed question. Its `Ask ONE question` step is where this harness's delivery rule applies: Post the whole composed question as ordinary chat text BEFORE any card. This is the copy that survives: a card, once answered, shows only the chosen option, and a dismissed card shows nothing. Never \"see the card\", never a request for a typed reply such as \"1y 2n\". Then the card: Whatever the host calls its selection tool (`AskUserQuestion`, `request_decision`, a button card): the same letters and labels as the chat text, the recommended option marked. No host card tool: say so in the chat and keep each answer to one short choice. Its answer step: One tap on the card, or any answer the person prefers to give. Free text is always available and never required. A dismissal is NOT an answer and never selects the default as a choice; the question stays open in the chat. On an answer: Hand the answer back to the calling step, quoted. If it settles how a kind of thing is decided, it is a rule: write it into the governing skill in the same turn. On no answer: Do what the question said would happen with no answer, and say so. Nothing irreversible proceeds on a default: such a step waits for the person."
        }
      ],
      "skos:notation": "Call_Discuss",
      "dcterms:source": "cat-harness/processes/process/ask-the-person.bpmn#Call_Discuss",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_codereview.task_recordverdict",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record the verdict on the node"
        }
      ],
      "skos:definition": [
        {
          "@value": "Findings are advice, not commits — the same separation the generic reviewer lane keeps. Record them where the next reader meets the node."
        }
      ],
      "skos:notation": "Task_RecordVerdict",
      "dcterms:source": "cat-harness/processes/kg/review-code.bpmn#Task_RecordVerdict",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_codereview.task_reviewschema",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review the schema definition node"
        }
      ],
      "skos:definition": [
        {
          "@value": "Does the node declare what KIND of node it is? Does a widened type carry its mirrors? Does a removed field leave a reason behind, so the next author does not re-add it in good faith? And where the node RENDERS to something the site serves — a colour, a glyph, a theme's tokens — does a Tool maintain that artefact, and does the visual fact have only one home? The node decides; the stylesheet reports."
        }
      ],
      "skos:notation": "Task_ReviewSchema",
      "dcterms:source": "cat-harness/processes/kg/review-code.bpmn#Task_ReviewSchema",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_codereview.task_reviewtool",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review the Tool node"
        }
      ],
      "skos:definition": [
        {
          "@value": "Does it name skills, and do they resolve? Is the mechanism it advertises the one that actually runs? Are its IRIs minted rather than written out? And the question a covered skill hides: is the COMMAND reachable, or only the skill satisfied? A skill can be served by the neighbours of its mechanism while the mechanism itself is reachable from no node, and check:tools reports it as covered and is right to."
        }
      ],
      "skos:notation": "Task_ReviewTool",
      "dcterms:source": "cat-harness/processes/kg/review-code.bpmn#Task_ReviewTool",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_codereview.task_runnodeaudits",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Run the node audits"
        }
      ],
      "skos:definition": [
        {
          "@value": "`check:tools`, `kg:audit` and `typecheck`. Read the kg-qa sidecar rather than the summary: it is written per node so an inherited defect and a new one are distinguishable."
        }
      ],
      "skos:notation": "Task_RunNodeAudits",
      "dcterms:source": "cat-harness/processes/kg/review-code.bpmn#Task_RunNodeAudits",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_contentacquisition.a_accept",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Accept it, and record where it came from"
        }
      ],
      "skos:definition": [
        {
          "@value": "Both branches land here. An unprompted offer is accepted as it stands — do not make somebody follow a process to hand over what they already have. Provenance is recorded whichever channel it arrived through: a description given in chat has a source and can be wrong, exactly as a PDF does."
        }
      ],
      "skos:notation": "A_Accept",
      "dcterms:source": "cat-harness/library/processes/content-acquisition.bpmn#A_Accept",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_contentacquisition.a_ask",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Ask for a link or a description"
        }
      ],
      "skos:definition": [
        {
          "@value": "Both forms, named together. A person who cannot find the file often knows exactly what it is, and a description in their own words is an acquired resource rather than a consolation prize. Asking for the upload first demands the one thing they may not have, before the cheaper answers have been offered. Say what happens if they do nothing."
        }
      ],
      "skos:notation": "A_Ask",
      "dcterms:source": "cat-harness/library/processes/content-acquisition.bpmn#A_Ask",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_contentacquisition.a_pointtoupload",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Point at the upload target"
        }
      ],
      "skos:definition": [
        {
          "@value": "Composed from the declaration by the `upload-url` Tool, never written by hand: the queue is declared with INSTANCE scope, and a forge URL needs the path relative to the REPOSITORY. Every failure is named — no origin remote, a non-GitHub forge, a declared-but-absent queue — because a URL is believed, and somebody sent to a wrong one cannot tell it from an empty directory. On failure, fall back to the conversation."
        }
      ],
      "skos:notation": "A_PointToUpload",
      "dcterms:source": "cat-harness/library/processes/content-acquisition.bpmn#A_PointToUpload",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_contentacquisition.a_route",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Route it, and watch the queue"
        }
      ],
      "skos:definition": [
        {
          "@value": "A file goes to ingestion; a link or a description goes to whatever will resolve it. Acquisition stops here — the moment a file is in the queue, library-ingestion owns it, and keeping that seam sharp is what lets a resource acquired through a channel that does not exist yet reach ingestion unchanged. An arrival may be minutes or days away, so it is watched rather than chased."
        }
      ],
      "skos:notation": "A_Route",
      "dcterms:source": "cat-harness/library/processes/content-acquisition.bpmn#A_Route",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_contentacquisition.p_respond",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Give a link, a description, or neither"
        }
      ],
      "skos:definition": [
        {
          "@value": "\"Or neither\" is a real outcome, not a failure. The ask says what happens if nothing comes, and then that happens — the work proceeds without the resource and says so."
        }
      ],
      "skos:notation": "P_Respond",
      "dcterms:source": "cat-harness/library/processes/content-acquisition.bpmn#P_Respond",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_contentacquisition.p_upload",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Drop the file in the queue"
        }
      ],
      "skos:definition": [
        {
          "@value": "Through the forge's upload form, a commit, or any other route that lands the file in the declared queue. The agent watches rather than chases: an arrival may be minutes or days away."
        }
      ],
      "skos:notation": "P_Upload",
      "dcterms:source": "cat-harness/library/processes/content-acquisition.bpmn#P_Upload",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_copyintofolio.task_chooseasset",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Select upstream asset and target folio"
        }
      ],
      "skos:definition": [
        {
          "@value": "Name the upstream layer (`<owner>/<repo>`), the asset's declared path in that layer, the commit `ref` (when pinned), and the target folio declaration that will receive the copy."
        }
      ],
      "skos:notation": "Task_ChooseAsset",
      "dcterms:source": "cat-harness/processes/kg/copy-into-folio.bpmn#Task_ChooseAsset",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_copyintofolio.task_copyanddeclareasset",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Copy asset into target folio and declare in assets[]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Write the asset bytes into a declared path inside the target folio and add the `KgAsset` entry to the target folio's `<name>.json` `assets[]` list (`directory-conventions`). Never drop the copy into an undeclared scratch directory."
        }
      ],
      "skos:notation": "Task_CopyAndDeclareAsset",
      "dcterms:source": "cat-harness/processes/kg/copy-into-folio.bpmn#Task_CopyAndDeclareAsset",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_copyintofolio.task_inspectreadonly",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Browse in place, emit a KgAsset snippet"
        }
      ],
      "skos:definition": [
        {
          "@value": "Clean degradation when no write capability (`git-push`, `github-api`, `github-connector`) is present: inspect the asset in place through the zero-write `browse` affordance and output the ready-to-paste `KgAsset` entry (with `source: { instance, path, ref }` populated) so the author can apply it where they have write access."
        }
      ],
      "skos:notation": "Task_InspectReadOnly",
      "dcterms:source": "cat-harness/processes/kg/copy-into-folio.bpmn#Task_InspectReadOnly",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_copyintofolio.task_probewritecapability",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Probe write capability"
        }
      ],
      "skos:definition": [
        {
          "@value": "Check whether the session holds at least one of the three write capabilities (`git-push`, `github-api`, or `github-connector` under `scenarios/capabilities/`). Keep available, absent and could-not-determine distinct."
        }
      ],
      "skos:notation": "Task_ProbeWriteCapability",
      "dcterms:source": "cat-harness/processes/kg/copy-into-folio.bpmn#Task_ProbeWriteCapability",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_copyintofolio.task_readupstreamasset",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Read the upstream asset (no writes)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Read the asset bytes and its origin coordinates (`instance` as `<owner>/<repo>`, `path` within that instance, and commit `ref`) from the source knowledge graph without modifying anything in the source lane."
        }
      ],
      "skos:notation": "Task_ReadUpstreamAsset",
      "dcterms:source": "cat-harness/processes/kg/copy-into-folio.bpmn#Task_ReadUpstreamAsset",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_copyintofolio.task_stampassetsource",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Stamp the asset's source"
        }
      ],
      "skos:definition": [
        {
          "@value": "Populate `source: { instance, path, ref }` (`AssetSourceSchema` in `schemas/kg/kg-node.ts`) on the new `KgAsset` entry in the same change. Because `source` absent is a third state meaning \"authored locally in this instance\", omitting `source` on a copied asset is forbidden."
        }
      ],
      "skos:notation": "Task_StampAssetSource",
      "dcterms:source": "cat-harness/processes/kg/copy-into-folio.bpmn#Task_StampAssetSource",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_copyintofolio.task_validatedeclaredasset",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Validate the asset and provenance"
        }
      ],
      "skos:definition": [
        {
          "@value": "Run `bun run cat check:declaration-resolution` (`check:declared-assets`) to verify that the copied asset exists at its declared path, its `KgAsset.source` conforms to `AssetSourceSchema`, and the upstream source graph remains untouched."
        }
      ],
      "skos:notation": "Task_ValidateDeclaredAsset",
      "dcterms:source": "cat-harness/processes/kg/copy-into-folio.bpmn#Task_ValidateDeclaredAsset",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_copyintofolio.task_workoncopy",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Edit, comment or raise todos on the folio's copy"
        }
      ],
      "skos:definition": [
        {
          "@value": "The copied asset is now writable content of the target folio with recorded upstream provenance (`KgAsset.source`). The folio author may edit it in place, attach review comments, or raise todos (`todo-manager`) against it."
        }
      ],
      "skos:notation": "Task_WorkOnCopy",
      "dcterms:source": "cat-harness/processes/kg/copy-into-folio.bpmn#Task_WorkOnCopy",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_copyoutmaterialized.task_editdirectly",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Edit it in place — it is your own content"
        }
      ],
      "skos:definition": [
        {
          "@value": "The ordinary path, drawn so the process does not read as though every edit needs a copy. Content in a writable directory is authored content and is edited where it lives; the copy-out is for somebody else's bytes, not for yours."
        }
      ],
      "skos:notation": "Task_EditDirectly",
      "dcterms:source": "cat-harness/library/processes/copy-out-materialized.bpmn#Task_EditDirectly",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_copyoutmaterialized.task_land",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Land the bytes in the copier's own folio/"
        }
      ],
      "skos:definition": [
        {
          "@value": "Into the copier's own declared `folio/`, never a scratch area — a directory nobody declared is a directory nobody gates, and the copy would be publishable by accident. The copy is NOT read-only: it is the copier's own content, makes no claim about anybody else's bytes, and freezing it too would mean the next person needs a copy of the copy."
        }
      ],
      "skos:notation": "Task_Land",
      "dcterms:source": "cat-harness/library/processes/copy-out-materialized.bpmn#Task_Land",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_copyoutmaterialized.task_readsource",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Read the original — and write nothing"
        }
      ],
      "skos:definition": [
        {
          "@value": "A read, and the only interaction this process has with the source. Its digest and `provenance` are carried forward: the digest so Task_VerifySourceUntouched has something to check against, and `provenance` so the copy can name what it came out of without re-deriving it."
        }
      ],
      "skos:notation": "Task_ReadSource",
      "dcterms:source": "cat-harness/library/processes/copy-out-materialized.bpmn#Task_ReadSource",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_copyoutmaterialized.task_recordprovenance",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record what this is a copy of"
        }
      ],
      "skos:definition": [
        {
          "@value": "The step that is easy to omit and impossible to reconstruct afterwards. `provenance` is a PAIR: `upstream` is the remote thing, `local` is the original in this repository. A copy-out writes `local`; it does not overwrite `upstream`, and it does not reuse `upstream` for a local value. Without `local`, one rename later the copy is indistinguishable from original work and nothing downstream can repair it, because the information was never written down."
        }
      ],
      "skos:notation": "Task_RecordProvenance",
      "dcterms:source": "cat-harness/library/processes/copy-out-materialized.bpmn#Task_RecordProvenance",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_copyoutmaterialized.task_verifysourceuntouched",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Verify the ORIGINAL still hashes to its digest"
        }
      ],
      "skos:definition": [
        {
          "@value": "`check:materialized-fixity`. Run against the SOURCE, not the copy — the copy is new content with no claim to verify, and the source is the thing a botched copy-out would have disturbed. A mismatch here means the copy-out was an edit in place wearing a copy's clothes, and it is the only signal that tells the two apart."
        }
      ],
      "skos:notation": "Task_VerifySourceUntouched",
      "dcterms:source": "cat-harness/library/processes/copy-out-materialized.bpmn#Task_VerifySourceUntouched",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm.a_detect",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Detect feature request (crdm-detect skill)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Recognise the request as a platform capability change rather than content work, from crdm-detect's signals. Never call it \"CRDM\" to the person. Mid-content-work, ask whether to pause for requirements now or record a work item for later — do not switch on your own."
        }
      ],
      "skos:notation": "A_Detect",
      "dcterms:source": "cat-harness/processes/process/crdm-requirements.bpmn#A_Detect",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm.ba_submit",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Describe the need (chat, issue, discussion)"
        }
      ],
      "skos:definition": [
        {
          "@value": "The BA describes the capability gap in their own words. They do not need to know it is called CRDM."
        }
      ],
      "skos:notation": "BA_Submit",
      "dcterms:source": "cat-harness/processes/process/crdm-requirements.bpmn#BA_Submit",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm.call_close",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Close-out"
        }
      ],
      "skos:definition": [
        {
          "@value": "The stakeholders sign off, the BA confirms every criterion is met, and only then does the agent close the issue. Never the other way round: an agent must never assume completion."
        }
      ],
      "skos:notation": "Call_Close",
      "dcterms:source": "cat-harness/processes/process/crdm-requirements.bpmn#Call_Close",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm.call_datamodel",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Data model Entities + cardinalities"
        }
      ],
      "skos:definition": [
        {
          "@value": "Between requirements and sign-off, and the order is the argument: requirements are statements about things, and the model says what the things ARE. Drafted earlier it is invented from nothing, since the entities come from the phase-2 BPA; drafted later, sign-off approves requirements whose nouns were never pinned — which is how two stakeholders approve one sentence meaning different things."
        }
      ],
      "skos:notation": "Call_DataModel",
      "dcterms:source": "cat-harness/processes/process/crdm-requirements.bpmn#Call_DataModel",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm.call_deliver",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Phase 6 Implement + acceptance"
        }
      ],
      "skos:definition": [
        {
          "@value": "One phase and not three, because the loops say so: an increment the BA rejects, an MVP that is not ready, and stakeholder findings all route back into implementation. A subprocess has one exit and cannot be re-entered once finished, so splitting this region would have changed what the diagram says."
        }
      ],
      "skos:notation": "Call_Deliver",
      "dcterms:source": "cat-harness/processes/process/crdm-requirements.bpmn#Call_Deliver",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm.call_issue",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Link the work to an issue"
        }
      ],
      "skos:definition": [
        {
          "@value": "Feature work must be linked to a GitHub issue. Scan before creating, and never create one without the BA's permission — an issue is the stakeholder's record, not the agent's scratchpad."
        }
      ],
      "skos:notation": "Call_Issue",
      "dcterms:source": "cat-harness/processes/process/crdm-requirements.bpmn#Call_Issue",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm.call_needs",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Phase 1 Needs"
        }
      ],
      "skos:definition": [
        {
          "@value": "Identify the stakeholders, synthesise a needs statement from the sources, and loop until the BA and the stakeholders both recognise it. The loop is the phase: a needs statement nobody confirmed is an agent's summary, not a requirement."
        }
      ],
      "skos:notation": "Call_Needs",
      "dcterms:source": "cat-harness/processes/process/crdm-requirements.bpmn#Call_Needs",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm.call_requirements",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Phases 2–4 BPA + requirements"
        }
      ],
      "skos:definition": [
        {
          "@value": "Map the current workflow, then define the requirements and the impact they carry, and loop until approved. Same shape as Phase 1 and for the same reason: an unapproved requirement is a proposal."
        }
      ],
      "skos:notation": "Call_Requirements",
      "dcterms:source": "cat-harness/processes/process/crdm-requirements.bpmn#Call_Requirements",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm.call_signoff",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Phase 5 Plan + sign-off"
        }
      ],
      "skos:definition": [
        {
          "@value": "The approved requirements become work-plan items, the BA signs off, and the branch is announced on the issue. The announcement is on the single edge into delivery, so the three loops back into implementation do not re-announce."
        }
      ],
      "skos:notation": "Call_Signoff",
      "dcterms:source": "cat-harness/processes/process/crdm-requirements.bpmn#Call_Signoff",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_close.a_close",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Close issue ONLY on BA authorisation"
        }
      ],
      "skos:definition": [
        {
          "@value": "Reachable only through BA_Confirm, which is the BA saying every criterion is met. An agent must never close an issue without that explicit authorisation — the gate is the preceding task, and this name says so rather than leaving a reader to trace the flow for it."
        }
      ],
      "skos:notation": "A_Close",
      "dcterms:source": "cat-harness/processes/process/crdm-close.bpmn#A_Close",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_close.a_recordsignoff",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record the sign-off attestation"
        }
      ],
      "skos:definition": [
        {
          "@value": "THE RECORD, and not relaxable, because a judgement nobody wrote down is indistinguishable from one never made (`adjudication`, A_RecordEntry). Append one `requirement-signoff` record to `test/attestations/requirement-signoff/<set slug>.attestations.json` — who (kind, id, actor), at, scope (the set or one member), the outcome from the requirement-set code list, the stage it moves the set to, the reason, and the permalink to the issue comment where it was decided — and set the set's `stage` to match. GW_SignoffRecorded after this reads the record back, so this step cannot be skipped by completing it: a sign-off that left no attestation loops here again."
        }
      ],
      "skos:notation": "A_RecordSignoff",
      "dcterms:source": "cat-harness/processes/process/crdm-close.bpmn#A_RecordSignoff",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_close.ba_confirm",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Confirm all criteria met"
        }
      ],
      "skos:definition": [
        {
          "@value": "The business analyst confirms every acceptance criterion from the requirements is met. The issue closes only on their authorisation — an agent never closes an issue on its own say-so. It IS an adjudication with the requirement-set answers: an approval here moves the set to `accepted`, which `check:requirements` refuses unless it is a human's and every approved member is `in-force`."
        }
      ],
      "skos:notation": "BA_Confirm",
      "dcterms:source": "cat-harness/processes/process/crdm-close.bpmn#BA_Confirm",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_close.call_mergetomain",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Land the feature's PRs"
        }
      ],
      "skos:definition": [
        {
          "@value": "Phase 6's \"explicit confirmation before merging to main\", made a step that can refuse. Once per pull request the feature still has open, after the sign-off is recorded and before the issue is closed: an issue is not closed on a feature that is not on `main`. `merge-to-main.bpmn` reads each head's evidence live, establishes that the owner authorised THAT merge (a stakeholder sign-off or the BA's confirmation is acceptance of the feature, not authorisation to merge it, unless the owner's own words say so), records the authorisation, merges, and confirms the base. A PR the owner holds or refuses stays open, and A_Close then waits: the BA's authorisation to close does not cover a feature that did not land. An increment the owner asked to land earlier in Phase 6 went through the same sub-process at that time. Where `cat-harness.sdlc` is switched on, this step is the opt-in process `merge-to-main` (`Process_MergeToMain`, sdlc/processes/merge-to-main.bpmn); it is not called from here, because a layer without that sub-graph does not have it (owner card Q-OPTIN-CALLS A, 2026-11-12)."
        }
      ],
      "skos:notation": "Call_MergeToMain",
      "dcterms:source": "cat-harness/processes/process/crdm-close.bpmn#Call_MergeToMain",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_close.s_featuresignoff",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Feature sign-off on issue"
        }
      ],
      "skos:definition": [
        {
          "@value": "Stakeholders sign off on the delivered feature on the issue, having tested the built artefact rather than a description of it."
        }
      ],
      "skos:notation": "S_FeatureSignoff",
      "dcterms:source": "cat-harness/processes/process/crdm-close.bpmn#S_FeatureSignoff",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_datamodel.a_declare",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Declare the model where a tool can read it"
        }
      ],
      "skos:definition": [
        {
          "@value": "A model in prose is a proposal; a model in the declaration is a model. Ship a reader in the same change: a model that is only documentation goes inert."
        }
      ],
      "skos:notation": "A_Declare",
      "dcterms:source": "cat-harness/processes/process/crdm-data-model.bpmn#A_Declare",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_datamodel.a_entities",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Identify entities from the BPA and requirements"
        }
      ],
      "skos:definition": [
        {
          "@value": "Every verb in the BPA whose object is a candidate entity, and every noun in a requirement. An entity with no identifier is an attribute of something else — that test is decisive and belongs to the technique skill."
        }
      ],
      "skos:notation": "A_Entities",
      "dcterms:source": "cat-harness/processes/process/crdm-data-model.bpmn#A_Entities",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_datamodel.a_relations",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Relations and cardinalities, both ways"
        }
      ],
      "skos:definition": [
        {
          "@value": "Stated in both directions, because \"one attestation per report\" and \"one report per attestation\" are different claims and a model with only the first cannot say whether a re-signature is an update or a second row."
        }
      ],
      "skos:notation": "A_Relations",
      "dcterms:source": "cat-harness/processes/process/crdm-data-model.bpmn#A_Relations",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_datamodel.ba_confirmentities",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Confirm the entities are the ones meant"
        }
      ],
      "skos:definition": [
        {
          "@value": "A naming question. The BA owns the domain vocabulary; the agent does not guess, which is CRDM's own rule for phase 1 and applies here with more force."
        }
      ],
      "skos:notation": "BA_ConfirmEntities",
      "dcterms:source": "cat-harness/processes/process/crdm-data-model.bpmn#BA_ConfirmEntities",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_datamodel.s_confirmcardinality",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Confirm the cardinalities"
        }
      ],
      "skos:definition": [
        {
          "@value": "An operational question, asked of the people who run the process because they know where the exceptions are."
        }
      ],
      "skos:notation": "S_ConfirmCardinality",
      "dcterms:source": "cat-harness/processes/process/crdm-data-model.bpmn#S_ConfirmCardinality",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_deliver.a_codeaudit",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Audit the code nodes the increment adds"
        }
      ],
      "skos:definition": [
        {
          "@value": "Descend into the review task for what this increment CHANGED IN THE GRAPH — Tool definitions in `tools/` and schema definition nodes under `schemas/`. It runs before the summary, and therefore before an MVP can be shared: a Tool or schema node shipped in an MVP is the version stakeholders start building expectations on, and a node that names a skill nobody wrote is cheaper to catch here than after sign-off. Called, not inherited: the agent keeps its implementing role and takes on the `code-reviewer` lane inside Process_CodeReview for that call path only."
        }
      ],
      "skos:notation": "A_CodeAudit",
      "dcterms:source": "cat-harness/processes/process/crdm-deliver.bpmn#A_CodeAudit",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_deliver.a_deploystaging",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Deploy the MVP to staging"
        }
      ],
      "skos:definition": [
        {
          "@value": "An MVP is shared AS A branches/ DEPLOY, not as a description of one. `feature-staging.yml` publishes the branch under `branches/<branch-slug>/` on gh-pages and comments the URL on the PR, so the stakeholder who tests it is looking at the built artefact rather than at a screenshot — the same argument the merge discipline makes about rendered work: holding a rendered change back for assessment makes assessment harder, not safer."
        }
      ],
      "skos:notation": "A_DeployStaging",
      "dcterms:source": "cat-harness/processes/process/crdm-deliver.bpmn#A_DeployStaging",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_deliver.a_implement",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Phase 6: Implement (feature branch + PR)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Inner loop: agent claims a bean, implements on feature branch, opens PR, posts summary to the issue. When the requirement changes a rendered surface, implement against the wireframe candidate the requester or BA chose in Phases 3–4 (Process_WireframeDesignReview, called from Process_CRDM_Requirements), not against a fresh design; and the delivery summary links the chosen candidate beside the after-screenshot, so the reviewer can see the build matches what was approved."
        }
      ],
      "skos:notation": "A_Implement",
      "dcterms:source": "cat-harness/processes/process/crdm-deliver.bpmn#A_Implement",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_deliver.a_summary",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Post summary to issue"
        }
      ],
      "skos:definition": [
        {
          "@value": "What was accomplished, what remains, and the staging links: one deep link per changed page on the preview, with the same page on main (feedback-deep-links)."
        }
      ],
      "skos:notation": "A_Summary",
      "dcterms:source": "cat-harness/processes/process/crdm-deliver.bpmn#A_Summary",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_deliver.ba_reviewincrement",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review increment (test behaviour)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Inner loop: the BA tests each delivered increment against the acceptance criteria. They do not review code — they test behaviour."
        }
      ],
      "skos:notation": "BA_ReviewIncrement",
      "dcterms:source": "cat-harness/processes/process/crdm-deliver.bpmn#BA_ReviewIncrement",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_deliver.ba_sharemvp",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Share MVP with stakeholders"
        }
      ],
      "skos:definition": [
        {
          "@value": "Outer loop: the BA presents the accumulated increments to stakeholders as a testable MVP. Staging URL, demo, or walkthrough."
        }
      ],
      "skos:notation": "BA_ShareMVP",
      "dcterms:source": "cat-harness/processes/process/crdm-deliver.bpmn#BA_ShareMVP",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_deliver.ba_translatefeedback",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Translate feedback into agent direction"
        }
      ],
      "skos:definition": [
        {
          "@value": "The BA translates stakeholder findings into actionable direction: new beans or bean updates for the agent."
        }
      ],
      "skos:notation": "BA_TranslateFeedback",
      "dcterms:source": "cat-harness/processes/process/crdm-deliver.bpmn#BA_TranslateFeedback",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_deliver.call_optionsanalysis",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Options analysis how to implement"
        }
      ],
      "skos:definition": [
        {
          "@value": "On the single edge from `Start_Process_CRDM_Deliver` into `A_Implement`, so the approach is chosen before any code exists. By Phase 6 the needs, requirements and data model are signed off, which is exactly the evidence an options analysis needs and the reason it belongs here rather than earlier: at `Call_Needs` there is nothing to weigh, and after `A_Implement` the choice has been made in code. The three loop-backs into `A_Implement` — `_5` (increment rejected), `_7` (MVP not ready), `_13` (feedback translated) — deliberately BYPASS this call. Routing them through it would run the subprocess on every iteration of the inner loop, which is the ceremony this design refuses: a gate invoked on every pass stops being read. An iteration reworks an approach already chosen; if the APPROACH is what is wrong, that is not a loop iteration and it belongs to the calling step in `crdm-requirements.bpmn`. Contrast `upstream-version-adoption`, where the loop DOES re-enter the analysis. There the loop-back returns to `A_Impact`, which re-gathers the evidence, so the second pass weighs genuinely different inputs. Here the loop returns to implementation with the evidence unchanged. `A_Implement` carries a `note` on the bean (its claim is the OPEN that `Process_CRDM` calls first); this step carries no bean op, because `Process_OptionsAnalysis` ends with its own `decision-audit` note on the bean the caller claimed."
        }
      ],
      "skos:notation": "Call_OptionsAnalysis",
      "dcterms:source": "cat-harness/processes/process/crdm-deliver.bpmn#Call_OptionsAnalysis",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_deliver.s_testmvp",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Test MVP in own context"
        }
      ],
      "skos:definition": [
        {
          "@value": "Stakeholders test the delivered feature in their own workflow, with their own data. They report what works and what does not."
        }
      ],
      "skos:notation": "S_TestMVP",
      "dcterms:source": "cat-harness/processes/process/crdm-deliver.bpmn#S_TestMVP",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_issue.a_askcreate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Ask BA to create or link issue"
        }
      ],
      "skos:definition": [
        {
          "@value": "Ask — never create. Creating an issue without the BA's permission is the thing this step exists to prevent."
        }
      ],
      "skos:notation": "A_AskCreate",
      "dcterms:source": "cat-harness/processes/process/crdm-issue-linking.bpmn#A_AskCreate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_issue.a_linkissue",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Link to existing issue"
        }
      ],
      "skos:definition": [
        {
          "@value": "A match was found: ask the person whether the requirements go on #NNN, then link the work there. The issue is where stakeholders sign off, so no phase proceeds without one."
        }
      ],
      "skos:notation": "A_LinkIssue",
      "dcterms:source": "cat-harness/processes/process/crdm-issue-linking.bpmn#A_LinkIssue",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_issue.a_scanissues",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Scan open issues for match"
        }
      ],
      "skos:definition": [
        {
          "@value": "Search open issues, then recently closed ones, by title and body keywords for one this request belongs to. Requirements may span several issues; note every relevant one."
        }
      ],
      "skos:notation": "A_ScanIssues",
      "dcterms:source": "cat-harness/processes/process/crdm-issue-linking.bpmn#A_ScanIssues",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_issue.call_relatedwork",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Related work: find, sort, ask"
        }
      ],
      "skos:definition": [
        {
          "@value": "When the requirement is initiated or updated through a human-agent chat, search the beans and the repository's issues and open PRs for relevance, categorize and summarize them, and ask the user whether and how to coordinate. Judgement decides the categories; the user decides the coordination."
        }
      ],
      "skos:notation": "Call_RelatedWork",
      "dcterms:source": "cat-harness/processes/process/crdm-issue-linking.bpmn#Call_RelatedWork",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_needs.a_stakeholders",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Phase 1: Identify stakeholders"
        }
      ],
      "skos:definition": [
        {
          "@value": "The agent asks the BA who is affected by this change. The BA knows the domain — the agent does not guess."
        }
      ],
      "skos:notation": "A_Stakeholders",
      "dcterms:source": "cat-harness/processes/process/crdm-needs.bpmn#A_Stakeholders",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_needs.a_synthesise",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Phase 1: Synthesise needs from sources"
        }
      ],
      "skos:definition": [
        {
          "@value": "From the chat, issue, uploads and library sources, write a clear, jargon-free statement of what is needed and why, tied to a concrete workflow. Post it on the GitHub issue, not in chat, and ask the requester and stakeholders to review it."
        }
      ],
      "skos:notation": "A_Synthesise",
      "dcterms:source": "cat-harness/processes/process/crdm-needs.bpmn#A_Synthesise",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_needs.ba_reviewneeds",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review synthesised needs statement"
        }
      ],
      "skos:definition": [
        {
          "@value": "The BA reviews what the agent synthesised and checks it against what they actually need."
        }
      ],
      "skos:notation": "BA_ReviewNeeds",
      "dcterms:source": "cat-harness/processes/process/crdm-needs.bpmn#BA_ReviewNeeds",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_needs.s_confirmneeds",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Confirm needs statement"
        }
      ],
      "skos:definition": [
        {
          "@value": "Stakeholders confirm, on the issue, that the needs statement says what they need — or say what to change. A stakeholder's judgement; an agent does not record it for them."
        }
      ],
      "skos:notation": "S_ConfirmNeeds",
      "dcterms:source": "cat-harness/processes/process/crdm-needs.bpmn#S_ConfirmNeeds",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_requirements.a_compareoptions",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Phase 4a: Compare the viable options"
        }
      ],
      "skos:definition": [
        {
          "@value": "Phase 4 often ends with a CHOICE rather than a plan, and this is the step that hands it over. Per option: what it does, its pro, its con, what it changes DOWNSTREAM, and how reversible it is — laid out where the rows can be read against each other, then one recommendation and a stated default. A step of its own rather than a line inside A_DefineReqs, because it has a different output and a different reader: the impact analysis is for the record, the comparison is the thing the BA answers from. Folding it in is how it gets skipped — the analysis feels finished, so the options go over as a list of names. When Call_Wireframe ran, its wireframe candidates are among the options: one row per candidate, with a link to its web and mobile screenshots. Skipped legitimately when the analysis yields ONE viable approach. Do not manufacture alternatives to fill a table."
        }
      ],
      "skos:notation": "A_CompareOptions",
      "dcterms:source": "cat-harness/processes/process/crdm-requirements-definition.bpmn#A_CompareOptions",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_requirements.a_definereqs",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Phases 3–4: Define requirements + impact"
        }
      ],
      "skos:definition": [
        {
          "@value": "Two skills, because this step is two things: the requirements come from the CRDM process, the impact half is a question about the entities and relations the change touches, which is what data modelling answers; a folio-content skill such as `content-graph` is not one this harness diagram can bind."
        }
      ],
      "skos:notation": "A_DefineReqs",
      "dcterms:source": "cat-harness/processes/process/crdm-requirements-definition.bpmn#A_DefineReqs",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_requirements.a_mapworkflow",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Phase 2: Map current workflow (BPA)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Business-process analysis here means reading the existing diagrams under processes/ and drawing the gap, so the skill that implements this step is the BPMN one."
        }
      ],
      "skos:notation": "A_MapWorkflow",
      "dcterms:source": "cat-harness/processes/process/crdm-requirements-definition.bpmn#A_MapWorkflow",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_requirements.ba_reviewreqs",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review requirements and impact analysis"
        }
      ],
      "skos:definition": [
        {
          "@value": "The BA reviews the formal requirements and the impact analysis the agent produced. When a requirement changes a rendered surface, the BA (or the requester) also reviews the wireframe candidates, web and mobile, shown wherever the requester will look (the conversation, the issue, the pull request, or several) with staging deep links and screenshots, and chooses one before implementation starts. The agent records the choice; it never makes it."
        }
      ],
      "skos:notation": "BA_ReviewReqs",
      "dcterms:source": "cat-harness/processes/process/crdm-requirements-definition.bpmn#BA_ReviewReqs",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_requirements.call_wireframe",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Wireframe candidates (web + mobile)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Design use of wireframe-design-review, before implementation: a written design intent, at least two mid-fidelity candidates each with a web and a mobile layout, the mechanical checks, and a blind review. The candidates are committed as assets of the request's proposal, under docs/proposals/<slug>/wireframes/ beside docs/proposals/<slug>.md, on the feature branch so feature-staging publishes them, and shown where the requester will look, chosen from context — the conversation, the issue the request came from, the pull request, or several of these — each place carrying the same staging deep links and screenshots (feedback-deep-links, point 5: where it goes is a judgement). The requester or BA is the human reviewer and chooses one at BA_ReviewReqs. A wireframe is part of the design process for adjudication (methodologies/wiregen.md). The candidates ARE the options A_CompareOptions lays out, so this merges into it rather than producing a second comparison."
        }
      ],
      "skos:notation": "Call_Wireframe",
      "dcterms:source": "cat-harness/processes/process/crdm-requirements-definition.bpmn#Call_Wireframe",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_requirements.s_approvereqs",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Approve requirements"
        }
      ],
      "skos:definition": [
        {
          "@value": "Stakeholders approve the requirements and impact analysis on the issue, or send them back for revision. Only their approval moves the work to sign-off; an agent never records an approval on a person's behalf."
        }
      ],
      "skos:notation": "S_ApproveReqs",
      "dcterms:source": "cat-harness/processes/process/crdm-requirements-definition.bpmn#S_ApproveReqs",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_signoff.a_announcebranch",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Announce the branch on the issue"
        }
      ],
      "skos:definition": [
        {
          "@value": "On CREATING the feature branch, comment on the issue: the branch name, the process and phase, and the beans claimed. Visibility is the whole point — without it a sibling session or a human cannot tell that work has begun, only that it has finished. Deliberately on this edge and not inside Phase 6. The three loops back into A_Implement (increment rejected, MVP not ready, feedback translated) re-enter implementation on the SAME branch, and re-announcing on each would be noise. Announce once, when the branch is created. Before announcing, run the collision review that starts any new unit of work (coordinate, \"Starting new work\"): open PRs and in-progress beans checked against the branch's files and subject, scaled to the blast radius, and the result recorded in the bean before the first edit."
        }
      ],
      "skos:notation": "A_AnnounceBranch",
      "dcterms:source": "cat-harness/processes/process/crdm-signoff.bpmn#A_AnnounceBranch",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_signoff.a_createbeans",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Phase 5: Create beans"
        }
      ],
      "skos:definition": [
        {
          "@value": "The agent mints the implementation beans itself with `beans create`, running the exact-title existence check first. The engine has no `create` op — it claims, notes and resolves the instance's OWN bean — so what this step records here is a note that the plan now exists."
        }
      ],
      "skos:notation": "A_CreateBeans",
      "dcterms:source": "cat-harness/processes/process/crdm-signoff.bpmn#A_CreateBeans",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_signoff.a_offerkg",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Offer KG destinations for the agreed set"
        }
      ],
      "skos:definition": [
        {
          "@value": "Without this step, agreed and signed-off requirements exist only as an issue and a conversation, and the knowledge graph never learns them. ONE question for the SET, not one per requirement: a six-phase run can agree many, and asking six times is the same failure as a form that re-asks what it was already told. The options are DERIVED from the graphs this layer declares in `<name>.json`, read at the time of asking, so a layer that adds a graph gets it in the offer without anybody editing a skill. Never a list typed from memory."
        }
      ],
      "skos:notation": "A_OfferKg",
      "dcterms:source": "cat-harness/processes/process/crdm-signoff.bpmn#A_OfferKg",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_signoff.a_recordkg",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Run placement, file a bean"
        }
      ],
      "skos:definition": [
        {
          "@value": "The offer produces a DECISION, not a node. `placement` then decides layer, graph and node kind — it is the step that catches a hardcoded path or a literal naming one folio — and the authoring itself becomes a bean, because work here is a bean before it is a file. `op=\"note\"` and not `create`, for the reason `A_CreateBeans` above states: the engine has no `create` op — it claims, notes and resolves the instance's OWN bean. The agent mints the authoring bean itself with `beans create`, running the exact-title existence check first, and what this step records is a note that the decision was taken."
        }
      ],
      "skos:notation": "A_RecordKg",
      "dcterms:source": "cat-harness/processes/process/crdm-signoff.bpmn#A_RecordKg",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_signoff.a_recordsignoff",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record the sign-off attestation"
        }
      ],
      "skos:definition": [
        {
          "@value": "THE RECORD, and not relaxable, because a judgement nobody wrote down is indistinguishable from one never made (`adjudication`, A_RecordEntry). Append one `requirement-signoff` record to `test/attestations/requirement-signoff/<set slug>.attestations.json` — who (kind, id, actor), at, scope (the set or one member), the outcome from the requirement-set code list, the stage it moves the set to, the reason, and the permalink to the issue comment where it was decided — and set the set's `stage` to match. GW_SignoffRecorded after this reads the record back, so this step cannot be skipped by completing it: a sign-off that left no attestation loops here again."
        }
      ],
      "skos:notation": "A_RecordSignoff",
      "dcterms:source": "cat-harness/processes/process/crdm-signoff.bpmn#A_RecordSignoff",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_signoff.ba_choosekg",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Choose a destination, or none"
        }
      ],
      "skos:definition": [
        {
          "@value": "A PERSON'S STEP, and `none` is one of the answers rather than a refusal to answer. A requirement whose whole content is carried by the code becomes a commit and nothing else; a graph that acquires a node for it is a graph with a node nobody will ever read. The default creates NOTHING. An agent that decides on its own that a requirement \"is really a skill\" has manufactured a node nobody asked for, in a graph somebody else maintains — which is what this step exists to prevent."
        }
      ],
      "skos:notation": "BA_ChooseKg",
      "dcterms:source": "cat-harness/processes/process/crdm-signoff.bpmn#BA_ChooseKg",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_signoff.ba_signoff",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Sign off on requirements"
        }
      ],
      "skos:definition": [
        {
          "@value": "The business analyst / requester signs off on the agreed requirement set, on the issue: what was agreed and what was deferred. Recorded as their decision, with its reason, never by an agent on their behalf. It IS an adjudication: it calls Process_Adjudication with the requirement-set answers, and every answer goes through A_RecordSignoff before anything follows it."
        }
      ],
      "skos:notation": "BA_Signoff",
      "dcterms:source": "cat-harness/processes/process/crdm-signoff.bpmn#BA_Signoff",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_criterionadjudication.a_dispensation",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Grant a dispensation, with its reason"
        }
      ],
      "skos:definition": [
        {
          "@value": "The rule applies and this subject is a stated exception. A `kind: \"human\"` entry with `result: \"pass\"` overrides the script's `fail` for that criterion, and ONLY while its `field_hash` matches the current source — so the dispensation is scoped to the version it was granted against, lapses when the block changes, and never becomes precedent. There is nothing to overturn later; the source moving overturns it. A dispensation with no `notes` is not a dispensation. It is an override somebody applied to get to green, and nobody can review it afterwards — which is why this step is not relaxable."
        }
      ],
      "skos:notation": "A_Dispensation",
      "dcterms:source": "cat-harness/processes/process/criterion-adjudication.bpmn#A_Dispensation",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_criterionadjudication.a_recordentry",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Write the entry that LEADS — keeping the checker's beneath it"
        }
      ],
      "skos:definition": [
        {
          "@value": "Not relaxable, and the one step here that is not. A judgement nobody wrote down is indistinguishable from a checker that was never run, so the judgement is free and the record is not. Do not resolve the disagreement away: both entries stay, the adjudication on top under the sweep's most-recent-matching-hash rule. A disagreement between a checker and a reviewer is information, and somebody re-running the check next month needs to find that a checker read it differently rather than a clean pass. `/api/relevance/adjudicate` reached the same rule independently — `human_adjudicated` written alongside, never over, the agent's `assessed_by`."
        }
      ],
      "skos:notation": "A_RecordEntry",
      "dcterms:source": "cat-harness/processes/process/criterion-adjudication.bpmn#A_RecordEntry",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_criterionadjudication.a_scopecriterion",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Scope the criterion so it stops applying here"
        }
      ],
      "skos:definition": [
        {
          "@value": "One edit to the criterion rather than ten overrules on the blocks it should never have covered. This branch is the one an adjudicator under time pressure converts into a dispensation, and the conversion is a defect: a dispensation lapses when the source moves, so a mis-scoped criterion granted its way past comes back every time anybody touches the block."
        }
      ],
      "skos:notation": "A_ScopeCriterion",
      "dcterms:source": "cat-harness/processes/process/criterion-adjudication.bpmn#A_ScopeCriterion",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_criterionadjudication.call_adjudicate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Adjudicate the criterion disagreement"
        }
      ],
      "skos:definition": [
        {
          "@value": "The shared judgement — entry condition, untainted dispatch, person-or-agent restriction — asked with THIS question's permitted answers. `cat-harness.processes:adjudication codes` sits here rather than on `A_Adjudicate` inside it because the answers depend on what was asked, and the gateway below is what acts on them: the engine refuses a mismatch between the two. `Process_Adjudication` may also leave at `End_NotAdjudicable` — one entry and no other side is a review or a gate, not a disagreement — in which case nothing below runs and there is nothing to record."
        }
      ],
      "skos:notation": "Call_Adjudicate",
      "dcterms:source": "cat-harness/processes/process/criterion-adjudication.bpmn#Call_Adjudicate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_graphdetanglement.task_authorise",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Authorise the extraction"
        }
      ],
      "skos:definition": [
        {
          "@value": "The one step no package may relax. A repository cut changes the substrate every other diagram's lanes bind to, and that is a person's decision."
        }
      ],
      "skos:notation": "Task_Authorise",
      "dcterms:source": "cat-harness/processes/kg/graph-detanglement.bpmn#Task_Authorise",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_graphdetanglement.task_brief",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Brief the topic before touching anything"
        }
      ],
      "skos:definition": [
        {
          "@value": "What am I doing and why is it worth doing; what do I already know, with each measurement's provenance; how do I plan to do it and WHAT WOULD FALSIFY THE APPROACH. A falsifier that never fires is decoration."
        }
      ],
      "skos:notation": "Task_Brief",
      "dcterms:source": "cat-harness/processes/kg/graph-detanglement.bpmn#Task_Brief",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_graphdetanglement.task_declare",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "1 · Declare in place (nothing moves)"
        }
      ],
      "skos:definition": [
        {
          "@value": "A `<name>.json` entry with its `graphs[]` kinds. A sub-graph that owns its own layout gains a NESTED declaration whose paths resolve against its own directory, so the whole graph relocates by moving one folder."
        }
      ],
      "skos:notation": "Task_Declare",
      "dcterms:source": "cat-harness/processes/kg/graph-detanglement.bpmn#Task_Declare",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_graphdetanglement.task_extract",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "4 · Extract — a directory move, not a file-by-file sift"
        }
      ],
      "skos:definition": [
        {
          "@value": "Only once edges are zero and the declaration stands alone: move the sub-graph out as one directory move, not a file-by-file sift. Its nested declaration resolves paths against its own directory, so moving the folder moves the graph. The five-point gate is in migration-plan.md Phase II."
        }
      ],
      "skos:notation": "Task_Extract",
      "dcterms:source": "cat-harness/processes/kg/graph-detanglement.bpmn#Task_Extract",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_graphdetanglement.task_isolate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "3 · Isolate — own declaration, namespace, artefact"
        }
      ],
      "skos:definition": [
        {
          "@value": "Only once cross-edges measure zero: give the sub-graph its own declaration, its own namespace and its own published artefact, as bootstrap/ has (its own declaration, bs: namespace and graph document). Nothing moves yet; the sub-graph now stands alone in place."
        }
      ],
      "skos:notation": "Task_Isolate",
      "dcterms:source": "cat-harness/processes/kg/graph-detanglement.bpmn#Task_Isolate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_graphdetanglement.task_measure",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "2a · Measure — unassigned column FIRST"
        }
      ],
      "skos:definition": [
        {
          "@value": "`bun run cat check:partition`. Read the unassigned column before the edge count, and quote BOTH numbers rather than only the one that improved. The edge count can rise when the measurement improves (previously unjudged edges are folded in); that is correct."
        }
      ],
      "skos:notation": "Task_Measure",
      "dcterms:source": "cat-harness/processes/kg/graph-detanglement.bpmn#Task_Measure",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_graphdetanglement.task_move",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "2b · Prune, merge, factor — or the classification is wrong"
        }
      ],
      "skos:definition": [
        {
          "@value": "The only four moves. Move the shared TARGET first and the importers after; check the target's layer before the importer's; a schema moves with its script. The fix is never an exemption, it is the right owner."
        }
      ],
      "skos:notation": "Task_Move",
      "dcterms:source": "cat-harness/processes/kg/graph-detanglement.bpmn#Task_Move",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_graphdetanglement.task_propose",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Report what would move — sizes, and what breaks"
        }
      ],
      "skos:definition": [
        {
          "@value": "The agent reports and waits: what would move, how large, what in the parent breaks, and the rollback. `deletion-requires-confirmation` is not a courtesy to waive: an agent never removes or relocates a durable artefact on its own initiative."
        }
      ],
      "skos:notation": "Task_Propose",
      "dcterms:source": "cat-harness/processes/kg/graph-detanglement.bpmn#Task_Propose",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_handbacktodiscussion.d_ask",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Ask the person"
        }
      ],
      "skos:definition": [
        {
          "@value": "The sibling's ask, unchanged in letters and recommendation, through `Process_AskThePerson`: the full chat text first, naming the sibling and that the answer will be passed on, then the card. A tap on the sibling's own card or a Blue-column answer in the sheet answers it too; take the first."
        }
      ],
      "skos:notation": "D_Ask",
      "dcterms:source": "cat-harness/processes/process/hand-back-to-discussion.bpmn#D_Ask",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_handbacktodiscussion.d_inform",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Post it in the discussion"
        }
      ],
      "skos:definition": [
        {
          "@value": "Say it comes from the sibling (title and link) and give the context or result in full. State `informed`."
        }
      ],
      "skos:notation": "D_Inform",
      "dcterms:source": "cat-harness/processes/process/hand-back-to-discussion.bpmn#D_Inform",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_handbacktodiscussion.d_markanswered",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Mark every copy answered"
        }
      ],
      "skos:definition": [
        {
          "@value": "Chat copies keep their text: the question struck through and \"[Edit: <letter> chosen by <who>, <time>]\" added. Cards closed with the chosen option. The sheet's \"Decision needed\" block replaced by the decision and who made it. Withdrawn or superseded hand-backs marked the same way, with the reason."
        }
      ],
      "skos:notation": "D_MarkAnswered",
      "dcterms:source": "cat-harness/processes/process/hand-back-to-discussion.bpmn#D_MarkAnswered",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_handbacktodiscussion.d_routeback",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Route the answer back, quoted"
        }
      ],
      "skos:definition": [
        {
          "@value": "On `answerRoute`, with the person's own message attached by id where the host allows, so the sibling can treat it as the person's approval. A paraphrase is never approval."
        }
      ],
      "skos:notation": "D_RouteBack",
      "dcterms:source": "cat-harness/processes/process/hand-back-to-discussion.bpmn#D_RouteBack",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_handbacktodiscussion.s_act",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Act on the answer"
        }
      ],
      "skos:definition": [
        {
          "@value": "Never ask the person again for what they answered. A rule-level answer goes into the governing skill in the same turn."
        }
      ],
      "skos:notation": "S_Act",
      "dcterms:source": "cat-harness/processes/process/hand-back-to-discussion.bpmn#S_Act",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_handbacktodiscussion.s_compose",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Compose the hand-back and post it in own thread"
        }
      ],
      "skos:definition": [
        {
          "@value": "Compose it once, against the input schema: a question is the full ask-the-person input (what will differ, context, lettered options with a one-line trade-off each, the recommendation, what happens with no answer); context, a result or a blocker gets the same stand-alone test. Post it in your own thread too, chat text then card. Your own thread is never the only copy."
        }
      ],
      "skos:notation": "S_Compose",
      "dcterms:source": "cat-harness/processes/process/hand-back-to-discussion.bpmn#S_Compose",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_handbacktodiscussion.s_handback",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Hand it back to the discussion agent"
        }
      ],
      "skos:definition": [
        {
          "@value": "By the host's route: `message_coordinator` or `message_thread` in Claude projects; the final report (a json block valid against the input schema) for a subagent; `SendMessage` for a sibling session. Then keep working on the recommended option where it can be undone, or stop if `blocking`."
        }
      ],
      "skos:notation": "S_HandBack",
      "dcterms:source": "cat-harness/processes/process/hand-back-to-discussion.bpmn#S_HandBack",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_handbacktodiscussion.s_mirror",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Mirror it to the feedback channel"
        }
      ],
      "skos:definition": [
        {
          "@value": "Review sheet: the \"Decision needed\" block in the row's agent column, Agentic status `Needs you` (the document layer's `review-sheet-script` skill). Issue or PR: a comment. An extra copy, never instead of the discussion."
        }
      ],
      "skos:notation": "S_Mirror",
      "dcterms:source": "cat-harness/processes/process/hand-back-to-discussion.bpmn#S_Mirror",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_harnessrendering.a_board",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Draw the board of todos and beans"
        }
      ],
      "skos:definition": [
        {
          "@value": "The todo board mounts inside the landing board, so harness cards and todo stickies share one surface. Each card carries an edit link only when the build composed one."
        }
      ],
      "skos:notation": "A_Board",
      "dcterms:source": "cat-harness/processes/ui/harness-default-rendering.bpmn#A_Board",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_harnessrendering.a_ground",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Resolve each harness's page ground"
        }
      ],
      "skos:definition": [
        {
          "@value": "The theme art for that harness's pages, all three crops or none, and the URL scopes that make a page that harness's (`pageGround`). The site owner's ground is the fallback for a page no scope claims."
        }
      ],
      "skos:notation": "A_Ground",
      "dcterms:source": "cat-harness/processes/ui/harness-default-rendering.bpmn#A_Ground",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_harnessrendering.a_propose",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Propose the change"
        }
      ],
      "skos:definition": [
        {
          "@value": "Through whichever write tool the session has. The change is a proposal: it goes into the content change review, which decides whether it is published."
        }
      ],
      "skos:notation": "A_Propose",
      "dcterms:source": "cat-harness/processes/ui/harness-default-rendering.bpmn#A_Propose",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_harnessrendering.a_publish",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Publish docs on their theme's art"
        }
      ],
      "skos:definition": [
        {
          "@value": "`head_custom.html` sets the ground behind every page of the harness, under two scrims of the page's own colour, so text and links keep the plain page's contrast."
        }
      ],
      "skos:notation": "A_Publish",
      "dcterms:source": "cat-harness/processes/ui/harness-default-rendering.bpmn#A_Publish",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_harnessrendering.a_read",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Read a page or a card"
        }
      ],
      "skos:definition": [
        {
          "@value": "The floor of the interface: everything a harness publishes can be read with no account and no tool."
        }
      ],
      "skos:notation": "A_Read",
      "dcterms:source": "cat-harness/processes/ui/harness-default-rendering.bpmn#A_Read",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_harnessrendering.a_tiles",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Compose each harness's nav and tile"
        }
      ],
      "skos:definition": [
        {
          "@value": "One themed section per layer in dependency order, from its declaration: its docs, its declared subgraphs (a graph with no viewer is shown inert and labelled), and its theme. Written to `_data/harness.json` by `sync-docs-harness.ts`."
        }
      ],
      "skos:notation": "A_Tiles",
      "dcterms:source": "cat-harness/processes/ui/harness-default-rendering.bpmn#A_Tiles",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_harnessrendering.a_todo",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Leave it as feedback"
        }
      ],
      "skos:definition": [
        {
          "@value": "With no write tool the reader's point is not lost: it is recorded as feedback for someone who can write."
        }
      ],
      "skos:notation": "A_Todo",
      "dcterms:source": "cat-harness/processes/ui/harness-default-rendering.bpmn#A_Todo",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_humantranslation.task_appenddisclaimer",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Append WHO disclaimer (if DAK)"
        }
      ],
      "skos:definition": [
        {
          "@value": "For WHO SMART Guidelines content, automatically appends the WHO legal disclaimer: - Translation not created by WHO - English edition is authoritative original - WHO not responsible for translation accuracy Only applies when folio contentType includes WHO/DAK content."
        }
      ],
      "skos:notation": "Task_AppendDisclaimer",
      "dcterms:source": "cat-harness/library/processes/human-translation-workflow.bpmn#Task_AppendDisclaimer",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_humantranslation.task_assigntranslator",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Assign to qualified human translator"
        }
      ],
      "skos:definition": [
        {
          "@value": "The coordinator assigns the translation to a qualified translator, ideally a domain SME for the content area. For WHO content, the translator should be familiar with WHO SMART Guidelines terminology. The assignment includes: - The .pot file(s) from extraction - The domain glossary - Context notes (block kind, chapter, content area) - The deadline"
        }
      ],
      "skos:notation": "Task_AssignTranslator",
      "dcterms:source": "cat-harness/library/processes/human-translation-workflow.bpmn#Task_AssignTranslator",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_humantranslation.task_checkcompleteness",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Check translation completeness"
        }
      ],
      "skos:definition": [
        {
          "@value": "Verify that all msgid entries have msgstr translations. Partial translations are acceptable for initial submissions but must be flagged for follow-up. The coordinator checks: - % of strings translated - Any fuzzy-flagged entries - Missing critical sections"
        }
      ],
      "skos:notation": "Task_CheckCompleteness",
      "dcterms:source": "cat-harness/library/processes/human-translation-workflow.bpmn#Task_CheckCompleteness",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_humantranslation.task_extractpot",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Extract the POT"
        }
      ],
      "skos:notation": "Task_ExtractPOT",
      "dcterms:source": "cat-harness/library/processes/human-translation-workflow.bpmn#Task_ExtractPOT",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_humantranslation.task_identifycontent",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Identify content and target locale"
        }
      ],
      "skos:definition": [
        {
          "@value": "The coordinator selects: - Which content nodes need translation (block, section, chapter, or folio) - The target locale (one of the supportedLocales in <name>.config.json) - The priority and deadline"
        }
      ],
      "skos:notation": "Task_IdentifyContent",
      "dcterms:source": "cat-harness/library/processes/human-translation-workflow.bpmn#Task_IdentifyContent",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_humantranslation.task_injectpo",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Inject the PO"
        }
      ],
      "skos:notation": "Task_InjectPO",
      "dcterms:source": "cat-harness/library/processes/human-translation-workflow.bpmn#Task_InjectPO",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_humantranslation.task_prepareglossary",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Prepare domain glossary"
        }
      ],
      "skos:definition": [
        {
          "@value": "Builds the locale term base for the target locale from the layered glossaries, has it reviewed, and hands it to the translator with the POT. Each layer's glossary is the directory it declares with the `glossary` graph typology. Precedence, within one subject area (the scheme's `subject`): the more authoritative (lower) layer fixes a term's translation; a layer only adds, and may not give a fixed term a second translation. A match in another subject area is a sense check for the reviewer, not a violation. Previous translations of related content are evidence for a term with no fixed form, not a source that overrides one. A fixed translation is an authored term with a non-empty, non-fuzzy msgstr in its scheme's catalogue (translation-manager, \"The locale term base\")."
        }
      ],
      "skos:notation": "Task_PrepareGlossary",
      "dcterms:source": "cat-harness/library/processes/human-translation-workflow.bpmn#Task_PrepareGlossary",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_humantranslation.task_receiveassignment",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Receive assignment and materials"
        }
      ],
      "skos:definition": [
        {
          "@value": "The translator receives: - .pot file with source strings (msgid) - Domain glossary with approved term translations - Context notes per string - Style guide and WHO terminology references Tools: Poedit, Weblate, Crowdin, or direct .po editing."
        }
      ],
      "skos:notation": "Task_ReceiveAssignment",
      "dcterms:source": "cat-harness/library/processes/human-translation-workflow.bpmn#Task_ReceiveAssignment",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_humantranslation.task_requestmorework",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Request completion of remaining strings"
        }
      ],
      "skos:definition": [
        {
          "@value": "Return to the translator with a list of untranslated or fuzzy strings that need attention."
        }
      ],
      "skos:notation": "Task_RequestMoreWork",
      "dcterms:source": "cat-harness/library/processes/human-translation-workflow.bpmn#Task_RequestMoreWork",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_humantranslation.task_returnforcorrection",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Return for correction with annotations"
        }
      ],
      "skos:definition": [
        {
          "@value": "The reviewer annotates specific passages that need correction and returns to the translator with detailed feedback. Each annotation includes: - The passage in question - What is wrong (terminology, meaning, style) - The suggested correction or reference"
        }
      ],
      "skos:notation": "Task_ReturnForCorrection",
      "dcterms:source": "cat-harness/library/processes/human-translation-workflow.bpmn#Task_ReturnForCorrection",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_humantranslation.task_roundtripqa",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Round-trip translation QA"
        }
      ],
      "skos:definition": [
        {
          "@value": "No gateway follows: drift or clean, the translation goes to Task_SMEReview with the findings attached. Which of two readings is right is a human call (translation-manager, \"route drift to a human reviewer\"), and every translation in this workflow is reviewed and signed off anyway, so a clean result is evidence for the reviewer and never a way around them. The findings include `translation:glossary:check`'s: every glossary term translated against the locale term base, fixed before sign-off, with its glossary section in the KG QA report."
        }
      ],
      "skos:notation": "Task_RoundTripQA",
      "dcterms:source": "cat-harness/library/processes/human-translation-workflow.bpmn#Task_RoundTripQA",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_humantranslation.task_signoff",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Sign off translation as official"
        }
      ],
      "skos:definition": [
        {
          "@value": "The reviewer signs off the translation, making it official. This records: - signedOffBy: the reviewer's identity - signedOffAt: the current timestamp - sourceHash: SHA-256 of the source .md - level: block | section | chapter | folio Tool: translation_signoff MCP tool"
        }
      ],
      "skos:notation": "Task_Signoff",
      "dcterms:source": "cat-harness/library/processes/human-translation-workflow.bpmn#Task_Signoff",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_humantranslation.task_smereview",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review translation for accuracy"
        }
      ],
      "skos:definition": [
        {
          "@value": "A subject-matter expert reviews the injected translated markdown for: - Clinical/technical accuracy of terminology - Preservation of meaning from the source - Cultural appropriateness for the target locale - Consistency with the domain glossary For WHO content: the SME verifies that normative statements (\"SHALL\", \"SHOULD\", \"MAY\") are translated with the correct force in the target language."
        }
      ],
      "skos:notation": "Task_SMEReview",
      "dcterms:source": "cat-harness/library/processes/human-translation-workflow.bpmn#Task_SMEReview",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_humantranslation.task_submitpo",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Submit completed .po file"
        }
      ],
      "skos:definition": [
        {
          "@value": "The translator submits the completed .po file back to the pipeline. This may happen via: - Git commit + push - Weblate/Crowdin sync - File upload to the coordinator"
        }
      ],
      "skos:notation": "Task_SubmitPO",
      "dcterms:source": "cat-harness/library/processes/human-translation-workflow.bpmn#Task_SubmitPO",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_humantranslation.task_translateintool",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Translate strings in preferred tool"
        }
      ],
      "skos:definition": [
        {
          "@value": "The translator works through each msgid, producing msgstr translations. They: - Follow the domain glossary for technical terms - Preserve placeholder tokens ({1}, {2}) in position - Mark uncertain translations as #fuzzy - Note any source ambiguities for the coordinator"
        }
      ],
      "skos:notation": "Task_TranslateInTool",
      "dcterms:source": "cat-harness/library/processes/human-translation-workflow.bpmn#Task_TranslateInTool",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_humantranslation.task_writestatus",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Write status.json (official)"
        }
      ],
      "skos:notation": "Task_WriteStatus",
      "dcterms:source": "cat-harness/library/processes/human-translation-workflow.bpmn#Task_WriteStatus",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_ingestion.task_cataloguereference",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record it in library/ as referenced"
        }
      ],
      "skos:definition": [
        {
          "@value": "The referenced branch. Nothing is fetched and no bytes are written: the catalogue record says where the asset is and that we hold none. A reference is not a fetch — it stays navigable without being held, and materializing it later is `materialize-remote.bpmn`'s decision, with its purpose and five gates, not this flow's."
        }
      ],
      "skos:notation": "Task_CatalogueReference",
      "dcterms:source": "cat-harness/library/processes/document-ingestion.bpmn#Task_CatalogueReference",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_ingestion.task_extractmetadata",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Extract its metadata into the KG"
        }
      ],
      "skos:definition": [
        {
          "@value": "THE METADATA STEP. What enters the knowledge graph is the asset's INDEX — what it is, how big, what type, when it says it was written — and, for a container, what is in it; its contents do not go in unless somebody asks, with a reason. The tool is `cat-harness-tools/scripts/extract-assets.ts`, writing a `folio-extraction/v1` record (`schemas/content/extraction.ts`). The media type is sniffed from the leading bytes, never taken from the extension."
        }
      ],
      "skos:notation": "Task_ExtractMetadata",
      "dcterms:source": "cat-harness/library/processes/document-ingestion.bpmn#Task_ExtractMetadata",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_ingestion.task_place",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Place it in uploads/ by a declared route"
        }
      ],
      "skos:definition": [
        {
          "@value": "THE FIRST LINK: everything downstream of here takes a file that is already in the queue, so without this step how the file got there is governed by nothing. WHAT THIS STEP IS. The basic flow's ACCEPT step: choosing an arrival route, writing the bytes into the declared queue of the layer that will own them, and discharging what that route does not discharge for you. The routes, what each writer owes, and the two that are mechanisms against the one that is a persona are in the `upload-routes` skill; `upload-url` composes the forge URL for the web route from the declaration rather than from a literal, because a hand-written one can 404. WHY A PLAIN `bpmn:task` AND NOT A `userTask`. A `userTask` asserts a human performs it, and this lane is \"Contributor (human or agent)\" because both do; asserting human-only would be an `activity-fulfilment-kind` contradiction. A plain task asserts nothing about the performer. WHY THE BEAN OP IS `note` AND NOT `claim`. Placing a file claims nothing; it adds to a queue. What it owes the work plan is visibility. A note against the ingestion bean is what makes the queue's growth something another session can see."
        }
      ],
      "skos:notation": "Task_Place",
      "dcterms:source": "cat-harness/library/processes/document-ingestion.bpmn#Task_Place",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_ingestion.task_placeinlibrary",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Place the asset in library/<slug>/"
        }
      ],
      "skos:definition": [
        {
          "@value": "The materialized branch. The asset lands in library/<slug>/ with its metadata record, its provenance and its fixity. The folder name IS the citation key, so a citation and a directory are the same string. The upload is then RETIRED, not left and not deleted: it moves to fsh-guts/uploads/ beside a sidecar naming where it came from and when, and `check:uploads-retired` finds one that was not. A refining process that derives content from the bytes does so before that retirement; `library-ingestion` carries the rule."
        }
      ],
      "skos:notation": "Task_PlaceInLibrary",
      "dcterms:source": "cat-harness/library/processes/document-ingestion.bpmn#Task_PlaceInLibrary",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_ingesttheme.task_contradictions",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record contradictions IN the source"
        }
      ],
      "skos:definition": [
        {
          "@value": "A step because sources do contradict themselves (one colour given two values on different pages). A contradiction silently resolved is indistinguishable from one nobody noticed, so it is kept as data and the reading taken is stated as a choice."
        }
      ],
      "skos:notation": "Task_Contradictions",
      "dcterms:source": "cat-harness/processes/ui/ingest-theme.bpmn#Task_Contradictions",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_ingesttheme.task_maproles",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Map values onto palette roles"
        }
      ],
      "skos:definition": [
        {
          "@value": "surface / ink / edge / accent, shared across every kind. A palette per kind would be three spellings of \"accent colour\", free to disagree about what an accent IS. Where the source is SILENT on a role, say so and mark the value a choice rather than dressing an invention as a measurement."
        }
      ],
      "skos:notation": "Task_MapRoles",
      "dcterms:source": "cat-harness/processes/ui/ingest-theme.bpmn#Task_MapRoles",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_ingesttheme.task_readguide",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Read the guide's own stated rules"
        }
      ],
      "skos:definition": [
        {
          "@value": "From the INGESTED document's sections, not from a screenshot and not inferred from a site that happens to use the brand. Units stay as the source gives them: rewriting 29.7cm as millimetres is a conversion nobody asked for and a chance to be wrong."
        }
      ],
      "skos:notation": "Task_ReadGuide",
      "dcterms:source": "cat-harness/processes/ui/ingest-theme.bpmn#Task_ReadGuide",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_ingesttheme.task_readstylesheet",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Read the served stylesheet's declarations"
        }
      ],
      "skos:definition": [
        {
          "@value": "Read the ROLE, never the prettiest value. Bootstrap's --blue is a scale entry and --primary is the role; DSpace sets them differently, and taking the brand-looking one is the hardcoding schemas/ui/theme.ts exists to end. Column widths come from declared columns, never from breakpoints: a breakpoint is a viewport."
        }
      ],
      "skos:notation": "Task_ReadStylesheet",
      "dcterms:source": "cat-harness/processes/ui/ingest-theme.bpmn#Task_ReadStylesheet",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_ingesttheme.task_review",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Theme and UI review"
        }
      ],
      "skos:definition": [
        {
          "@value": "THEME REVIEW HAPPENS HERE AND NOWHERE ELSE: graphical assets are reviewed at ingestion, in the context of the website or app design they are for. So this step CALLS `theme-ui-review.bpmn`. WHAT THE CALL COSTS, stated rather than hidden. The subprocess has a human step, `R_Judge`: a person looks at the ingested assets laid out in their design at a web and a mobile width. So ingesting a THEME SOURCE is attended at that step. Ingesting anything else stays unattended: it never reaches this subprocess. THE AUTOMATED CHECK IS INSIDE THE CALL. \"A theme sets the stripe's hue; it never sets its width to zero\" — colour alone carrying a whole signal fails WCAG SC 1.4.1, and the WHO guide agrees (\"Never red with green, never blue with yellow\"). That check is `A_Accessibility` in the called process, which measures contrast against the real ground and requires a non-colour channel wherever colour carries meaning."
        }
      ],
      "skos:notation": "Task_Review",
      "dcterms:source": "cat-harness/processes/ui/ingest-theme.bpmn#Task_Review",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgseparation.call_authorise",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Authorise the extraction"
        }
      ],
      "skos:definition": [
        {
          "@value": "Report what moves and ask the administrator. A repository cut changes the substrate every other process binds to; that is a person's decision."
        }
      ],
      "skos:notation": "Call_Authorise",
      "dcterms:source": "cat-harness/processes/kg/kg-separation.bpmn#Call_Authorise",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgseparation.call_cutover",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Cut over"
        }
      ],
      "skos:definition": [
        {
          "@value": "Retire the parent's copy and measure the cutover until it is complete or cannot be shown complete."
        }
      ],
      "skos:notation": "Call_Cutover",
      "dcterms:source": "cat-harness/processes/kg/kg-separation.bpmn#Call_Cutover",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgseparation.call_move",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Move it into its repositories"
        }
      ],
      "skos:definition": [
        {
          "@value": "Create the repositories, drain, seed, consume additively, release, and check every identifier dereferences."
        }
      ],
      "skos:notation": "Call_Move",
      "dcterms:source": "cat-harness/processes/kg/kg-separation.bpmn#Call_Move",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgseparation.call_prepare",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Prepare it to stand alone"
        }
      ],
      "skos:definition": [
        {
          "@value": "Identity, hosted output, the content-tools split, the publication plan, and the standalone rehearsal."
        }
      ],
      "skos:notation": "Call_Prepare",
      "dcterms:source": "cat-harness/processes/kg/kg-separation.bpmn#Call_Prepare",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgseparation.task_brief",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Brief the work"
        }
      ],
      "skos:definition": [
        {
          "@value": "What the work is and why, what is already measured with its provenance, how it will be done, and what would falsify the approach. The work item is already taken up when the process starts, so a sibling session sees the work before the brief is written. Here the work is a separation: what is separating, and why."
        }
      ],
      "skos:notation": "Task_Brief",
      "dcterms:source": "cat-harness/processes/kg/kg-separation.bpmn#Task_Brief",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgseparation.task_decide",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Ask whether to separate it"
        }
      ],
      "skos:definition": [
        {
          "@value": "The owner decides from the measured signals, and also decides the address base for its identifiers, where verdicts about it live, and what its tools repository owns. Declining is a real outcome: the graph stays where it is."
        }
      ],
      "skos:notation": "Task_Decide",
      "dcterms:source": "cat-harness/processes/kg/kg-separation.bpmn#Task_Decide",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgseparation.task_detangle",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Declare, detangle, isolate"
        }
      ],
      "skos:definition": [
        {
          "@value": "The graph-detanglement practice, all of its gates: declared in place, zero wrong-direction edges on every axis, and standing alone with its own declaration, namespace and artefact. A plain task on purpose, not a call to graph-detanglement.bpmn: that process ends in its own authorise-and-extract steps, which here are stages 9-13 of this one, and calling it would run them twice."
        }
      ],
      "skos:notation": "Task_Detangle",
      "dcterms:source": "cat-harness/processes/kg/kg-separation.bpmn#Task_Detangle",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgseparation.task_measure",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Measure the signals"
        }
      ],
      "skos:definition": [
        {
          "@value": "Files and bytes per layer, clone cost (`bun run cat health`), gate time, merge contention, the candidate's cohesion and cut (`kg:detangle`), wrong-direction edges, and the would-be tools package's import cone. Recorded in the work context; none alone is a trigger."
        }
      ],
      "skos:notation": "Task_Measure",
      "dcterms:source": "cat-harness/processes/kg/kg-separation.bpmn#Task_Measure",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgseparationauthorise.task_authorise",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Ask to authorise the extraction"
        }
      ],
      "skos:definition": [
        {
          "@value": "A repository cut changes the substrate every other process binds to; that is a person's decision. Declining leaves the graph declared, detangled, isolated and split in place."
        }
      ],
      "skos:notation": "Task_Authorise",
      "dcterms:source": "cat-harness/processes/kg/kg-separation-authorise.bpmn#Task_Authorise",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgseparationauthorise.task_propose",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Report what moves — sizes, what breaks"
        }
      ],
      "skos:definition": [
        {
          "@value": "The agent reports and waits: what would move, how large, what in the parent breaks, and the rollback. `deletion-requires-confirmation` is not a courtesy to waive: an agent never removes or relocates a durable artefact on its own initiative."
        }
      ],
      "skos:notation": "Task_Propose",
      "dcterms:source": "cat-harness/processes/kg/kg-separation-authorise.bpmn#Task_Propose",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgseparationcutover.task_cutover",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Cutover: retire the parent's copy"
        }
      ],
      "skos:definition": [
        {
          "@value": "The one commit worth reverting, made only after the parent consumes the release and every identifier dereferences. It retires the parent's copy, frozen, never refreshed and never rendered, rather than deleting it. Where the copy goes is the sub-kg-lifecycle skill's stage 13; this diagram does not name that store, because the published graph must not."
        }
      ],
      "skos:notation": "Task_Cutover",
      "dcterms:source": "cat-harness/processes/kg/kg-separation-cutover.bpmn#Task_Cutover",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgseparationcutover.task_cutovercheck",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Measure the cutover: separation:cutover:check"
        }
      ],
      "skos:definition": [
        {
          "@value": "Run `bun run cat separation:cutover:check --site` in the SEPARATED repository (Tool `separation-cutover-check`). Six conditions, each decided by an existing gate and none assumed: every declared layer mounted at its pin; every path a declaration names resolves (`check:declaration-resolution` — directories, assets, visualisers, needs); no wiring still names the monorepo (`livesAt`, a submodule, a reusable workflow, a path into the old checkout); no import or reference against the layer order; and the site builds from the mounts alone. A finding inside a mounted layer is upstream's and is listed, not counted."
        }
      ],
      "skos:notation": "Task_CutoverCheck",
      "dcterms:source": "cat-harness/processes/kg/kg-separation-cutover.bpmn#Task_CutoverCheck",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgseparationmove.task_consume",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Parent consumes, additively"
        }
      ],
      "skos:definition": [
        {
          "@value": "The parent pins the pair (a commit while staging, a version once released) — a code dependency as a `source.remote` instance in its root `index.config.json` (remote-mount skill), never a submodule — repoints its imports, and keeps its own copy until it is green with the dependency declared. Where `cat-harness.sdlc` is switched on, this step is the opt-in process `upstream-version-adoption` (`Process_UpstreamAdoption`, sdlc/processes/upstream-version-adoption.bpmn); it is not called from here, because a layer without that sub-graph does not have it (owner card Q-OPTIN-CALLS A, 2026-11-12)."
        }
      ],
      "skos:notation": "Task_Consume",
      "dcterms:source": "cat-harness/processes/kg/kg-separation-move.bpmn#Task_Consume",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgseparationmove.task_create",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Create the repositories"
        }
      ],
      "skos:definition": [
        {
          "@value": "The owner creates the content and tools repositories and their Pages. Nothing is committed to them before this."
        }
      ],
      "skos:notation": "Task_Create",
      "dcterms:source": "cat-harness/processes/kg/kg-separation-move.bpmn#Task_Create",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgseparationmove.task_drain",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Drain: land, close or re-target the open PRs"
        }
      ],
      "skos:definition": [
        {
          "@value": "Work the PRs `seed:ready` named until the source settles: land or close the heavy movers and the next layer's PRs, bring the layer's open PRs to five or fewer, and finish any move in flight. Fix a red rehearsal or a discovery miss where it is. Nothing is seeded from here; it goes back to the gateway, which re-asks."
        }
      ],
      "skos:notation": "Task_Drain",
      "dcterms:source": "cat-harness/processes/kg/kg-separation-move.bpmn#Task_Drain",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgseparationmove.task_freshclone",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Verify on a fresh clone"
        }
      ],
      "skos:definition": [
        {
          "@value": "`bun run cat sub-kg:verify-clone --repo <owner>/<name> --ref <branch>` (Tool sub-kg-verify-clone): clone into an empty scratch directory with submodules and any sibling it needs, install, and run its own gates. Green, red or unknown, and unknown is never green. Nothing in a seed runs standalone until the seam is re-pointed, so a missing module shows here."
        }
      ],
      "skos:notation": "Task_FreshClone",
      "dcterms:source": "cat-harness/processes/kg/kg-separation-move.bpmn#Task_FreshClone",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgseparationmove.task_release",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "First release"
        }
      ],
      "skos:definition": [
        {
          "@value": "Tag each repository, publish /v<major>/. From here the two are versioned independently; a tools release lists the content majors it supports."
        }
      ],
      "skos:notation": "Task_Release",
      "dcterms:source": "cat-harness/processes/kg/kg-separation-move.bpmn#Task_Release",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgseparationmove.task_repoint",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Re-point: livesAt, seam, mount or subscription"
        }
      ],
      "skos:definition": [
        {
          "@value": "In the new repository `livesAt` goes (absent means it sits at the root of `repository`) and `platform.ts` points at where the platform now is. The host consumes it as a remote mount (a `source.remote` instance in its root `index.config.json`) if it imports its code, or a subscription if it only reads its content, pinned to a commit while staging. Additive: the host keeps its copy."
        }
      ],
      "skos:notation": "Task_Repoint",
      "dcterms:source": "cat-harness/processes/kg/kg-separation-move.bpmn#Task_Repoint",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgseparationmove.task_seed",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Seed both repositories"
        }
      ],
      "skos:definition": [
        {
          "@value": "Seed main, then bring the content and the tools in as reviewed pull requests with their history, so neither repository's first commit is unreviewable. The seed includes every publisher the declaration promises (`sub-kg-lifecycle` stage 10): a `qa` directory with `storage` needs `.github/workflows/publish-qa.yml`, the caller of the tools layer's `layer-qa-publish.yml`, and `test/results/` ignored. Without it the declared store is never written, and once the layer stops committing its results no reader finds them."
        }
      ],
      "skos:notation": "Task_Seed",
      "dcterms:source": "cat-harness/processes/kg/kg-separation-move.bpmn#Task_Seed",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgseparationmove.task_verify",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Every identifier dereferences"
        }
      ],
      "skos:definition": [
        {
          "@value": "After the release is live, every published identifier resolves to the file it names. Where `cat-harness.sdlc` is switched on, this step is the opt-in process `publish-verification` (`Process_PublishVerification`, sdlc/processes/publish-verification.bpmn); it is not called from here, because a layer without that sub-graph does not have it (owner card Q-OPTIN-CALLS A, 2026-11-12)."
        }
      ],
      "skos:notation": "Task_Verify",
      "dcterms:source": "cat-harness/processes/kg/kg-separation-move.bpmn#Task_Verify",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgseparationprepare.task_hosted",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Move harness output about it to the host"
        }
      ],
      "skos:definition": [
        {
          "@value": "QA verdicts, translation templates, the exported graph and the glossary ledger are harness output ABOUT the graph: they live with the harness (kgQaHomeFor, translationsHomeFor). The content keeps only what its own checks need; the leak test's pending list is empty. The one exception is a separated layer that declares a `qa` directory of its own with `storage`: its verdicts are its own repository's, published to that repository's qa-reports branch (step 10), and read by a host at the commit it pins."
        }
      ],
      "skos:notation": "Task_Hosted",
      "dcterms:source": "cat-harness/processes/kg/kg-separation-prepare.bpmn#Task_Hosted",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgseparationprepare.task_identity",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Identity: version, iriBase, nodeSchemas"
        }
      ],
      "skos:definition": [
        {
          "@value": "The declaration carries name, version, iriBase, needs and nodeSchemas. A base move is `bun run iri:sync -- --from <old base>`, once; then `iri:sync:check` and `check:node-iris` are green."
        }
      ],
      "skos:notation": "Task_Identity",
      "dcterms:source": "cat-harness/processes/kg/kg-separation-prepare.bpmn#Task_Identity",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgseparationprepare.task_plan",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Plan publication"
        }
      ],
      "skos:definition": [
        {
          "@value": "Every identifier the content mints is a file some step publishes: /v<major>/, for what programs read and pages people read alike; the exact release is the pin's. Name collisions between published files are resolved here."
        }
      ],
      "skos:notation": "Task_Plan",
      "dcterms:source": "cat-harness/processes/kg/kg-separation-prepare.bpmn#Task_Plan",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgseparationprepare.task_rehearse",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Rehearse standalone"
        }
      ],
      "skos:definition": [
        {
          "@value": "Copy the content and the tools alone into a temporary directory, with nothing else on the path, and run the tools' checks there. An empty tree must exit non-zero, so a rehearsal over nothing cannot pass."
        }
      ],
      "skos:notation": "Task_Rehearse",
      "dcterms:source": "cat-harness/processes/kg/kg-separation-prepare.bpmn#Task_Rehearse",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgseparationprepare.task_split",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Split content from tools"
        }
      ],
      "skos:definition": [
        {
          "@value": "Create <name>-tools as a sibling directory and move the code: the Zod source, the generators, the README and diagram writers, the content checks. Cut its import cone to its own files and declared packages. Both start at the content's version."
        }
      ],
      "skos:notation": "Task_Split",
      "dcterms:source": "cat-harness/processes/kg/kg-separation-prepare.bpmn#Task_Split",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgtoportal.a_distribute",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Publish to the origin (a cache may front it)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Reach host behaviour through publication.host, never by assuming GitHub Pages' behaviour — Pages CANNOT serve application/ld+json and a local server can. A CDN in front is a layer, not the host: the canonical URL stays the origin's, and the cache is an accelerated route to the same bytes. Uploading and exposing are separable steps on purpose, because collapsing them removes the last moment at which a bad URL layout can still be caught."
        }
      ],
      "skos:notation": "A_Distribute",
      "dcterms:source": "cat-harness/processes/kg/kg-to-portal.bpmn#A_Distribute",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgtoportal.a_package",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Package with digests"
        }
      ],
      "skos:definition": [
        {
          "@value": "The serialization alone is not a package. A package is an addressable set — the JSON-LD, the assets it references, and a manifest naming every file with its digest and byte count. The manifest is what makes a REMOVED file detectable, which a per-file signature cannot do on its own."
        }
      ],
      "skos:notation": "A_Package",
      "dcterms:source": "cat-harness/processes/kg/kg-to-portal.bpmn#A_Package",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgtoportal.a_select",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Cut the subgraph that leaves"
        }
      ],
      "skos:definition": [
        {
          "@value": "Apply the editorial scope mechanically and report what it removed. A selection that reports nothing cannot be told from one that ran over an empty rule."
        }
      ],
      "skos:notation": "A_Select",
      "dcterms:source": "cat-harness/processes/kg/kg-to-portal.bpmn#A_Select",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgtoportal.a_serialize",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Serialize to JSON-LD"
        }
      ],
      "skos:definition": [
        {
          "@value": "kg-export, already built and host-agnostic by design. Every edge term declared {\"@type\": \"@id\"} — without that coercion the document is a list of records that merely LOOKS linked, and the node IRIs are fragments of the document's own @id so the graph is mergeable with anyone else's."
        }
      ],
      "skos:notation": "A_Serialize",
      "dcterms:source": "cat-harness/processes/kg/kg-to-portal.bpmn#A_Serialize",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgtoportal.d_constraints",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "State the constraints, with denominators"
        }
      ],
      "skos:definition": [
        {
          "@value": "Money, network traffic, graph size, latency. Each needs a NUMBER and each number needs a denominator, because a constraint with no denominator is a preference: \"the graph is too big\" is not a finding, \"6.2 MB per publication against a 100 GB free tier\" is. Say which figures were measured, which were quoted from a vendor, and which could not be obtained; a figure from a chat message is none of the three."
        }
      ],
      "skos:notation": "D_Constraints",
      "dcterms:source": "cat-harness/processes/kg/kg-to-portal.bpmn#D_Constraints",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgtoportal.d_undetermined",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record the decision as still open"
        }
      ],
      "skos:definition": [
        {
          "@value": "An undetermined decision is DATA, not silence. It is recorded with what it waits on and what would settle it, so the next session can tell \"nobody has chosen\" from \"somebody chose and did not write it down\" — the same third state bean-blocking keeps for a block with no expiry."
        }
      ],
      "skos:notation": "D_Undetermined",
      "dcterms:source": "cat-harness/processes/kg/kg-to-portal.bpmn#D_Undetermined",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgtoportal.e_humaneyes",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Human eyes on the rendered artefact"
        }
      ],
      "skos:definition": [
        {
          "@value": "Easy to drop because merging to main looks like an approval. It is not: merging approves the CHANGE, and this approves what a reader will actually see. A description cannot stand in for it (`continual-progress`)."
        }
      ],
      "skos:notation": "E_HumanEyes",
      "dcterms:source": "cat-harness/processes/kg/kg-to-portal.bpmn#E_HumanEyes",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgtoportal.e_scope",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Decide what may leave the repository"
        }
      ],
      "skos:definition": [
        {
          "@value": "EDITORIAL, and it is stage 1 rather than a filter bolted to the exporter. kg-export produces the WHOLE graph because inspection wants the whole graph; a portal wants what its readers may see. Running the second as the first is how a QA verdict, a bean's blocking note or an unpublished draft reaches a public cache. Decided once, here, rather than at each consumer."
        }
      ],
      "skos:notation": "E_Scope",
      "dcterms:source": "cat-harness/processes/kg/kg-to-portal.bpmn#E_Scope",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgtoportal.p_verify",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Verify what arrived against what was signed"
        }
      ],
      "skos:definition": [
        {
          "@value": "Against a GDHCN DID trustlist, which means the verifier needs THE NETWORK and not only the bytes — the key is resolved from the trustlist rather than read out of the package. The trustlist is itself static JSON served from a CDN (`tng-cdn.who.int`), and its path is a hierarchical filter — domain, participant, key usage, with `-` as a wildcard — so a verifier fetches the slice it needs rather than the whole list. The stage that gets dropped, because every other stage produces something visible and this one produces nothing when it passes. A package that is signed and never verified is a package whose signature is decoration. A portal that CANNOT verify reports `unknown` — a portal nobody asked is not a portal that checked."
        }
      ],
      "skos:notation": "P_Verify",
      "dcterms:source": "cat-harness/processes/kg/kg-to-portal.bpmn#P_Verify",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgtoportal.s_sign",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Sign the package and/or each asset"
        }
      ],
      "skos:definition": [
        {
          "@value": "THE TRUST ANCHOR IS GDHCN, SPECIFIED BY THE WHO SMART TRUST IG. READ OFF THAT IG rather than from general knowledge: a GDHCN trustlist distributes KEY MATERIAL as W3C DID documents, and says nothing about what you wrap your bytes in — the health-certificate envelope is a separate specification in the same IG, and a document package is not a health certificate. So what is settled is where a verifier GETS THE KEY, not what it verifies. A portal that can fetch the bytes but not reach the trustlist cannot verify, which is `unknown` and not a failure — air-gapped is a declared deployment value, so that case is answered rather than assumed away. Still OPEN and unread: the rotation and revocation model, and whether a document-package signature can be expressed for a GDHCN-aware verifier at all. Two schemes with different properties remain to choose between, and the trustlist does not choose between them. A PACKAGE signature over the manifest verifies the SET — nothing added, removed or altered — and must be reissued whenever any file changes. A PER-ASSET signature verifies one file independently, which is what an edge cache serving one asset can actually check, and it cannot detect a removal because there is nothing left to verify. They compose; composing them is the safer and more expensive default, and it is the deployment's choice rather than the pipeline's."
        }
      ],
      "skos:notation": "S_Sign",
      "dcterms:source": "cat-harness/processes/kg/kg-to-portal.bpmn#S_Sign",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_materializeremote.task_answergates",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Answer the other four gates"
        }
      ],
      "skos:definition": [
        {
          "@value": "Restrictions, copyright, retention and source loss, each answered permitted, refused or unknown. They are four answers to one decision, and Gateway_Gates reads them with size through decisions/materialization-gate.dmn. RESTRICTIONS. 'No restrictions known in context' is a STATE, not a green light. GateVerdict is three-valued for this reason alone, and `unknown` is never rendered as `permitted`. COPYRIGHT. What the licence permits for THIS bitstream, and separately whether it permits the derivation. LICENSE-CONTENT.md exists in this repository and the ingestion pipeline does not read it. RETENTION. A copy with no expiry cannot be told from an abandoned one — the same argument bean-blocking makes about a block with no expiry. An ARCHIVAL copy is the exception and it is a specification rather than an omission: freshness() reports it `permanent`, not `no-expiry`. SOURCE LOSS. Not hypothetical. The one IRIS record this repository holds carries a handle on iris.wpro.who.int, a regional instance merged into the global one. Only an ARCHIVAL copy of the original bytes discharges this; a working copy cannot, because the derived sections are not the publication."
        }
      ],
      "skos:notation": "Task_AnswerGates",
      "dcterms:source": "cat-harness/library/processes/materialize-remote.bpmn#Task_AnswerGates",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_materializeremote.task_declare",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Declare the node materialized"
        }
      ],
      "skos:definition": [
        {
          "@value": "The node's state moves from `referenced` to `materialized`, carrying purpose, localPath, gates and (archival) fixity. There is NO default state: a node that has not said is invalid, because 'the author did not say' and 'the author said they could not tell' are different facts."
        }
      ],
      "skos:notation": "Task_Declare",
      "dcterms:source": "cat-harness/library/processes/materialize-remote.bpmn#Task_Declare",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_materializeremote.task_enumerate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Enumerate the source descriptor"
        }
      ],
      "skos:definition": [
        {
          "@value": "Resolve the request against the source's descriptor (one per corpus, in the declared sources/ of the layer that owns it, e.g. who-iris/sources/), read against cat-harness/schemas/library/source-descriptor.ts BEFORE any gate. Three things come from it and none may be guessed. (1) Which subset strategies the source supports — supportsSubset(). (2) Whether a subset stands on its own: when subsetIsSelfContained is false (mathlib), the request is closed over its dependencies here, and every gate after this one is asked about the CLOSURE, because a subset that omits what its members depend on is not a smaller corpus, it is one that does not build. (3) What enumerating the whole costs — enumerationCost(), which is undefined when the descriptor has no measured denominator; SIZE then refuses rather than estimates. A source with no descriptor is not an error here: it is an unknown, and SIZE refuses on it. The descriptor is CALLED here rather than restated."
        }
      ],
      "skos:notation": "Task_Enumerate",
      "dcterms:source": "cat-harness/library/processes/materialize-remote.bpmn#Task_Enumerate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_materializeremote.task_fetch",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Fetch, and record fixity"
        }
      ],
      "skos:definition": [
        {
          "@value": "Fetch, then record sha256 and byte count. Fixity is REQUIRED for an archival copy: an archive that cannot demonstrate it is unchanged is a copy, and it cannot be re-fetched to check, because the thing it would be re-fetched from is what it exists to survive. The data already exists — every structure.json carries sha256 and bytes, and nothing reads them as fixity."
        }
      ],
      "skos:notation": "Task_Fetch",
      "dcterms:source": "cat-harness/library/processes/materialize-remote.bpmn#Task_Fetch",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_materializeremote.task_purpose",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Declare the purpose: working or archival"
        }
      ],
      "skos:definition": [
        {
          "@value": "working or archival, and it is asked FIRST because three of the five gates mean different things under each. An archival copy keeps the original bytes, never expires, requires fixity, and is the only thing that discharges sourceLoss; a working copy keeps derived content and discharges none of that. A process that gated first and asked afterwards would be judging a copy whose obligations it did not yet know."
        }
      ],
      "skos:notation": "Task_Purpose",
      "dcterms:source": "cat-harness/library/processes/materialize-remote.bpmn#Task_Purpose",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_materializeremote.task_size",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Size the take and the whole"
        }
      ],
      "skos:definition": [
        {
          "@value": "What is being taken, and what the whole collection would cost. REFUSES when it cannot tell: 'three items' with no denominator is not a size answer. 0.7 TB is the measured reason the IRIS import is by reference."
        }
      ],
      "skos:notation": "Task_Size",
      "dcterms:source": "cat-harness/library/processes/materialize-remote.bpmn#Task_Size",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_materializeremote.task_stayref",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Leave it referenced, record why"
        }
      ],
      "skos:definition": [
        {
          "@value": "A refusal is not a failure of the process — it is the process working. The node stays `referenced`, which means the graph still knows it exists and where, and the refusing gate's basis is recorded so the next caller does not re-litigate it."
        }
      ],
      "skos:notation": "Task_StayRef",
      "dcterms:source": "cat-harness/library/processes/materialize-remote.bpmn#Task_StayRef",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_methodologyfromsource.a_integrate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Integrate: call existing processes"
        }
      ],
      "skos:definition": [
        {
          "@value": "The method's steps become a process whose judgement points call the processes that already exist (adjudication, options analysis, review) by calledElement. Nothing is re-implemented. A needed change to an existing process becomes a bean against its owner."
        }
      ],
      "skos:notation": "A_Integrate",
      "dcterms:source": "cat-harness/library/processes/methodology-from-source.bpmn#A_Integrate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_methodologyfromsource.a_origin",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Establish origin and licence"
        }
      ],
      "skos:definition": [
        {
          "@value": "Authors, publication, identifier, and the licence the source itself states. No stated licence means reference only: headings, page ranges and a summary in our own words; the file stays in uploads/ (git-ignored) pinned by checksum. A method with no origin is a house process; write a skill instead."
        }
      ],
      "skos:notation": "A_Origin",
      "dcterms:source": "cat-harness/library/processes/methodology-from-source.bpmn#A_Origin",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_methodologyfromsource.a_place",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Place by ownership; declare the directory"
        }
      ],
      "skos:definition": [
        {
          "@value": "A domain-neutral method belongs to the harness and a domain method to the folio that owns the domain. If the session cannot write where it belongs, draft it where it can, say so in the file, and open a bean to move it."
        }
      ],
      "skos:notation": "A_Place",
      "dcterms:source": "cat-harness/library/processes/methodology-from-source.bpmn#A_Place",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_methodologyfromsource.a_render",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Render the method: adopted vs refused"
        }
      ],
      "skos:definition": [
        {
          "@value": "What the source says, section by section, then a table of what this platform adopts and what it refuses, each with a reason. Extensions beyond the source (such as web plus mobile where the paper studied mobile) are stated as ours. Reported results are not imported as facts."
        }
      ],
      "skos:notation": "A_Render",
      "dcterms:source": "cat-harness/library/processes/methodology-from-source.bpmn#A_Render",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_methodologyfromsource.a_tools",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Every skill and tool used becomes a Tool"
        }
      ],
      "skos:definition": [
        {
          "@value": "Each script, CLI or checker the process relies on gets a Tool node (`tools/<id>/<id>.json`) that satisfies a named skill, validated by folio-assistant's ToolDefinitionSchema."
        }
      ],
      "skos:notation": "A_Tools",
      "dcterms:source": "cat-harness/library/processes/methodology-from-source.bpmn#A_Tools",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_methodologyfromsource.call_ingest",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Ingest into library/"
        }
      ],
      "skos:definition": [
        {
          "@value": "The harness's basic ingestion flow (`document-ingestion.bpmn`, `Process_Ingestion`): the source is accepted, its metadata goes into the KG, and it is catalogued in library/ — held if materialized, recorded as referenced if not. The flow makes no content-type decision: reading a document into sections and blocks — choosing the rung mechanically (embedded outline, pages, OCR), and writing section text only when the licence allows it — is a refinement in the layer above, which calls this same flow first."
        }
      ],
      "skos:notation": "Call_Ingest",
      "dcterms:source": "cat-harness/library/processes/methodology-from-source.bpmn#Call_Ingest",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_methodologyfromsource.call_relatedwork",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Related work: find, sort, ask"
        }
      ],
      "skos:definition": [
        {
          "@value": "Search beans, issues and open PRs for work the method touches, categorize and summarize them, and ask the owner whether and how to coordinate. CRDM calls the same sub-process."
        }
      ],
      "skos:notation": "Call_RelatedWork",
      "dcterms:source": "cat-harness/library/processes/methodology-from-source.bpmn#Call_RelatedWork",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_methodologyfromsource.o_review",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review the adoption"
        }
      ],
      "skos:notation": "O_Review",
      "dcterms:source": "cat-harness/library/processes/methodology-from-source.bpmn#O_Review",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mountdependency.task_checkagainstlock",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Check disk against lock against declaration"
        }
      ],
      "skos:definition": [
        {
          "@value": "`mount:remote:check`, with no network: the lock's pins are the declaration's, and every locked directory is on disk and hashes to its digest. Could-not-determine outranks missing, which outranks mounted."
        }
      ],
      "skos:notation": "Task_CheckAgainstLock",
      "dcterms:source": "cat-harness/processes/kg/mount-dependency.bpmn#Task_CheckAgainstLock",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mountdependency.task_declaremount",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Declare the mount: harness, repository, pin"
        }
      ],
      "skos:definition": [
        {
          "@value": "A layer `{ name, source: { remote: { repository, ref } } }` in the downstream's root `index.config.json`, written through `writeDeclaredMounts`. A folio with no index still reads `remoteMounts` on its declaration; both at once is refused. `ref` is a full 40-character commit. Overrides, if any, are keyed by layer name and then by directory id — never by path. The index itself is the index-config skill's. Decide first whether you want a remote mount at all: reading another graph without holding its code is a SUBSCRIPTION, not a mount."
        }
      ],
      "skos:notation": "Task_DeclareMount",
      "dcterms:source": "cat-harness/processes/kg/mount-dependency.bpmn#Task_DeclareMount",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mountdependency.task_mountinstances",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Mount each layer at its declared path"
        }
      ],
      "skos:definition": [
        {
          "@value": "Sparse checkout of the declaration and the chosen directories, copied to the mount path (by default the layer's home path, so relative imports and sibling discovery hold). Never onto tracked bytes; never onto a directory no lock says this mount made; never over edits to a previous mount — those are left untouched and reported. A replay of the lock tries the index's layers cache ref first (`refs/cat/layers/<key>`, then `refs/cat/layers/main`): one shallow fetch, every byte verified against the lock, and any layer that does not verify is fetched from its own repository."
        }
      ],
      "skos:notation": "Task_MountInstances",
      "dcterms:source": "cat-harness/processes/kg/mount-dependency.bpmn#Task_MountInstances",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mountdependency.task_renderagentsurface",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Re-render the agent surface"
        }
      ],
      "skos:definition": [
        {
          "@value": "When the lock changed, the layers an agent's skills and memory are generated from changed with it. `mount:remote` re-runs the generators of what an agent actually reads — `skill:commands` (`.claude/commands/`) and `agent-memory` (`.claude/agent-memory/` and the `.agents/` copies) — from the checkout root, and a generator that fails fails the run. A re-pin commit therefore carries the new layers AND the surface rendered from them, because new layers shipped without their rendered surface fail the agent-memory tests."
        }
      ],
      "skos:notation": "Task_RenderAgentSurface",
      "dcterms:source": "cat-harness/processes/kg/mount-dependency.bpmn#Task_RenderAgentSurface",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mountdependency.task_resolveclosure",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Resolve the closure at the pin"
        }
      ],
      "skos:definition": [
        {
          "@value": "Fetch the pinned tree (shallow, blobless). Read the harness's declaration from it; for each `needs` name, find that layer in the same tree, else follow a GITLINK at that tree as a pin into its own repository. A need found in neither is missing; one the downstream already holds is local. Paths and directories come from `mountDefaults` unless overridden."
        }
      ],
      "skos:notation": "Task_ResolveClosure",
      "dcterms:source": "cat-harness/processes/kg/mount-dependency.bpmn#Task_ResolveClosure",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mountdependency.task_writelock",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Write the lock"
        }
      ],
      "skos:definition": [
        {
          "@value": "`index.lock.json` beside the downstream's `index.config.json` (the legacy `<instance>.mount-lock.json` is still read, and is renamed onto the new name when rewritten; both present is an error): the pins it was written for, each layer's repository, SHA and how the pin was found, each directory's tree digest — and what was NOT mounted, with why, so an offline check cannot read a gap as clean. Whoever writes the lock writes its layers cache ref (`layers:publish`, which refuses unless every mount hashes to the lock); on main, the index's workflow does it."
        }
      ],
      "skos:notation": "Task_WriteLock",
      "dcterms:source": "cat-harness/processes/kg/mount-dependency.bpmn#Task_WriteLock",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mountsubgraph.task_mountbranchtip",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Mount the branch tip at the declared path"
        }
      ],
      "skos:definition": [
        {
          "@value": "A `branch` source keyed by `tip`: `branch-store mount --id <dir-id>` writes the tip's files at the declared path, so every reader finds the directory where it always was; `push` splices edits back onto the tip, never forcing, and a same-file race is a conflict. The branch's NAME is the declaring directory's `storage` (or `source`) — a branch no declaration names is refused rather than guessed. A `commit`-keyed branch is read per commit through its own store (`qa-store`), not mounted."
        }
      ],
      "skos:notation": "Task_MountBranchTip",
      "dcterms:source": "cat-harness/processes/kg/mount-subgraph.bpmn#Task_MountBranchTip",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mountsubgraph.task_mountremotepin",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Mount the remote tree at its pin"
        }
      ],
      "skos:definition": [
        {
          "@value": "A `remote` source: another repository's tree at a full 40-character commit. `bun run cat mount:remote` lays it down at the declared path and locks its tree digest; it is never written back, because the bytes are somebody else's at somebody else's pin. Usually reached through a `source.remote` layer in the root `index.config.json` (legacy: `remoteMounts`), which expands a whole harness and its closure — `Process_MountDependency`."
        }
      ],
      "skos:notation": "Task_MountRemotePin",
      "dcterms:source": "cat-harness/processes/kg/mount-subgraph.bpmn#Task_MountRemotePin",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mountsubgraph.task_refuseunknownkind",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Refuse: no flow for this source kind"
        }
      ],
      "skos:definition": [
        {
          "@value": "A kind added to the union (a graph database, say) before this diagram and the mount tool learn it. Refused with its own exit code — reading it as a directory would scan an empty path and report it clean."
        }
      ],
      "skos:notation": "Task_RefuseUnknownKind",
      "dcterms:source": "cat-harness/processes/kg/mount-subgraph.bpmn#Task_RefuseUnknownKind",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mountsubgraph.task_resolvesource",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Resolve the subgraph's content source"
        }
      ],
      "skos:definition": [
        {
          "@value": "`declaredSubgraph(start, id)`: the declaring layer, the entry, and the resolved source with `declaredIn` saying which layer answered. Never read `source` off the declaration directly — the config override and the legacy `storage` field are folded in by the resolver and nowhere else. A contradiction (both `source` and `storage`; a `qa` subgraph keyed by tip) throws here, before anything is mounted."
        }
      ],
      "skos:notation": "Task_ResolveSource",
      "dcterms:source": "cat-harness/processes/kg/mount-subgraph.bpmn#Task_ResolveSource",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mountsubgraph.task_retrievenpmpackage",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Retrieve the npm package or tarball"
        }
      ],
      "skos:definition": [
        {
          "@value": "An `npm` source (`schemas/kg/subgraph-source.ts`, `npm-kg-distribution`): an npm package specifier or tarball path (`.tgz`). `kg-retrieve-npm` or `npm` fetches and unpacks the package contents into the declared path."
        }
      ],
      "skos:notation": "Task_RetrieveNpmPackage",
      "dcterms:source": "cat-harness/processes/kg/mount-subgraph.bpmn#Task_RetrieveNpmPackage",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mountsubgraph.task_usecheckoutpath",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Use the checkout path in place"
        }
      ],
      "skos:definition": [
        {
          "@value": "A `directory` source IS its declared path. Nothing is mounted; a write is an ordinary commit on the working branch, which is why `branch-store push` answers \"commit through git\" for it rather than pushing anything."
        }
      ],
      "skos:notation": "Task_UseCheckoutPath",
      "dcterms:source": "cat-harness/processes/kg/mount-subgraph.bpmn#Task_UseCheckoutPath",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_multilocaletranslation.call_ml_roundtrip",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Untainted round trip on a sample"
        }
      ],
      "skos:definition": [
        {
          "@value": "The sample: every diagram label, the personas and scenarios, and a seeded random fraction of the rest."
        }
      ],
      "skos:notation": "Call_ML_RoundTrip",
      "dcterms:source": "cat-harness/library/processes/multi-locale-translation.bpmn#Call_ML_RoundTrip",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_multilocaletranslation.task_ml_extract",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Extract every template once"
        }
      ],
      "skos:definition": [
        {
          "@value": "Once, for every locale: the `.pot` templates for the pages, the diagrams (`translate-bpmn --extract`) and the glossary schemes, each by the layer's own extractor. A locale that would need a different template is a defect in the extraction, not a reason to extract again."
        }
      ],
      "skos:notation": "Task_ML_Extract",
      "dcterms:source": "cat-harness/library/processes/multi-locale-translation.bpmn#Task_ML_Extract",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_multilocaletranslation.task_ml_fixdrift",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Fix each drift on the PR"
        }
      ],
      "skos:definition": [
        {
          "@value": "Correct each string the adjudicator ruled drift, on the locale PR, and note the fix beside the ruling in the QA report."
        }
      ],
      "skos:notation": "Task_ML_FixDrift",
      "dcterms:source": "cat-harness/library/processes/multi-locale-translation.bpmn#Task_ML_FixDrift",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_multilocaletranslation.task_ml_gates",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Run the deterministic gates"
        }
      ],
      "skos:definition": [
        {
          "@value": "Template currency, catalogue coverage, placeholder, tag and URL preservation, officiality, `kg:locale`, and the locale's supplements compiling with no SUSHI error and passing their structural checks."
        }
      ],
      "skos:notation": "Task_ML_Gates",
      "dcterms:source": "cat-harness/library/processes/multi-locale-translation.bpmn#Task_ML_Gates",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_multilocaletranslation.task_ml_glossary",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Check glossary consistency"
        }
      ],
      "skos:definition": [
        {
          "@value": "`translation:glossary:check`, against the layered term base: the normative reference glossaries first, then each layer in the order the index config lists it, the layer's own glossary last and never overriding. A platform term found in text of another subject area is a sense check for a person, not a violation."
        }
      ],
      "skos:notation": "Task_ML_Glossary",
      "dcterms:source": "cat-harness/library/processes/multi-locale-translation.bpmn#Task_ML_Glossary",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_multilocaletranslation.task_ml_localepr",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Open the locale PR to main"
        }
      ],
      "skos:definition": [
        {
          "@value": "One PR per locale, based on and targeting main. Never into the source branch."
        }
      ],
      "skos:notation": "Task_ML_LocalePR",
      "dcterms:source": "cat-harness/library/processes/multi-locale-translation.bpmn#Task_ML_LocalePR",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_multilocaletranslation.task_ml_merge",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Validate and merge in the window"
        }
      ],
      "skos:definition": [
        {
          "@value": "Read each locale's QA report, confirm the PR is green, and merge it inside the owner's merge window. Outside the window it waits."
        }
      ],
      "skos:notation": "Task_ML_Merge",
      "dcterms:source": "cat-harness/library/processes/multi-locale-translation.bpmn#Task_ML_Merge",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_multilocaletranslation.task_ml_qareport",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Write the locale's QA report"
        }
      ],
      "skos:definition": [
        {
          "@value": "One report per locale under `test/results/translation-qa/`: coverage, the gates, the round trip with its counts and every drift ruling, the glossary violations and sense checks, and the source errors reported."
        }
      ],
      "skos:notation": "Task_ML_QAReport",
      "dcterms:source": "cat-harness/library/processes/multi-locale-translation.bpmn#Task_ML_QAReport",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_multilocaletranslation.task_ml_scope",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Set locales, scope and merge window"
        }
      ],
      "skos:definition": [
        {
          "@value": "Which layers, which locales, which assets (pages, diagrams, glossary, FHIR terms), and the window in which locale PRs may be merged."
        }
      ],
      "skos:notation": "Task_ML_Scope",
      "dcterms:source": "cat-harness/library/processes/multi-locale-translation.bpmn#Task_ML_Scope",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_multilocaletranslation.task_ml_sourceissue",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "File the source errors as one issue"
        }
      ],
      "skos:definition": [
        {
          "@value": "One issue for every source-text error the translators found, each with its location and the reading the translator took. Never fixed in a translation: a fix to the source is a source PR, and the next refresh carries it to every locale."
        }
      ],
      "skos:notation": "Task_ML_SourceIssue",
      "dcterms:source": "cat-harness/library/processes/multi-locale-translation.bpmn#Task_ML_SourceIssue",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_multilocaletranslation.task_ml_sourcepr",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Merge the one source PR to main"
        }
      ],
      "skos:definition": [
        {
          "@value": "All the templates in one PR to main, merged before any locale starts, so every translator branches from the same main. Once it has merged, its branch receives nothing more: a later fix to the source is a new PR."
        }
      ],
      "skos:notation": "Task_ML_SourcePR",
      "dcterms:source": "cat-harness/library/processes/multi-locale-translation.bpmn#Task_ML_SourcePR",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_multilocaletranslation.task_ml_translate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Translate one locale"
        }
      ],
      "skos:definition": [
        {
          "@value": "From the merged templates, with the locale term base: `translations/<locale>/**.po`, a translation-node manifest beside each (`official: false`, `generatedBy: \"agent\"`; no `status.json`), and the FHIR terms as CodeSystem supplements, all in one file for the locale rather than edits inside the resources."
        }
      ],
      "skos:notation": "Task_ML_Translate",
      "dcterms:source": "cat-harness/library/processes/multi-locale-translation.bpmn#Task_ML_Translate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_multilocaletranslation.task_ml_watcher",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Schedule the refresh watcher"
        }
      ],
      "skos:definition": [
        {
          "@value": "Schedule a fresh session that follows `translation-refresh` on each layer, so a template that moves after today is caught by its check failing, not by a reader."
        }
      ],
      "skos:notation": "Task_ML_Watcher",
      "dcterms:source": "cat-harness/library/processes/multi-locale-translation.bpmn#Task_ML_Watcher",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_narrativereview.call_voiceoverlay",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Voice overlay review"
        }
      ],
      "skos:definition": [
        {
          "@value": "Descend into Process_VoiceReview for whichever named voices the folio has ACTIVATED — the WHO editorial style, the guideline-development register, the publication design conventions, the Milnor exposition standard. No new role is taken on: register is what this lane already judges, and a voice is a register. Placed after the base voice adjudication because a voice OVERLAYS the house voice rather than replacing it, so the house finding has to be settled first. Its own first gateway leaves immediately when no voice is active, which is this layer's case and the default everywhere."
        }
      ],
      "skos:notation": "Call_VoiceOverlay",
      "dcterms:source": "cat-harness/processes/content/review-narrative.bpmn#Call_VoiceOverlay",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_narrativereview.task_adjudicatevoice",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Adjudicate the voice findings"
        }
      ],
      "skos:definition": [
        {
          "@value": "Three outcomes, all legitimate: the register is wrong for this genre; the criterion does not belong in this genre and should carry `profiles`; or the block is a stated exception and a reviewer entry records why."
        }
      ],
      "skos:notation": "Task_AdjudicateVoice",
      "dcterms:source": "cat-harness/processes/content/review-narrative.bpmn#Task_AdjudicateVoice",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_narrativereview.task_readfindings",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Read the sidecar findings"
        }
      ],
      "skos:definition": [
        {
          "@value": "Open the block's `.qa.json`, not just the evidence line: register is a property of the passage, and the sidecar quotes one line of it."
        }
      ],
      "skos:notation": "Task_ReadFindings",
      "dcterms:source": "cat-harness/processes/content/review-narrative.bpmn#Task_ReadFindings",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_narrativereview.task_recordfindings",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record findings as advice"
        }
      ],
      "skos:definition": [
        {
          "@value": "A reviewer cannot accept a change — that is the editor's lane — so the output is findings on the sidecar, not a commit."
        }
      ],
      "skos:notation": "Task_RecordFindings",
      "dcterms:source": "cat-harness/processes/content/review-narrative.bpmn#Task_RecordFindings",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_narrativereview.task_reviewtranslation",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review the translation"
        }
      ],
      "skos:definition": [
        {
          "@value": "Coverage, preserved terms and echoes are mechanical. A semantic round trip needs a back-translator that has not seen the original; where none has run, the criterion carries no verdict and that is the honest state."
        }
      ],
      "skos:notation": "Task_ReviewTranslation",
      "dcterms:source": "cat-harness/processes/content/review-narrative.bpmn#Task_ReviewTranslation",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_optionsanalysis.a_apply",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Apply it, and state each option's trade-offs"
        }
      ],
      "skos:definition": [
        {
          "@value": "Follow the selected methodology as written — adopted whole, not blended with another. At least two real options: one option is not a choice, and a straw option is worse than a short list because it makes the analysis look thorough while narrowing it. Never quantify the comparison to make it look measured. Where a method scores and sums, this platform takes the structure and refuses the arithmetic: the weights are invented and a total reads as a measurement."
        }
      ],
      "skos:notation": "A_Apply",
      "dcterms:source": "cat-harness/processes/process/options-analysis.bpmn#A_Apply",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_optionsanalysis.a_checkevidence",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Check the selected methodology's evidence base"
        }
      ],
      "skos:definition": [
        {
          "@value": "Before applying a methodology, establish that the thing being applied is what it claims to be. A methodology is adopted because it is somebody else's named, external work; this step checks that the `origin` it cites resolves to a source in a declared library, and reads the `methodology-evidence` QA sidecar for it. WHY THE CHECK IS HERE AND NOT AT ADOPTION. Adoption happens once; selection happens every time a decision is made. A source that was reachable when the methodology was adopted can stop being so, and a methodology adopted before this axis existed was never checked at all. Measured 2026-09-22: six methodologies cited an origin and NONE had that source in any library, so every selection made until then rested on an unverifiable citation. WHAT A GAP DOES AND DOES NOT DO. A missing source does NOT block the decision, and this step has no branch that stops the process — that would make a documentation gap into an outage, and the owner decides whether an unbacked methodology may still be used. It does two things: it runs `literature-search` to try to close the gap, and it puts the evidence state into the record `A_Record` writes, so a reader can tell a decision made on a verified method from one made on a citation nobody could follow. The third state is the one that matters. \"Source ingested\", \"source located but unreachable from here\" and \"no source found\" are three different facts, and `literature-search` exists largely to stop the middle one being reported as the last."
        }
      ],
      "skos:notation": "A_CheckEvidence",
      "dcterms:source": "cat-harness/processes/process/options-analysis.bpmn#A_CheckEvidence",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_optionsanalysis.a_frame",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Frame the decision and check the trigger"
        }
      ],
      "skos:definition": [
        {
          "@value": "One sentence naming the KIND of thing being chosen, not the options — \"which cache strategy\", never \"A or B\". Then the trigger: is this irreversible, or would the answer surprise someone? If neither, say so and stop; the calling step decides without this subprocess. Stopping here is a correct outcome, not a skipped step."
        }
      ],
      "skos:notation": "A_Frame",
      "dcterms:source": "cat-harness/processes/process/options-analysis.bpmn#A_Frame",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_optionsanalysis.a_record",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record the chosen option AND the rejected ones"
        }
      ],
      "skos:definition": [
        {
          "@value": "The rejected options and why they lost are part of the output, not an appendix. A rejected option with no record is a dead end nobody marked, and the next agent walks into it — the same argument `bean-coordination` makes for `scrapped` over deleted. In a bean context the form is MADR's. Which methodology was followed is named here, so a reader can check the method rather than take the conclusion."
        }
      ],
      "skos:notation": "A_Record",
      "dcterms:source": "cat-harness/processes/process/options-analysis.bpmn#A_Record",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_optionsanalysis.a_select",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Select the methodology by context"
        }
      ],
      "skos:definition": [
        {
          "@value": "Ask the selection question in order, first yes decides: do the criteria RECUR with the same inputs having to produce the same answer; is this the CERTAINTY of a body of evidence behind a recommendation; is the context a BEAN recording a decision; otherwise a one-off choice among candidates. If none fits, that is a finding — say which question the decision is and that no adopted methodology covers it. Do not improvise one and do not stretch the nearest fit. The declared set is the contents of the `methodology` graph. Ask for it; do not remember it."
        }
      ],
      "skos:notation": "A_Select",
      "dcterms:source": "cat-harness/processes/process/options-analysis.bpmn#A_Select",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_refreshmaterialized.task_adjudicate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Adjudicate the conflict"
        }
      ],
      "skos:definition": [
        {
          "@value": "A human or agentic decision, never a merge rule. Which side wins depends on why the local edit was made, and a process that picked automatically would be choosing without the one fact that decides it."
        }
      ],
      "skos:notation": "Task_Adjudicate",
      "dcterms:source": "cat-harness/library/processes/refresh-materialized.bpmn#Task_Adjudicate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_refreshmaterialized.task_apply",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Re-materialize and record new fixity"
        }
      ],
      "skos:definition": [
        {
          "@value": "The gates are re-asked, not inherited: a licence can change, and a collection can grow past the size a caller agreed to. AND THE NEW FIXITY IS RECORDED IN THE SAME CHANGE. This step rewrites bytes that a materialization record describes, so leaving the old digest behind would make a CORRECT run of this process fail check:materialized-fixity as a mismatch — the gate reading \"somebody edited held content without saying so\" about the one process whose job is to replace it. This is the publication exception, stated as a rule rather than as a carve-out, because a list of permitted writers goes stale when a writer is added. The exception is NOT \"these actors may skip the rule\"; it is \"say what you did\". A writer that updates the digest alongside the bytes passes, and the record then describes what is actually there. A writer that does not fails, correctly, because it has forked upstream silently."
        }
      ],
      "skos:notation": "Task_Apply",
      "dcterms:source": "cat-harness/library/processes/refresh-materialized.bpmn#Task_Apply",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_refreshmaterialized.task_fixity",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "ARCHIVAL verify fixity — never re-fetch"
        }
      ],
      "skos:definition": [
        {
          "@value": "Re-compute the digest and compare. An archive is NEVER re-fetched — the source is what it exists to survive, so replacing it with today's version discards the state it was keeping. A mismatch means OUR copy rotted, and the remedy is restoration from a backup, not re-download."
        }
      ],
      "skos:notation": "Task_Fixity",
      "dcterms:source": "cat-harness/library/processes/refresh-materialized.bpmn#Task_Fixity",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_refreshmaterialized.task_keeplocal",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Keep the edit, re-pin"
        }
      ],
      "skos:definition": [
        {
          "@value": "The local edit wins, so nothing is re-materialized — and the pin moves to the upstream revision that was compared against. Re-pinning is the half that is easy to forget and is the reason this is a step rather than an absence: without it the same upstream change is detected as new on every cycle, and a contributor is asked the same settled question for ever. The record says the copy is deliberately divergent FROM a named revision, which is a different claim from being stale against an unknown one."
        }
      ],
      "skos:notation": "Task_KeepLocal",
      "dcterms:source": "cat-harness/library/processes/refresh-materialized.bpmn#Task_KeepLocal",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_refreshmaterialized.task_local",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "What changed LOCALLY since"
        }
      ],
      "skos:definition": [
        {
          "@value": "The half nothing answers today. A materialized copy that was edited in place is not a copy any more, and overwriting it silently destroys work whose existence the process never established."
        }
      ],
      "skos:notation": "Task_Local",
      "dcterms:source": "cat-harness/library/processes/refresh-materialized.bpmn#Task_Local",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_refreshmaterialized.task_reconcile",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Reconcile the two by hand"
        }
      ],
      "skos:definition": [
        {
          "@value": "Neither side wins whole: the contributor produces content that is neither the local copy nor the remote one, and THEN it is applied. Drawn as a separate step before Task_Apply rather than folded into it, because Task_Apply re-asks the five import gates against what is being materialized — and what is being materialized here is a hand-made artefact, which is exactly the case those gates should see rather than be told about."
        }
      ],
      "skos:notation": "Task_Reconcile",
      "dcterms:source": "cat-harness/library/processes/refresh-materialized.bpmn#Task_Reconcile",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_refreshmaterialized.task_recordconflict",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record the conflict: no decision, no re-pin"
        }
      ],
      "skos:definition": [
        {
          "@value": "Both copies stay and the conflict is written down with what each side says. Deliberately does not re-pin, which is the one thing separating it from Task_KeepLocal: the question is unresolved, so it must be asked again next cycle. Recording is not optional here for the reason A_RecordEntry is not optional in an adjudication — a judgement nobody wrote down is indistinguishable from a check that never ran, and a DEFERRAL nobody wrote down is indistinguishable from a refresh that silently did nothing."
        }
      ],
      "skos:notation": "Task_RecordConflict",
      "dcterms:source": "cat-harness/library/processes/refresh-materialized.bpmn#Task_RecordConflict",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_refreshmaterialized.task_upstream",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "WORKING what changed upstream"
        }
      ],
      "skos:definition": [
        {
          "@value": "Compare the recorded upstreamVersion against the source. `could not reach the source` is a THIRD answer and is never reported as `unchanged` — an unreachable source is the sourceLoss gate firing late. Reachability is asked by `bun run cat sources:liveness <instance>` against the node's resolvable IRI, its Handle first: live, gone, or could not determine, never live on an error."
        }
      ],
      "skos:notation": "Task_Upstream",
      "dcterms:source": "cat-harness/library/processes/refresh-materialized.bpmn#Task_Upstream",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_relatedwork.a_categorize",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Categorize and summarize"
        }
      ],
      "skos:definition": [
        {
          "@value": "Each hit gets a category (overlaps: coordinate; affected by; out of scope; unrelated) and a one-line summary with its state. Judgement, not a keyword score: say why each is in its category."
        }
      ],
      "skos:notation": "A_Categorize",
      "dcterms:source": "cat-harness/processes/process/related-work.bpmn#A_Categorize",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_relatedwork.a_record",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record and act on the answer"
        }
      ],
      "skos:definition": [
        {
          "@value": "Write the chosen coordination where it will be found: bean links (--blocked-by, --parent), a line in the issue or PR body, or 'note only'. A declined coordination is recorded too."
        }
      ],
      "skos:notation": "A_Record",
      "dcterms:source": "cat-harness/processes/process/related-work.bpmn#A_Record",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_relatedwork.a_searchbeans",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Search beans for relevance"
        }
      ],
      "skos:definition": [
        {
          "@value": "beans list --json / beans query over titles AND bodies, open and recently completed. A completed bean is evidence of a decision already made."
        }
      ],
      "skos:notation": "A_SearchBeans",
      "dcterms:source": "cat-harness/processes/process/related-work.bpmn#A_SearchBeans",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_relatedwork.a_searchissues",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Search issues and open PRs"
        }
      ],
      "skos:definition": [
        {
          "@value": "The repository's issues (open and closed) and its open pull requests. An open PR touching the same files is the collision most worth finding early."
        }
      ],
      "skos:notation": "A_SearchIssues",
      "dcterms:source": "cat-harness/processes/process/related-work.bpmn#A_SearchIssues",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_relatedwork.u_coordinate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Coordinate? How?"
        }
      ],
      "skos:notation": "U_Coordinate",
      "dcterms:source": "cat-harness/processes/process/related-work.bpmn#U_Coordinate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_renderkgtocdn.call_githubpages",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Render and push to GitHub Pages"
        }
      ],
      "skos:definition": [
        {
          "@value": "BOUND BY THE TOOL, so no `calledElement` is written here: the `gh-pages` Tool lists the process this descends into, render-kg-to-github-pages, and that process is held by a layer cat-harness does not need, so naming it would bind upward. What it does: make sure gh-pages exists and Pages serves it, stage, check the staging, commit onto gh-pages, check what is served. It returns the status and the message Task_Report records."
        }
      ],
      "skos:notation": "Call_GitHubPages",
      "dcterms:source": "cat-harness/processes/process/render-kg-to-cdn.bpmn#Call_GitHubPages",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_renderkgtocdn.call_toolsubprocess",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Render and push with that CDN's own Tool"
        }
      ],
      "skos:definition": [
        {
          "@value": "BOUND BY THE TOOL, so no `calledElement` is written here, and only on this branch: the CDN is not GitHub Pages, and its Tool, which a higher layer owns (a Cloudflare publish, for one), lists the process this descends into. A lower layer cannot name a higher layer\\'s process. Whatever the Tool, it returns the same status and message."
        }
      ],
      "skos:notation": "Call_ToolSubprocess",
      "dcterms:source": "cat-harness/processes/process/render-kg-to-cdn.bpmn#Call_ToolSubprocess",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_renderkgtocdn.task_report",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Report the push: status and message"
        }
      ],
      "skos:definition": [
        {
          "@value": "The output, on every path: `pushed`, `not-pushed` or `could-not-determine`, and one message — what is live (a commit), at which root URL, and the QA result. From the no-Tool branch the status is `not-pushed` and the message names the target nobody implements. A check that could not look is never reported as pushed."
        }
      ],
      "skos:notation": "Task_Report",
      "dcterms:source": "cat-harness/processes/process/render-kg-to-cdn.bpmn#Task_Report",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_renderkgtocdn.task_resolve",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Determine which CDN, the root URL and the Subgraphs"
        }
      ],
      "skos:definition": [
        {
          "@value": "Every Subgraph id asked for must be one the declaration lists; none means the whole graph. The root URL is the one given. The target's Tool is the one that `satisfies: [\"render-kg-to-cdn\"]` for that CDN — `gh-pages` for GitHub Pages. A caller that already rendered and verified its tree hands the tree over instead of the graph, and the Tool pushes it without rendering again."
        }
      ],
      "skos:notation": "Task_Resolve",
      "dcterms:source": "cat-harness/processes/process/render-kg-to-cdn.bpmn#Task_Resolve",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_renderlog.a_logremoved",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Append `removed` with the reason"
        }
      ],
      "skos:definition": [
        {
          "@value": "BEFORE the removal, not after: a job that dies mid-step must leave a record of the intent rather than an artefact that vanished with no entry. A reason is REQUIRED — an entry saying an artefact went and not why is the ambiguity this log exists to prevent."
        }
      ],
      "skos:notation": "A_LogRemoved",
      "dcterms:source": "cat-harness/processes/ui/staging-render-log.bpmn#A_LogRemoved",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_renderlog.a_logrendered",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Append `rendered`"
        }
      ],
      "skos:definition": [
        {
          "@value": "A re-deploy is a rendering, so it gets its own entry rather than overwriting the last. \"When was this last built\" is then answerable without diffing commits."
        }
      ],
      "skos:notation": "A_LogRendered",
      "dcterms:source": "cat-harness/processes/ui/staging-render-log.bpmn#A_LogRendered",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_renderlog.a_logrestored",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Append `restored`"
        }
      ],
      "skos:definition": [
        {
          "@value": "A full-replace deploy (`docs-site.yml`, the only publisher without keep_files) wipes the branch; `restore-staging` carries the previews AND this log back in. Its own event rather than a second `rendered`, because \"somebody pushed this branch\" and \"an unrelated merge nearly deleted it\" are different facts."
        }
      ],
      "skos:notation": "A_LogRestored",
      "dcterms:source": "cat-harness/processes/ui/staging-render-log.bpmn#A_LogRestored",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_renderlog.a_logretained",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Append `retained` with the reason"
        }
      ],
      "skos:definition": [
        {
          "@value": "Records that a removal was considered and refused, or that a preview still stands because a signal fired; without the entry that leaves no trace, and nobody can tell why a preview is still up. A reason is REQUIRED — the tool refuses without one."
        }
      ],
      "skos:notation": "A_LogRetained",
      "dcterms:source": "cat-harness/processes/ui/staging-render-log.bpmn#A_LogRetained",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_renderlog.a_preflight",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Preflight: is the preview live?"
        }
      ],
      "skos:definition": [
        {
          "@value": "`previewLiveness` — a disjunction over open-pr, unmerged-branch and recent-commit, shared with the health sweep so the two cannot disagree. A preview whose pull request is closed is NOT necessarily an abandoned one."
        }
      ],
      "skos:notation": "A_Preflight",
      "dcterms:source": "cat-harness/processes/ui/staging-render-log.bpmn#A_Preflight",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_renderlog.a_remove",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Remove the artefact"
        }
      ],
      "skos:definition": [
        {
          "@value": "`rm -rf branches/<slug>`. Cannot reach the log, which lives outside branches/ — structural rather than guarded, because a branch named to collide with a directory under branches/ slugifies to exactly that name and git permits the ref."
        }
      ],
      "skos:notation": "A_Remove",
      "dcterms:source": "cat-harness/processes/ui/staging-render-log.bpmn#A_Remove",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_review.call_codereview",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Code node review"
        }
      ],
      "skos:definition": [
        {
          "@value": "Descend into Process_CodeReview. The actor takes on the `code-reviewer` lane for this call path only."
        }
      ],
      "skos:notation": "Call_CodeReview",
      "dcterms:source": "cat-harness/processes/content/review-task.bpmn#Call_CodeReview",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_review.call_narrativecodereview",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Prose and the code it describes"
        }
      ],
      "skos:definition": [
        {
          "@value": "Descend into Process_NarrativeCodeReview: judge what the pair checks could not settle (a stale pair, a false or undetermined claim), and send a disagreement with a checker to adjudication. Where `cat-harness.sdlc` is switched on, this step is the opt-in process `narrative-code-review` (`Process_NarrativeCodeReview`, sdlc/processes/narrative-code-review.bpmn); it is not called from here, because a layer without that sub-graph does not have it (owner card Q-OPTIN-CALLS A, 2026-11-12)."
        }
      ],
      "skos:notation": "Call_NarrativeCodeReview",
      "dcterms:source": "cat-harness/processes/content/review-task.bpmn#Call_NarrativeCodeReview",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_review.call_narrativereview",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Narrative review"
        }
      ],
      "skos:definition": [
        {
          "@value": "Descend into Process_NarrativeReview. The actor takes on the `narrative-reviewer` lane for this call path only."
        }
      ],
      "skos:notation": "Call_NarrativeReview",
      "dcterms:source": "cat-harness/processes/content/review-task.bpmn#Call_NarrativeReview",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_review.task_classifychange",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Classify what changed"
        }
      ],
      "skos:definition": [
        {
          "@value": "Prose, code nodes, or both. This is the only decision the generic lane makes on its own: everything after it is made inside a subprocess by the role that lane binds. Binds `content-review`, the same skill as Task_Consolidate in this lane, because a paper skill belongs to the science layer, which this harness diagram cannot reach. A paper process that wants semantic scoping adds it by calling this process."
        }
      ],
      "skos:notation": "Task_ClassifyChange",
      "dcterms:source": "cat-harness/processes/content/review-task.bpmn#Task_ClassifyChange",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_review.task_consolidate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Consolidate findings"
        }
      ],
      "skos:definition": [
        {
          "@value": "One report from however many subprocesses ran. Findings are advice: a reviewer cannot accept the change."
        }
      ],
      "skos:notation": "Task_Consolidate",
      "dcterms:source": "cat-harness/processes/content/review-task.bpmn#Task_Consolidate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_review.task_editordecides",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Accept, or send back"
        }
      ],
      "skos:definition": [
        {
          "@value": "The editor's lane, kept separate on purpose: the reviewer who judged the change is not the position that accepts it."
        }
      ],
      "skos:notation": "Task_EditorDecides",
      "dcterms:source": "cat-harness/processes/content/review-task.bpmn#Task_EditorDecides",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_sampleimport.call_materialize",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Materialize remote content (the five gates)"
        }
      ],
      "skos:definition": [
        {
          "@value": "The shared subprocess. It resolves the request against the source descriptor, then asks size, restrictions, copyright, retention and source loss, and either fetches with fixity or leaves the content referenced. This process does not restate any of that; it waits for the outcome."
        }
      ],
      "skos:notation": "Call_Materialize",
      "dcterms:source": "cat-harness/library/processes/sample-import.bpmn#Call_Materialize",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_sampleimport.call_refresh",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Refresh materialized content"
        }
      ],
      "skos:definition": [
        {
          "@value": "Refresh is not re-import: what changed upstream, what changed locally since, and what to do when both did. The shared subprocess answers all three, and re-asks the five gates, since a licence can change and a collection can grow past the size agreed."
        }
      ],
      "skos:notation": "Call_Refresh",
      "dcterms:source": "cat-harness/library/processes/sample-import.bpmn#Call_Refresh",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_sampleimport.task_importtest",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Import into the store, and test the import"
        }
      ],
      "skos:definition": [
        {
          "@value": "The part only this process does. Load the landed sample into the chosen store and check what an import can get wrong: every item arrived (count against the request), identifiers survived (the descriptor's authoritative ones), structure validates against the store's schema, and provenance (source, revision, fixity) is attached to each node. A check that could not run is a failure, not a pass."
        }
      ],
      "skos:notation": "Task_ImportTest",
      "dcterms:source": "cat-harness/library/processes/sample-import.bpmn#Task_ImportTest",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_sampleimport.task_library",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Land it in library/"
        }
      ],
      "skos:definition": [
        {
          "@value": "A permanent sample joins the library as an L1 source, with the materialization record (purpose, gates, fixity) beside it. From here refresh-materialized governs it."
        }
      ],
      "skos:notation": "Task_Library",
      "dcterms:source": "cat-harness/library/processes/sample-import.bpmn#Task_Library",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_sampleimport.task_recordfindings",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record what failed"
        }
      ],
      "skos:definition": [
        {
          "@value": "Which check failed, on which items, and the evidence. The landed copy is not removed: a failed import is information about the source or the store, and deleting the copy would destroy the evidence."
        }
      ],
      "skos:notation": "Task_RecordFindings",
      "dcterms:source": "cat-harness/library/processes/sample-import.bpmn#Task_RecordFindings",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_sampleimport.task_scope",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Scope the sample: items, store, permanence"
        }
      ],
      "skos:definition": [
        {
          "@value": "Three answers, recorded before anything is fetched. WHICH ITEMS: named by the source's identifiers, or by a subset strategy its descriptor supports. WHICH STORE: the knowledge graph or other structured store the import is tested against. PERMANENT OR TRIAL: a permanent sample lands in library/ and is refreshed; a trial lands in fsh-guts/ and is not. The purpose materialize-remote asks for (working or archival) is asked there, not here."
        }
      ],
      "skos:notation": "Task_Scope",
      "dcterms:source": "cat-harness/library/processes/sample-import.bpmn#Task_Scope",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_sampleimport.task_trial",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Keep it as a trial: the unpublished trashcan"
        }
      ],
      "skos:definition": [
        {
          "@value": "A trial goes to the kept trashcan: addressable, exported, never published. Its node declares `$schema: folio-fsh-guts/v1` and carries the bean or issue it was written under, since it was never moved from anywhere and a `movedFrom` would be invented provenance. It is NOT refreshed: a trial records what the source looked like when it was tried. Promoting a trial means running this process again with permanent = yes, so the gates are asked afresh."
        }
      ],
      "skos:notation": "Task_Trial",
      "dcterms:source": "cat-harness/library/processes/sample-import.bpmn#Task_Trial",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_secureagentpermissions.task_explain",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Explain each missing permission, with the exact config diff"
        }
      ],
      "skos:definition": [
        {
          "@value": "Per permission: what it allows the agent to do without asking, why a process here needs it, the narrowest form that would do, and the exact change to the Tool's config. Context, options, recommendation, question (interaction-modality §4.1). Least privilege is the recommendation unless there is a measured reason for more."
        }
      ],
      "skos:notation": "Task_Explain",
      "dcterms:source": "cat-harness/processes/process/secure-agent-permissions.bpmn#Task_Explain",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_secureagentpermissions.task_identifytools",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Identify the agent Tool(s) acting here"
        }
      ],
      "skos:definition": [
        {
          "@value": "Which coding-agent Tool is running this session, and which others the layer is configured for (each has its own config files: AGENTS.md is read by many; Claude Code, Gemini CLI, Cursor, Copilot and Codex each add their own). The Tool's adapter says where its permissions live and how a rule is written. A Tool with no adapter is reported, and its permissions are left to the person."
        }
      ],
      "skos:notation": "Task_IdentifyTools",
      "dcterms:source": "cat-harness/processes/process/secure-agent-permissions.bpmn#Task_IdentifyTools",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_secureagentpermissions.task_ownergrants",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Grant, narrow or refuse each"
        }
      ],
      "skos:definition": [
        {
          "@value": "The owner's answer, per permission, in their own words. Quoted verbatim in the record."
        }
      ],
      "skos:notation": "Task_OwnerGrants",
      "dcterms:source": "cat-harness/processes/process/secure-agent-permissions.bpmn#Task_OwnerGrants",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_secureagentpermissions.task_readgrants",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Compare what the processes need with what is granted"
        }
      ],
      "skos:definition": [
        {
          "@value": "The needed set is the agent-permissions skill's list (write generated projections: CI only, never the agent; edit hooks or settings; run the gates; push a feature branch; open a PR), scoped to what this layer's processes actually call. The granted set is the recorded grants plus the Tool's current config, read through its adapter. A config rule with no recorded grant is reported as unrecorded, not treated as granted."
        }
      ],
      "skos:notation": "Task_ReadGrants",
      "dcterms:source": "cat-harness/processes/process/secure-agent-permissions.bpmn#Task_ReadGrants",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_secureagentpermissions.task_recordgrant",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record each answer: who, when, scope, the quote"
        }
      ],
      "skos:definition": [
        {
          "@value": "One record per permission: by, on, tool, permission, scope (session, instance, or until a date), the config diff, and evidence (the owner's words verbatim, with where they were said). Refusals are recorded the same way."
        }
      ],
      "skos:notation": "Task_RecordGrant",
      "dcterms:source": "cat-harness/processes/process/secure-agent-permissions.bpmn#Task_RecordGrant",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_secureagentpermissions.task_writeconfig",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Write it through the Tool's adapter"
        }
      ],
      "skos:definition": [
        {
          "@value": "The exact diff the owner saw, nothing more, written by the person or by the agent under their consent to that diff. Hand-edited agent config only; generated projections are CI's (harness-projections)."
        }
      ],
      "skos:notation": "Task_WriteConfig",
      "dcterms:source": "cat-harness/processes/process/secure-agent-permissions.bpmn#Task_WriteConfig",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_sessionstatemachine.a_askwhoisacting",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Ask who is acting"
        }
      ],
      "skos:definition": [
        {
          "@value": "The one step that needs a person. Asked ONCE and recorded, never re-asked: `memory/interaction.json` and the record exist so that a preference stated once is not requested again, which is WCAG 2.2 SC 3.3.7."
        }
      ],
      "skos:notation": "A_AskWhoIsActing",
      "dcterms:source": "cat-harness/processes/process/session-state-machine.bpmn#A_AskWhoIsActing",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_sessionstatemachine.a_closesession",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Close the session"
        }
      ],
      "skos:definition": [
        {
          "@value": "Records that the actor stopped. It does NOT resolve beans or complete instances: those outlive the session by design, and a machine that closed them on the way out would be asserting work finished because somebody went away."
        }
      ],
      "skos:notation": "A_CloseSession",
      "dcterms:source": "cat-harness/processes/process/session-state-machine.bpmn#A_CloseSession",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_sessionstatemachine.a_identifyactor",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Establish who is acting"
        }
      ],
      "skos:definition": [
        {
          "@value": "The first step and not a formality: `actor` is the one field of the record that nothing else can supply. Every other field is recoverable by reading the repository; who is acting is not."
        }
      ],
      "skos:notation": "A_IdentifyActor",
      "dcterms:source": "cat-harness/processes/process/session-state-machine.bpmn#A_IdentifyActor",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_sessionstatemachine.a_opensession",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Open the session record"
        }
      ],
      "skos:definition": [
        {
          "@value": "Writes `id`, `actor` and `startedAt`, with `open` and `claimed` empty. An empty `open` is the NORMAL state, not an unfinished one: an agent reading, answering or deciding is in no process at all."
        }
      ],
      "skos:notation": "A_OpenSession",
      "dcterms:source": "cat-harness/processes/process/session-state-machine.bpmn#A_OpenSession",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_sessionstatemachine.a_readturn",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Take in the turn"
        }
      ],
      "skos:definition": [
        {
          "@value": "A turn is anything that arrives — a person's message, a tool result, a notification. The machine advances on turns rather than on a clock, because a session that has been told nothing has not changed."
        }
      ],
      "skos:notation": "A_ReadTurn",
      "dcterms:source": "cat-harness/processes/process/session-state-machine.bpmn#A_ReadTurn",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_sessionstatemachine.a_touch",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Refresh `updatedAt` only"
        }
      ],
      "skos:definition": [
        {
          "@value": "Nothing changed, and saying so is the point. A record that stops being written looks exactly like an abandoned session; a refreshed timestamp with no other change says the session is alive and idle, which is a different fact and the commonest one."
        }
      ],
      "skos:notation": "A_Touch",
      "dcterms:source": "cat-harness/processes/process/session-state-machine.bpmn#A_Touch",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_sessionstatemachine.a_updatesession",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Write what changed"
        }
      ],
      "skos:definition": [
        {
          "@value": "An instance opened or closed, a bean claimed, a wait started or ended. All by REFERENCE: the bean and the instance are each the authority on themselves, and a status copied here would be free to contradict them. NO `cat-harness.processes:bean` on this step. It records that a claim happened; it does not claim."
        }
      ],
      "skos:notation": "A_UpdateSession",
      "dcterms:source": "cat-harness/processes/process/session-state-machine.bpmn#A_UpdateSession",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_sessionstatemachine.call_securepermissions",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Secure the agent's permissions"
        }
      ],
      "skos:definition": [
        {
          "@value": "Once the actor is known and the record is open, check that the coding agent acting here holds the permissions this layer's processes need, granted by a person and recorded, and ask for any that are missing. This is where initiating the harness for an actor secures them, rather than the first denied command. A run that finds them current returns without asking anything; the same process is called on demand when an action is denied later in the session. Vendor-neutral: the agent is a Tool, and its config is written through that Tool's adapter. Skill: agent-permissions."
        }
      ],
      "skos:notation": "Call_SecurePermissions",
      "dcterms:source": "cat-harness/processes/process/session-state-machine.bpmn#Call_SecurePermissions",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_slicesqlitepublish.a_check",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Gate every slice: slice:sqlite:check"
        }
      ],
      "skos:definition": [
        {
          "@value": "For every slice: build twice and require one sha256; read the row digest back from the file and require it to equal the digest computed from the source without SQLite; run an FTS5 phrase query for a known row; and audit the payloads with `auditPayloadTree` (deploy payloads as written, the kg slice's pointers against the committed payload tree). A slice whose rows do not match its source fails; it never passes as whole."
        }
      ],
      "skos:notation": "A_Check",
      "dcterms:source": "cat-harness/processes/kg/slice-sqlite-publish.bpmn#A_Check",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_slicesqlitepublish.a_define",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Write the slice definition"
        }
      ],
      "skos:definition": [
        {
          "@value": "Add one `SliceDef` to the builder's slice table: the DDL (one table per node type, edge tables, one CONTENTLESS full-detail FTS5), the order each table's rows go in, the `load` that turns the source into rows, where the payloads live (written at deploy, or already published), and the `search` block the generic page reads. Choose the heavy fields by `kg-export` §\"What is heavy\": a heavy field is a `payload_sha256` pointer, never a stored column. Never copy the builder."
        }
      ],
      "skos:notation": "A_Define",
      "dcterms:source": "cat-harness/processes/kg/slice-sqlite-publish.bpmn#A_Define",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_slicesqlitepublish.a_deploy",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Build each slice into _site at deploy"
        }
      ],
      "skos:definition": [
        {
          "@value": "`gen-slice-sqlite.ts --out ./_site/assets/slices --payload-out ./_site/payload/sha256 --slice <name>`, once per slice, from the tree being published: the file, its manifest, the slice index, and the deploy payloads beside the committed KG payloads. Never into the committed `docs/payload/`, whose orphan audit admits KG nodes only."
        }
      ],
      "skos:notation": "A_Deploy",
      "dcterms:source": "cat-harness/processes/kg/slice-sqlite-publish.bpmn#A_Deploy",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_slicesqlitepublish.a_measure",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Build it locally and measure the file"
        }
      ],
      "skos:definition": [
        {
          "@value": "Run `bun run cat slice:sqlite -- --slice <name> --out <scratch>` and read the manifest: `bytes`, the row counts, the payload count and bytes, `overBudget`, `duplicateIds` and `findings`. Record the measurement in the work context with its provenance (the command and the date), beside the size of the source it replaces."
        }
      ],
      "skos:notation": "A_Measure",
      "dcterms:source": "cat-harness/processes/kg/slice-sqlite-publish.bpmn#A_Measure",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_slicesqlitepublish.a_report",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Report the measurement; ship nothing"
        }
      ],
      "skos:definition": [
        {
          "@value": "Write the measurement and what was tried into the work context, and ask the owner whether the slice should ship at that size, be cut further, or not exist. Nothing is wired: no manifest is published, no gate added, no deploy line written."
        }
      ],
      "skos:notation": "A_Report",
      "dcterms:source": "cat-harness/processes/kg/slice-sqlite-publish.bpmn#A_Report",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_slicesqlitepublish.a_verify",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Search the published slice in a browser"
        }
      ],
      "skos:definition": [
        {
          "@value": "Open `slices/search.html?slice=<name>` on the deployed site, run a phrase search for a known row, open it so its payload is fetched, and look at the result; send the screenshot rather than a description of it. Report the mode the page says it used (OPFS or in memory), never an assumed one."
        }
      ],
      "skos:notation": "A_Verify",
      "dcterms:source": "cat-harness/processes/kg/slice-sqlite-publish.bpmn#A_Verify",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_slicesqlitepublish.a_wire",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Wire it: gate, deploy line, search, tests"
        }
      ],
      "skos:definition": [
        {
          "@value": "Give the slice everything a slice owes: its manifest (written by the builder from the definition), its `--check` (covered by `slice:sqlite:check`), one deploy line in `docs-site.yml` and in `feature-staging.yml`, its search (the generic page needs no code, only the definition's `search` block), a unit test over a fixture and over the real source, and a search in `slice-sqlite.e2e.ts`."
        }
      ],
      "skos:notation": "A_Wire",
      "dcterms:source": "cat-harness/processes/kg/slice-sqlite-publish.bpmn#A_Wire",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_subkglifecycle.call_authorise",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Authorise the move"
        }
      ],
      "skos:definition": [
        {
          "@value": "Report what would move and how it undoes, and ask the owner to create the repository. Declining leaves it staged, ready to leave."
        }
      ],
      "skos:notation": "Call_Authorise",
      "dcterms:source": "cat-harness/processes/kg/sub-kg-lifecycle.bpmn#Call_Authorise",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_subkglifecycle.call_cutover",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Cut over"
        }
      ],
      "skos:definition": [
        {
          "@value": "Freeze the in-repo copy in the kept trashcan and measure the cutover until it is complete or cannot be shown complete."
        }
      ],
      "skos:notation": "Call_Cutover",
      "dcterms:source": "cat-harness/processes/kg/sub-kg-lifecycle.bpmn#Call_Cutover",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_subkglifecycle.call_move",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Move it into its repository"
        }
      ],
      "skos:definition": [
        {
          "@value": "Create the repository, drain, copy the staged contents in, re-point the declaration, verify a fresh clone, then consume, release and check every identifier dereferences."
        }
      ],
      "skos:notation": "Call_Move",
      "dcterms:source": "cat-harness/processes/kg/sub-kg-lifecycle.bpmn#Call_Move",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_subkglifecycle.task_brief",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Brief the work"
        }
      ],
      "skos:definition": [
        {
          "@value": "What the work is and why, what is already measured with its provenance, how it will be done, and what would falsify the approach. The work item is already taken up when the process starts, so a sibling session sees the work before the brief is written. Here the work is a sub-KG: what it is, and why it is staged here rather than in a repository of its own."
        }
      ],
      "skos:notation": "Task_Brief",
      "dcterms:source": "cat-harness/processes/kg/sub-kg-lifecycle.bpmn#Task_Brief",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_subkglifecycle.task_confirmcutover",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Ask to freeze the in-repo copy"
        }
      ],
      "skos:definition": [
        {
          "@value": "The agent reports the files that would move, their size, the new repository and the commit the copy matches, then asks: (1) freeze it in the kept trashcan now, (2) keep in place until the first release, (3) show the file list first. Default if there is no answer: (2), nothing moves. A green fresh clone is the precondition for asking, not the answer. Non-relaxable. The host keeps a FROZEN copy in the kept trashcan, not a refreshed mirror and not a deletion; the live copy is the remote mount or subscription set up at stage 10."
        }
      ],
      "skos:notation": "Task_ConfirmCutover",
      "dcterms:source": "cat-harness/processes/kg/sub-kg-lifecycle.bpmn#Task_ConfirmCutover",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_subkglifecycle.task_decideleave",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Ask whether it should leave now"
        }
      ],
      "skos:definition": [
        {
          "@value": "The owner decides, from what is measured, whether the sub-KG starts staging for separation now. Asked as numbered options with the recommended one first and a stated default: keeping it in place is the default, and is a real outcome."
        }
      ],
      "skos:notation": "Task_DecideLeave",
      "dcterms:source": "cat-harness/processes/kg/sub-kg-lifecycle.bpmn#Task_DecideLeave",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_subkglifecycle.task_declare",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Declare it in place, with its seam"
        }
      ],
      "skos:definition": [
        {
          "@value": "`<name>/<name>.json` with name, version, `repository` (the planned home), `livesAt` (where it sits today), `needs`, and only the directories that exist, each declared with its files in one commit. `<name>/platform.ts` from the first commit, so no climb out of the directory ever needs rerouting. Scaffolded by `init-folio --staged <path>`, which writes those two files and nothing at the host root; never `--instance`, which writes a whole repository."
        }
      ],
      "skos:notation": "Task_Declare",
      "dcterms:source": "cat-harness/processes/kg/sub-kg-lifecycle.bpmn#Task_Declare",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_subkglifecycle.task_grow",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Grow it in place"
        }
      ],
      "skos:definition": [
        {
          "@value": "The content type's own authoring process runs here, against the staged layer. Many sub-KGs never leave; this task can last as long as the graph does."
        }
      ],
      "skos:notation": "Task_Grow",
      "dcterms:source": "cat-harness/processes/kg/sub-kg-lifecycle.bpmn#Task_Grow",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_subkglifecycle.task_pushdown",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Push generic down first"
        }
      ],
      "skos:definition": [
        {
          "@value": "Move what is generic into the harness below before the seam is closed, and consolidate what the sub-KG needs into the harness it instantiates. Wrong-direction edges hide in declarations and data as well as imports: run check:import-direction, check:reference-direction and check:process-bindings."
        }
      ],
      "skos:notation": "Task_PushDown",
      "dcterms:source": "cat-harness/processes/kg/sub-kg-lifecycle.bpmn#Task_PushDown",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_subkglifecycle.task_rehearse",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Rehearse self-contained"
        }
      ],
      "skos:definition": [
        {
          "@value": "`bun run cat seed:ready --layer <name> --rehearse` copies the layer and what it needs into a scratch workspace of sibling directories and runs the tests there. Run the gates rather than scanning imports: a static scan misses files the gates load at run time, and renaming the directory changes every generated page."
        }
      ],
      "skos:notation": "Task_Rehearse",
      "dcterms:source": "cat-harness/processes/kg/sub-kg-lifecycle.bpmn#Task_Rehearse",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_subkglifecycle.task_seam",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Route every climb through platform.ts"
        }
      ],
      "skos:definition": [
        {
          "@value": "Every platform symbol the sub-KG uses is re-exported from `<name>/platform.ts`, so re-pointing the platform is a one-file edit. A merge from main is where new climbs arrive; reroute them here."
        }
      ],
      "skos:notation": "Task_Seam",
      "dcterms:source": "cat-harness/processes/kg/sub-kg-lifecycle.bpmn#Task_Seam",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_subscribekg.call_materialize",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Materialise the part"
        }
      ],
      "skos:definition": [
        {
          "@value": "The ONLY way bytes arrive. Purpose first, then the five gates — size, restrictions, copyright, retention, source loss — then fetch with fixity, or stay referenced with the refusing gate's basis recorded. Both ends of that subprocess return here and the walk continues: one part refused is not the subscription refused."
        }
      ],
      "skos:notation": "Call_Materialize",
      "dcterms:source": "cat-harness/library/processes/subscribe-kg.bpmn#Call_Materialize",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_subscribekg.call_refresh",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Refresh the held part"
        }
      ],
      "skos:definition": [
        {
          "@value": "The shared refresh, called, not re-described: what changed upstream, what changed locally, and what to do when both did. An archival copy is fixity-checked and never re-fetched. Whatever that process decides — refreshed, kept divergent, or deferred — is the part's new state; this loop only moves to the next part."
        }
      ],
      "skos:notation": "Call_Refresh",
      "dcterms:source": "cat-harness/library/processes/subscribe-kg.bpmn#Call_Refresh",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_subscribekg.task_choose",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Choose subgraphs, assets, harnesses"
        }
      ],
      "skos:definition": [
        {
          "@value": "Written to the entry as `subgraphs`, `assets.policy` (none, on-demand or all) and `harnesses`. Choosing is not holding: a chosen subgraph is still referenced until the gates below let it through. Choosing nothing is legitimate — a subscription with no parts chosen is a pinned reference, the case associatedHarnesses covers today."
        }
      ],
      "skos:notation": "Task_Choose",
      "dcterms:source": "cat-harness/library/processes/subscribe-kg.bpmn#Task_Choose",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_subscribekg.task_instantiate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Instantiate the harness: write its config"
        }
      ],
      "skos:definition": [
        {
          "@value": "Write `<harness>.config.json` at the repository root, plus the state directories the harness declares, and — where the checkout has a root `index.config.json` — add the harness to its `instances[]` (kg:instantiate does both), because the index, not the file, is then what reads as INSTANTIATED (index-config skill); a root config the index does not list fails check:landing-instance. That instantiation is what puts the harness in the navbar's bottom region. check:instance-render must be green on the result; a config that renders nothing is an entry pointing nowhere."
        }
      ],
      "skos:notation": "Task_Instantiate",
      "dcterms:source": "cat-harness/library/processes/subscribe-kg.bpmn#Task_Instantiate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_subscribekg.task_pin",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Name the substrate, pin a full commit SHA"
        }
      ],
      "skos:definition": [
        {
          "@value": "`owner/repo` and a 40-character commit SHA — never a branch, never an abbreviated SHA. The schema refuses anything else (SubscriptionSchema.ref), and this step exists so the refusal is met while choosing rather than at commit time. A tag replaces the SHA only once the substrate publishes releases."
        }
      ],
      "skos:notation": "Task_Pin",
      "dcterms:source": "cat-harness/library/processes/subscribe-kg.bpmn#Task_Pin",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_subscribekg.task_record",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Write the entry and cache the declaration"
        }
      ],
      "skos:definition": [
        {
          "@value": "The `subscriptions` entry in the subscriber's layer declaration — id, repository, ref, and nothing chosen yet — plus a cached copy of the substrate's declaration at the pin. The entry holds the choice and the pin, never state: whether a part is held is answered by its materialisation record, and a second answer here would be free to disagree with it."
        }
      ],
      "skos:notation": "Task_Record",
      "dcterms:source": "cat-harness/library/processes/subscribe-kg.bpmn#Task_Record",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_subscribekg.task_refuse",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record why it is not a substrate; write no entry"
        }
      ],
      "skos:definition": [
        {
          "@value": "No subscription entry is written for a repository that is not a substrate. What is recorded is the reason (non-conforming, no harness, or unreachable) and the pin it was asked at, so a later attempt at a different commit starts from what failed."
        }
      ],
      "skos:notation": "Task_Refuse",
      "dcterms:source": "cat-harness/library/processes/subscribe-kg.bpmn#Task_Refuse",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_subscribekg.task_repin",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Move the entry's ref and re-cache the declaration"
        }
      ],
      "skos:definition": [
        {
          "@value": "Only after every held part has been through the refresh. Moving the ref first would make the records of parts not yet refreshed describe a commit the entry no longer names. The cached declaration is replaced so the review that follows shows what the NEW pin offers, including subgraphs that did not exist at the old one."
        }
      ],
      "skos:notation": "Task_RePin",
      "dcterms:source": "cat-harness/library/processes/subscribe-kg.bpmn#Task_RePin",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_subscribekg.task_review",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review what the substrate offers"
        }
      ],
      "skos:definition": [
        {
          "@value": "Every subgraph, asset class and harness the cached declaration names, each with its current state — referenced, materialised, unknown, stale, or refused by a gate. Shown whole, because a reader who sees only what was chosen cannot tell \"not offered\" from \"not taken\"."
        }
      ],
      "skos:notation": "Task_Review",
      "dcterms:source": "cat-harness/library/processes/subscribe-kg.bpmn#Task_Review",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_subscribekg.task_summarise",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record how each part of the walk ended"
        }
      ],
      "skos:definition": [
        {
          "@value": "One line per offered part: materialised, referenced by choice, or referenced because a gate refused (and which). Nothing new is decided here; it is the account the visualizer and the next refresh read, written once rather than reconstructed from the loop."
        }
      ],
      "skos:notation": "Task_Summarise",
      "dcterms:source": "cat-harness/library/processes/subscribe-kg.bpmn#Task_Summarise",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_subscribekg.task_validate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Fetch and validate the pinned declaration"
        }
      ],
      "skos:definition": [
        {
          "@value": "A sparse, shallow fetch of the substrate's root declaration only. Two questions: does it parse as bootstrap's KnowledgeGraphDeclarationSchema, and does it declare at least one harness? `could not fetch` is a third answer and is never read as `conforms`."
        }
      ],
      "skos:notation": "Task_Validate",
      "dcterms:source": "cat-harness/library/processes/subscribe-kg.bpmn#Task_Validate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_swotanalysis.a_cross",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Cross the axes into SO, WO, ST, WT"
        }
      ],
      "skos:definition": [
        {
          "@value": "The TOWS matching step, and the only step that produces anything actionable. Strengths and weaknesses across, opportunities and threats down, and each cell names the strategy the pairing implies: SO — achieve opportunities that greatly match the strengths; WO — overcome weaknesses to attain opportunities; ST — use strengths to reduce vulnerability to threats; WT — prevent weaknesses, to avoid becoming more susceptible to threats. A SWOT that stops at four lists is the failure the source names as its central one. This step is what the process exists to reach. It produces CANDIDATE strategies, not a chosen one, and they are not ranked — see the process documentation on why no scoring activity exists."
        }
      ],
      "skos:notation": "A_Cross",
      "dcterms:source": "cat-harness/processes/process/swot-analysis.bpmn#A_Cross",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_swotanalysis.a_framesubject",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Name the subject and the level"
        }
      ],
      "skos:definition": [
        {
          "@value": "One sentence naming WHAT is being analysed and at WHICH level — individual, organisational, national, international. The source requires this before anything is listed: \"the classification of a variable also depends on the purpose of the practice\", and the criteria for assigning a variable to a quadrant \"may be more difficult to clarify if the methodology is not used for a company but for a country\". It also bounds the known limitation that SWOT \"is rarely deployed at lower than the organization level\", where one scan drives strategy for units its factors do not hold equally for. Naming the level does not remove that risk; it makes it visible in the record."
        }
      ],
      "skos:notation": "A_FrameSubject",
      "dcterms:source": "cat-harness/processes/process/swot-analysis.bpmn#A_FrameSubject",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_swotanalysis.a_groupreview",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Pool knowledge across participants"
        }
      ],
      "skos:definition": [
        {
          "@value": "The four lists are reviewed by more than the person who wrote them. This is the method's own answer to its own bias limitation, and it is a distinct activity rather than advice attached to the scans, because an activity can be recorded as not performed and a recommendation cannot. Disagreement about which quadrant a factor belongs in is an OUTPUT of this step, not a failure of it — it feeds A_RecordAmbiguous."
        }
      ],
      "skos:notation": "A_GroupReview",
      "dcterms:source": "cat-harness/processes/process/swot-analysis.bpmn#A_GroupReview",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_swotanalysis.a_handoff",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Hand the candidates to a decision methodology"
        }
      ],
      "skos:definition": [
        {
          "@value": "The candidate strategies go to `options-analysis`, which selects the decision methodology by context and applies it. SWOT does not make that selection and does not make the decision. What is handed over includes the ambiguities from A_RecordAmbiguous and the fact that the candidates are UNRANKED. A receiving methodology that assumed an ordered list would be reading a priority SWOT never established."
        }
      ],
      "skos:notation": "A_HandOff",
      "dcterms:source": "cat-harness/processes/process/swot-analysis.bpmn#A_HandOff",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_swotanalysis.a_recordambiguous",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record what did not classify cleanly"
        }
      ],
      "skos:definition": [
        {
          "@value": "Factors that sit in two quadrants, or in none, are written down as such. The source states this as inherent rather than as analyst error: \"the same factor can be fitted in two categories. A factor can be a strength and a weakness at the same time.\" It adds the two drifts — strengths not maintained become weaknesses, and opportunities not taken but taken by competitors become threats. A scan that silently forced every factor into one quadrant would report a cleanliness the method does not have. This is the same third-state discipline the rest of this repository applies to \"could not determine\": an unclassifiable factor is a finding, not a blank."
        }
      ],
      "skos:notation": "A_RecordAmbiguous",
      "dcterms:source": "cat-harness/processes/process/swot-analysis.bpmn#A_RecordAmbiguous",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_swotanalysis.a_scanexternal",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Scan the environment opportunities and threats"
        }
      ],
      "skos:definition": [
        {
          "@value": "The external axis, first, per Weihrich. Work the source's categories of environmental change rather than free-associating: societal, governmental, economic, competitive, supplier and market changes, each item recorded with what it impacts. An opportunity is an external element that gives benefit; a threat is one that could cause trouble. Both are outside the subject and largely beyond its control — that is what puts them on this axis, not whether they feel good or bad."
        }
      ],
      "skos:notation": "A_ScanExternal",
      "dcterms:source": "cat-harness/processes/process/swot-analysis.bpmn#A_ScanExternal",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_swotanalysis.a_scaninternal",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Scan the subject strengths and weaknesses"
        }
      ],
      "skos:definition": [
        {
          "@value": "The internal axis. Work the source's functional checklist rather than a blank page: marketing, research and development, management information systems, management team, operations, finance, human resources. A strength gives advantage over others in the field; a weakness places the subject at a disadvantage relative to others. Both are attributes OF the subject. The source's warning belongs to this step specifically: listing strengths on paper \"is very different from testing the organization and experiencing the strengths at work\", so a strength recorded here is a claim, and where evidence for it exists it is cited."
        }
      ],
      "skos:notation": "A_ScanInternal",
      "dcterms:source": "cat-harness/processes/process/swot-analysis.bpmn#A_ScanInternal",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_themeuireview.a_accessibility",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Accessibility: measure, do not assert"
        }
      ],
      "skos:definition": [
        {
          "@value": "Contrast COMPUTED against the real ground, including the worst case a backdrop can present; a non-colour channel wherever colour carries meaning (SC 1.4.1); an accessible name on every region; keyboard and focus order. An automated pass is necessary and not sufficient — axe accepts a non-empty placeholder as an accessible name, and a CSS selector that matches nothing raises no error at all."
        }
      ],
      "skos:notation": "A_Accessibility",
      "dcterms:source": "cat-harness/processes/ui/theme-ui-review.bpmn#A_Accessibility",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_themeuireview.a_branding",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Branding: does it read as this layer?"
        }
      ],
      "skos:definition": [
        {
          "@value": "Marks, palettes and art against the layer's own declaration rather than a remembered style. The question a downstream folio makes sharp: would this layer inherit something it did not choose?"
        }
      ],
      "skos:notation": "A_Branding",
      "dcterms:source": "cat-harness/processes/ui/theme-ui-review.bpmn#A_Branding",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_themeuireview.a_inventory",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Inventory the ingested assets"
        }
      ],
      "skos:definition": [
        {
          "@value": "Which graphical assets arrived, for which surfaces of the website or app design, in which locales, and at which VIEWPORTS: every surface at a web width and at a mobile width. Read off the ingested artefacts rather than off the intent — a layout the source declares but does not supply is not in the inventory, and a surface the design needs but no asset covers is the one that would ship wrong."
        }
      ],
      "skos:notation": "A_Inventory",
      "dcterms:source": "cat-harness/processes/ui/theme-ui-review.bpmn#A_Inventory",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_themeuireview.a_locales",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Languages: extracted, rendered, and RTL"
        }
      ],
      "skos:definition": [
        {
          "@value": "Every user-facing string reaches the .pot; every declared locale renders without clipping or overflow; right-to-left is laid out rather than mirrored by accident. New UI is where untranslated strings enter, because nothing was stale — there was nothing there before."
        }
      ],
      "skos:notation": "A_Locales",
      "dcterms:source": "cat-harness/processes/ui/theme-ui-review.bpmn#A_Locales",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_themeuireview.a_raisefindings",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Raise findings before the assets land"
        }
      ],
      "skos:definition": [
        {
          "@value": "Findings go back to whoever authored the choice, because the choice was theirs: a theme is picked per note by a human or an agent, and there is no mapping to correct instead. Raised, never silently fixed — a reviewer who re-themes a note has substituted their judgement for the author's without saying so."
        }
      ],
      "skos:notation": "A_RaiseFindings",
      "dcterms:source": "cat-harness/processes/ui/theme-ui-review.bpmn#A_RaiseFindings",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_themeuireview.r_judge",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Judge the assets in their design"
        }
      ],
      "skos:definition": [
        {
          "@value": "A person looks at the ingested assets laid out in the design they are for, at BOTH a web and a mobile width. THIS IS A HUMAN STEP INSIDE INGESTION, stated rather than hidden: ingestion of a THEME SOURCE is attended at this step, while ingestion of everything else never reaches it. A judgement made at one viewport is incomplete, not passed, and the wireframe of the surface (wireframe-design-review) says what each layout was meant to be. A clean build, a passing suite and every gate can all miss what only rendering the page and looking finds."
        }
      ],
      "skos:notation": "R_Judge",
      "dcterms:source": "cat-harness/processes/ui/theme-ui-review.bpmn#R_Judge",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translation.task_adjudicate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Adjudicate the flagged passage (human)"
        }
      ],
      "skos:definition": [
        {
          "@value": "A human SME or editor reviews the flagged passage. They may: - Accept the translation as-is (false positive) - Edit the translation and re-run QA - Reject and request re-translation The round trip establishes that two readings differ. Which one is right is a human call."
        }
      ],
      "skos:notation": "Task_Adjudicate",
      "dcterms:source": "cat-harness/library/processes/translation-workflow.bpmn#Task_Adjudicate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translation.task_edittranslation",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Edit the flagged passage and re-inject"
        }
      ],
      "skos:definition": [
        {
          "@value": "The reviewer corrects the passage in the PO rather than sending the whole translation back. Flows to Task_PoInject, so the round-trip QA runs again over the corrected text — \"edit the translation and re-run QA\", which is what the adjudication step has always offered and what this process could not do. A userTask, not a service task: this is the one step here where a person edits content, and the lane's actor is the reviewer who just adjudicated."
        }
      ],
      "skos:notation": "Task_EditTranslation",
      "dcterms:source": "cat-harness/library/processes/translation-workflow.bpmn#Task_EditTranslation",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translation.task_glossarycheck",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Check glossary terms (translation:glossary:check)"
        }
      ],
      "skos:definition": [
        {
          "@value": "After translating: run `translation:glossary:check --instance <dir> --locale <locale>`, fix the violations, and include its glossary section in the KG QA report. A term translated against the term base is a terminology miss, so it takes the drift branch to the adjudicator."
        }
      ],
      "skos:notation": "Task_GlossaryCheck",
      "dcterms:source": "cat-harness/library/processes/translation-workflow.bpmn#Task_GlossaryCheck",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translation.task_poinject",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Inject translations (PO → Markdown)"
        }
      ],
      "skos:notation": "Task_PoInject",
      "dcterms:source": "cat-harness/library/processes/translation-workflow.bpmn#Task_PoInject",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translation.task_potextract",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Extract translatable strings (POT)"
        }
      ],
      "skos:notation": "Task_PotExtract",
      "dcterms:source": "cat-harness/library/processes/translation-workflow.bpmn#Task_PotExtract",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translation.task_roundtripqa",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Round-trip translation QA (back-translate)"
        }
      ],
      "skos:notation": "Task_RoundTripQA",
      "dcterms:source": "cat-harness/library/processes/translation-workflow.bpmn#Task_RoundTripQA",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translation.task_signoff",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Sign off translation (human adjudicator)"
        }
      ],
      "skos:definition": [
        {
          "@value": "A human reviewer signs off the translation at the chosen hierarchy level (block, section, chapter, or folio). Updates status.json: { official: true, signedOffBy: \"...\", signedOffAt: \"...\", sourceHash: \"...\" } Tool: translation_signoff MCP tool"
        }
      ],
      "skos:notation": "Task_Signoff",
      "dcterms:source": "cat-harness/library/processes/translation-workflow.bpmn#Task_Signoff",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translation.task_stalenesscheck",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Check staleness (source hash)"
        }
      ],
      "skos:definition": [
        {
          "@value": "On source content change: computes sha256(source.md) and compares to each translation's status.json sourceHash. If they differ, sets stale: true. The translation remains visible with a \"stale — needs re-adjudication\" indicator."
        }
      ],
      "skos:notation": "Task_StalenessCheck",
      "dcterms:source": "cat-harness/library/processes/translation-workflow.bpmn#Task_StalenessCheck",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translation.task_termbase",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Build and review the locale term base"
        }
      ],
      "skos:definition": [
        {
          "@value": "Before translating: build the locale term base from the layered glossaries, review it, and translate with it. Precedence, within one subject area (the scheme's `subject`): the more authoritative (lower) layer fixes a term's translation; a layer only adds. A match in another subject area is a sense check, not a violation. Each layer's glossary is the directory it declares with the `glossary` graph typology. A fixed translation is an authored term with a non-empty, non-fuzzy msgstr in its scheme's catalogue."
        }
      ],
      "skos:notation": "Task_TermBase",
      "dcterms:source": "cat-harness/library/processes/translation-workflow.bpmn#Task_TermBase",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translation.task_translate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Produce translation (PO file)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Translation of .pot → .po, with the locale term base, by one of: 1. Existing PO from the WHO SMART Base IG (Weblate/Crowdin/Launchpad) 2. FHIR/translation-utils po-translate CLI (DeepL/Google, tagged #fuzzy) 3. Agent (LLM) translation 4. Human translator Result: <locale>/block.po with msgid/msgstr pairs."
        }
      ],
      "skos:notation": "Task_Translate",
      "dcterms:source": "cat-harness/library/processes/translation-workflow.bpmn#Task_Translate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translation.task_writeofficial",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Write status.json (official)"
        }
      ],
      "skos:notation": "Task_WriteOfficial",
      "dcterms:source": "cat-harness/library/processes/translation-workflow.bpmn#Task_WriteOfficial",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translation.task_writeunofficial",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Write status.json (unofficial)"
        }
      ],
      "skos:notation": "Task_WriteUnofficial",
      "dcterms:source": "cat-harness/library/processes/translation-workflow.bpmn#Task_WriteUnofficial",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translationrefresh.call_tr_roundtrip",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Round trip on the changed strings"
        }
      ],
      "skos:definition": [
        {
          "@value": "The untainted round trip, with the sample restricted to the strings this run translated."
        }
      ],
      "skos:notation": "Call_TR_RoundTrip",
      "dcterms:source": "cat-harness/library/processes/translation-refresh.bpmn#Call_TR_RoundTrip",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translationrefresh.task_tr_coldstart",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Cold start: mount and attach"
        }
      ],
      "skos:definition": [
        {
          "@value": "Lay down every pinned layer from each layer's lock, as its AGENTS.md cold start says, and attach each repository the run will change."
        }
      ],
      "skos:notation": "Task_TR_ColdStart",
      "dcterms:source": "cat-harness/library/processes/translation-refresh.bpmn#Task_TR_ColdStart",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translationrefresh.task_tr_detect",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Detect what moved"
        }
      ],
      "skos:definition": [
        {
          "@value": "`translation:status --instance <root>` for new, obsolete and fuzzy strings, and the instance's template check. Either failing, or showing anything but zero, is a change."
        }
      ],
      "skos:notation": "Task_TR_Detect",
      "dcterms:source": "cat-harness/library/processes/translation-refresh.bpmn#Task_TR_Detect",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translationrefresh.task_tr_gates",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Re-run the gates"
        }
      ],
      "skos:definition": [
        {
          "@value": "Officiality, catalogue coverage, translated links, `kg:locale`, `translation:glossary:check`, and the supplements compiling."
        }
      ],
      "skos:notation": "Task_TR_Gates",
      "dcterms:source": "cat-harness/library/processes/translation-refresh.bpmn#Task_TR_Gates",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translationrefresh.task_tr_merge",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Merge the PR"
        }
      ],
      "skos:definition": [
        {
          "@value": "Merge the layer's PR to main, then confirm the template checks pass on main."
        }
      ],
      "skos:notation": "Task_TR_Merge",
      "dcterms:source": "cat-harness/library/processes/translation-refresh.bpmn#Task_TR_Merge",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translationrefresh.task_tr_mergelocales",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Merge into each locale"
        }
      ],
      "skos:definition": [
        {
          "@value": "Merge each refreshed template into every locale's catalogue: new strings arrive empty, changed ones fuzzy, and obsolete ones are kept as `#~` entries, never deleted."
        }
      ],
      "skos:notation": "Task_TR_MergeLocales",
      "dcterms:source": "cat-harness/library/processes/translation-refresh.bpmn#Task_TR_MergeLocales",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translationrefresh.task_tr_report",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "QA report and one PR to main"
        }
      ],
      "skos:definition": [
        {
          "@value": "Write each locale's QA report, then open one PR for the layer, based on and targeting main."
        }
      ],
      "skos:notation": "Task_TR_Report",
      "dcterms:source": "cat-harness/library/processes/translation-refresh.bpmn#Task_TR_Report",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translationrefresh.task_tr_sourceissue",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Report source errors as one issue"
        }
      ],
      "skos:definition": [
        {
          "@value": "Any source-text error the translators found goes into one issue on the source, with its location. When there is none, this step writes nothing."
        }
      ],
      "skos:notation": "Task_TR_SourceIssue",
      "dcterms:source": "cat-harness/library/processes/translation-refresh.bpmn#Task_TR_SourceIssue",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translationrefresh.task_tr_templates",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Refresh the templates"
        }
      ],
      "skos:definition": [
        {
          "@value": "Re-run the layer's extractors, once for every locale: pages, diagrams, glossary schemes."
        }
      ],
      "skos:notation": "Task_TR_Templates",
      "dcterms:source": "cat-harness/library/processes/translation-refresh.bpmn#Task_TR_Templates",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translationrefresh.task_tr_translate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Translate new and fuzzy only"
        }
      ],
      "skos:definition": [
        {
          "@value": "Only the empty and fuzzy entries, in every locale, with the terms the term base fixes. A finished string is not touched."
        }
      ],
      "skos:notation": "Task_TR_Translate",
      "dcterms:source": "cat-harness/library/processes/translation-refresh.bpmn#Task_TR_Translate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translationroundtrip.task_rt_backtranslate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Back-translate the target text"
        }
      ],
      "skos:definition": [
        {
          "@value": "Render each target string into the source language, from the target text alone, using no tools, and say so in a TOOLS_USED line that is recorded. A string that cannot be rendered is reported as such, not guessed."
        }
      ],
      "skos:notation": "Task_RT_BackTranslate",
      "dcterms:source": "cat-harness/library/processes/translation-round-trip.bpmn#Task_RT_BackTranslate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translationroundtrip.task_rt_prescreen",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Pre-screen every pair"
        }
      ],
      "skos:definition": [
        {
          "@value": "Mechanically, over every (source, back-translation) pair: flag a pair whose negation, modal, quantifier, number or code tokens differ, and a pair whose word overlap is low. The pre-screen only chooses what is read first; it rules on nothing, and an unflagged pair is still in the sample."
        }
      ],
      "skos:notation": "Task_RT_PreScreen",
      "dcterms:source": "cat-harness/library/processes/translation-round-trip.bpmn#Task_RT_PreScreen",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translationroundtrip.task_rt_record",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record both witnesses"
        }
      ],
      "skos:definition": [
        {
          "@value": "Record the adjudicator's verdict first and the back-translator's rendering behind it (`translation:roundtrip --payload`), so a reader can ask both who ruled and on what basis. The counts (sampled, flagged, drift, not drift) go into the locale's QA report."
        }
      ],
      "skos:notation": "Task_RT_Record",
      "dcterms:source": "cat-harness/library/processes/translation-round-trip.bpmn#Task_RT_Record",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translationroundtrip.task_rt_recordna",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record could not dispatch"
        }
      ],
      "skos:definition": [
        {
          "@value": "Write one entry, `result: \"n/a\"`, `metrics.dispatch: \"unavailable\"`, with the reason. The producer may write this entry and no other. It is never a pass, and the QA report says so."
        }
      ],
      "skos:notation": "Task_RT_RecordNA",
      "dcterms:source": "cat-harness/library/processes/translation-round-trip.bpmn#Task_RT_RecordNA",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translationroundtrip.task_rt_rule",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Read and rule each flagged pair"
        }
      ],
      "skos:definition": [
        {
          "@value": "Read every flagged pair in full and rule it drift or not drift, with the reason. Not drift: synonyms, articles, word order, inflection, a purpose clause rendered in the subjunctive, an acronym left uninflected, an acronym spelled out with the acronym kept. Drift: a claim added, dropped, weakened, strengthened or reversed; a term of art swapped for one that means something else; a named entity, number or quantifier moved."
        }
      ],
      "skos:notation": "Task_RT_Rule",
      "dcterms:source": "cat-harness/library/processes/translation-round-trip.bpmn#Task_RT_Rule",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translationroundtrip.task_rt_sample",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Draw the sample"
        }
      ],
      "skos:definition": [
        {
          "@value": "On a first translation: every diagram label, every persona and scenario string, and a seeded random fraction of the rest, with the seed written down so the sample can be drawn again. On a refresh: only the strings that were new or fuzzy. Hand the back-translator the msgstr values alone, keyed by an opaque id."
        }
      ],
      "skos:notation": "Task_RT_Sample",
      "dcterms:source": "cat-harness/library/processes/translation-round-trip.bpmn#Task_RT_Sample",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_voicereview.task_adjudicate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Adjudicate: prose, scope, or exception"
        }
      ],
      "skos:definition": [
        {
          "@value": "The same three outcomes as the base voice axis. The register is wrong for this block (fix the prose); the rule does not apply to this content (scope it on the voice, one edit rather than ten overrules); or the rule applies and this block is an exception (a reviewer entry saying why)."
        }
      ],
      "skos:notation": "Task_Adjudicate",
      "dcterms:source": "cat-harness/processes/content/voice-review.bpmn#Task_Adjudicate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_voicereview.task_loadactive",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Load the active voices"
        }
      ],
      "skos:definition": [
        {
          "@value": "The activated set only, never everything shipped. An id naming no shipped voice is an error rather than a skip — a folio that believes it is applying a voice and is applying nothing has the cleanest-looking output of the three."
        }
      ],
      "skos:notation": "Task_LoadActive",
      "dcterms:source": "cat-harness/processes/content/voice-review.bpmn#Task_LoadActive",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_voicereview.task_mechanicalhalf",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Run the rule's mechanical half"
        }
      ],
      "skos:definition": [
        {
          "@value": "Whatever `patterns` and `terminology` the rule carries. A `judgementOnly` rule has no mechanical half by declaration, which is different from nobody having written one yet."
        }
      ],
      "skos:notation": "Task_MechanicalHalf",
      "dcterms:source": "cat-harness/processes/content/voice-review.bpmn#Task_MechanicalHalf",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_voicereview.task_opencitation",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Open the rule's citation"
        }
      ],
      "skos:definition": [
        {
          "@value": "Every rule resolves to a real `library/` section or a KG node, and carries the quote it was read from. Opening it is what lets a reviewer say WHY the rule applies — and it is the only way to catch a rule that misread its own source."
        }
      ],
      "skos:notation": "Task_OpenCitation",
      "dcterms:source": "cat-harness/processes/content/voice-review.bpmn#Task_OpenCitation",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_voicereview.task_recordonsidecar",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record on the block's QA sidecar"
        }
      ],
      "skos:definition": [
        {
          "@value": "Through `qa-merge-findings`, so the icon and the published witness agree with the decision. The adjudication LEADS the criterion and the script entry is kept beneath it: a disagreement between a checker and a reviewer is information."
        }
      ],
      "skos:notation": "Task_RecordOnSidecar",
      "dcterms:source": "cat-harness/processes/content/voice-review.bpmn#Task_RecordOnSidecar",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_voicereview.task_ruleiswrong",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "The RULE is the defect — bean it"
        }
      ],
      "skos:definition": [
        {
          "@value": "A rule its own quote does not support is a finding against the voice, not against the block."
        }
      ],
      "skos:notation": "Task_RuleIsWrong",
      "dcterms:source": "cat-harness/processes/content/voice-review.bpmn#Task_RuleIsWrong",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_webapppublish.a_build",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Build into its own chrome-less route"
        }
      ],
      "skos:definition": [
        {
          "@value": "Tool `web-app-build` (`web-apps:build`, run with the other declared visualiser writers): each locale's strings are written to `<i18n.out>/<locale>.json` from the `.po` (building is the injection), the app installs from its lockfile and builds, and the build is copied to `<locale>/<harness>/apps/<id>/` with every page marked `folio-navbar: none` and `rendered-by: web-app-build`; the `apps/` index lists every app with its size. No other page embeds an app, so it loads only when a reader opens its route."
        }
      ],
      "skos:notation": "A_Build",
      "dcterms:source": "cat-harness/processes/ui/web-app-publish.bpmn#A_Build",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_webapppublish.a_check",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Check the declaration and translations"
        }
      ],
      "skos:definition": [
        {
          "@value": "Tool `web-app-build` (`web-apps:build --check`): the manifest parses, `package.json` has the build script, a lockfile pins exact versions, no two layers claim one app id, every template is current, and no translation drops or adds a `{placeholder}`. Untranslated strings are reported, not failed: the app falls back to the source text per string."
        }
      ],
      "skos:notation": "A_Check",
      "dcterms:source": "cat-harness/processes/ui/web-app-publish.bpmn#A_Check",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_webapppublish.a_declare",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Declare the web-app directory"
        }
      ],
      "skos:definition": [
        {
          "@value": "The layer declares a directory of kind `web-app` in its `<name>.json` and puts a `web-app.json` (`web-app/0.1.0`) at its root: id, title, description, how it builds, the languages it ships (the site's six UN languages: ar, en, es, fr, ru, zh), the layer directories it reads at build time (`contentFrom`), a size budget, and for a copied app its licence and source. Its UI strings are one flat catalog in the source language (`i18n.catalog`). No publish script, no `site.build.keep`, no harness of its own."
        }
      ],
      "skos:notation": "A_Declare",
      "dcterms:source": "cat-harness/processes/ui/web-app-publish.bpmn#A_Declare",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_webapppublish.a_extract",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Extract the app's translation templates"
        }
      ],
      "skos:definition": [
        {
          "@value": "Tool `web-app-build` (`web-apps:build --extract`): the catalog becomes `translations/<locale>/apps/<id>.pot` in the declaring layer, one `ui-string` entry per key with the key as `msgctxt`. This is the app's \"refresh the templates\" step, named in the layer's AGENTS.md so the translation watcher runs it too."
        }
      ],
      "skos:notation": "A_Extract",
      "dcterms:source": "cat-harness/processes/ui/web-app-publish.bpmn#A_Extract",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_webapppublish.a_fix",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Fix the declaration or the catalog"
        }
      ],
      "skos:definition": [
        {
          "@value": "The author fixes what the check named (the manifest, the lockfile, a clashing id, a stale template) and commits again. A translation that dropped a placeholder goes back to its locale's translator through the same PR route."
        }
      ],
      "skos:notation": "A_Fix",
      "dcterms:source": "cat-harness/processes/ui/web-app-publish.bpmn#A_Fix",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_webapppublish.a_size",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review the size against its budget"
        }
      ],
      "skos:definition": [
        {
          "@value": "The index flags an app over its `sizeBudgetMB`; the site size review reads it with the rest of the site. Over budget is a finding for the author, never a silent publish."
        }
      ],
      "skos:notation": "A_Size",
      "dcterms:source": "cat-harness/processes/ui/web-app-publish.bpmn#A_Size",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_webapppublish.call_translate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Translate into each locale"
        }
      ],
      "skos:definition": [
        {
          "@value": "The harness's multi-locale translation, unchanged: the templates are merged into each locale's `.po`, new and fuzzy strings are translated with the fixed terms, the gates run, and each locale is its own PR. Afterwards the translation watcher (`Process_TranslationRefresh`) keeps them current as the catalog moves."
        }
      ],
      "skos:notation": "Call_Translate",
      "dcterms:source": "cat-harness/processes/ui/web-app-publish.bpmn#Call_Translate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_wireframedesignreview.call_adjudicate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Adjudication"
        }
      ],
      "skos:definition": [
        {
          "@value": "folio-assistant's adjudication: the adjudication leads, the checker's entry is kept, and the dispensation carries its reason. Reviewers disagreeing on ONE criterion is a criterion disagreement, so this calls the QA-criterion specialisation: the failing entry stands, the criterion does not apply to this screen, or a dispensation is granted with its reason. The entry condition matches exactly rather than approximately: GW_Agree asks whether the blind reviewers' entries agree and takes `no` here, and `Process_CriterionAdjudication` starts at \"entries for one criterion disagree\" — R_Review records pass, warn or fail PER CRITERION with a reason, so the disagreement reaching this step is a per-criterion disagreement between reviewer entries and nothing else."
        }
      ],
      "skos:notation": "Call_Adjudicate",
      "dcterms:source": "cat-harness/processes/ui/wireframe-design-review.bpmn#Call_Adjudicate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_wireframedesignreview.call_choose",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Choose a candidate"
        }
      ],
      "skos:definition": [
        {
          "@value": "A one-off choice between surviving candidates. Rejected candidates are kept, with the reason each lost."
        }
      ],
      "skos:notation": "Call_Choose",
      "dcterms:source": "cat-harness/processes/ui/wireframe-design-review.bpmn#Call_Choose",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_wireframedesignreview.d_candidates",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Produce >= 2 candidates, web + mobile"
        }
      ],
      "skos:definition": [
        {
          "@value": "Mid-fidelity HTML: monochrome, real folio content, semantic icons, no placeholder text. Each candidate has both a web layout and a mobile layout."
        }
      ],
      "skos:notation": "D_Candidates",
      "dcterms:source": "cat-harness/processes/ui/wireframe-design-review.bpmn#D_Candidates",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_wireframedesignreview.d_check",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Mechanical checks, both viewports"
        }
      ],
      "skos:definition": [
        {
          "@value": "Tool wireframe-check renders every candidate at a web and a mobile viewport. It fails on horizontal overflow at mobile width, on placeholder text, and on a missing viewport, and writes screenshots and a script entry per criterion."
        }
      ],
      "skos:notation": "D_Check",
      "dcterms:source": "cat-harness/processes/ui/wireframe-design-review.bpmn#D_Check",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_wireframedesignreview.d_intent",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Write the design intent"
        }
      ],
      "skos:definition": [
        {
          "@value": "A short statement of who the screen is for, what they need to do, and what it must show. It is the criterion every candidate is judged against."
        }
      ],
      "skos:notation": "D_Intent",
      "dcterms:source": "cat-harness/processes/ui/wireframe-design-review.bpmn#D_Intent",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_wireframedesignreview.r_review",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Blind review per criterion"
        }
      ],
      "skos:definition": [
        {
          "@value": "Criteria: intent-fit, web usability, mobile usability, accessibility, and alternatives considered. A review at one viewport only is incomplete."
        }
      ],
      "skos:notation": "R_Review",
      "dcterms:source": "cat-harness/processes/ui/wireframe-design-review.bpmn#R_Review",
      "skos:note": "candidate"
    }
  ]
}
