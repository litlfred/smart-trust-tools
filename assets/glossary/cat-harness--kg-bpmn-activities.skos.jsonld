      },
      "skos:prefLabel": [
        {
          "@value": "Extract translatable strings (POT)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Scan the source content and write the translatable strings to .pot files at the configured granularity: segment prose by paragraph, shield what must not be translated (math, code, labels, Lean companions) as placeholders, normalise whitespace, and extract metadata such as titles, alt text and captions. Tool: the translation_extract MCP tool."
        }
      ],
      "skos:notation": "GT_ExtractPot",
      "dcterms:source": "cat-harness/processes/global-tasks.bpmn#GT_ExtractPot",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/globaltask.gt_injectpo",
      "@type": "skos:Concept",
